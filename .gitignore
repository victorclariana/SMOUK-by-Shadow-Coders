# Local clones of the upstream OpenShot repositories.
# These are independent Git repositories (and are ignored so they are never
# accidentally committed into this project repository).
/openshot-qt/
/libopenshot/
/libopenshot-audio/

# Python caches
__pycache__/
*.pyc

# Local build output
/build/*
!/build/.gitkeep
/logs/*
!/logs/.gitkeep
# Local SMOUK transcription runtime, downloaded models, and generated captions
.smouk-transcription/
.smouk-models/
.smouk-transcriptions/
