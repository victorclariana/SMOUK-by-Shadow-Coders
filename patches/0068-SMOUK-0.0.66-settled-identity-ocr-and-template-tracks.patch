From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Sun, 20 Sep 2026 01:02:31 +0200
Subject: [PATCH] SMOUK 0.0.66 settle identity chyron OCR

---
 src/windows/main_window.py     |  2 +-
 src/windows/verticalization.py | 75 ++++++++++++++++++++++++++--------
 2 files changed, 58 insertions(+), 19 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index da60df2c1..55f597405 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.65"
+SMOUK_VERSION = "0.0.66"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index 624952f39..1629d32ff 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -69,11 +69,27 @@ CHYRON_BOUNDARY_REFINE_MARGIN_FRAMES = 15 * 25
 CHYRON_BOUNDARY_MATCH_THRESHOLD = 0.60
 MAX_CHYRON_EVENTS = 40
 CHYRON_TRACKS = {
-    "headlines": ("CHYRONS · Titulares", {"story_headline", "persistent_headline"}),
-    "pretitles": ("CHYRONS · Pretítulos", {"pretitle"}),
-    "identities": ("CHYRONS · Personas", {
-        "presenter_left", "presenter_right", "name_cargo", "credit"}),
-    "locations": ("CHYRONS · Localización", {"live_location", "location"}),
+    # One track per editorial graphic makes simultaneous titles directly
+    # reviewable: an editor can see which text belongs to which template.
+    "story_headline": ("CHYRONS · Titular", {"story_headline"}),
+    "persistent_headline": ("CHYRONS · Titular persistente", {"persistent_headline"}),
+    "pretitle": ("CHYRONS · Pretítulo", {"pretitle"}),
+    "presenter_left": ("CHYRONS · Presentador izq.", {"presenter_left"}),
+    "presenter_right": ("CHYRONS · Presentador der.", {"presenter_right"}),
+    "name_cargo": ("CHYRONS · Nombre y cargo", {"name_cargo"}),
+    "credit": ("CHYRONS · Firma", {"credit"}),
+    "live_location": ("CHYRONS · Directo", {"live_location"}),
+    "location": ("CHYRONS · Localización", {"location"}),
+}
+
+# Version 0.0.65 grouped four editorial families together. Reanalysis clears
+# only generated clips, therefore its empty tracks can be upgraded in place
+# before the finer 0.0.66 layout is created.
+LEGACY_CHYRON_TRACK_KEYS = {
+    "headlines": "story_headline",
+    "pretitles": "pretitle",
+    "identities": "name_cargo",
+    "locations": "location",
 }
 
 # OpenShot ships these profiles. SMOUK exposes the supported output choices
@@ -718,7 +734,7 @@ class VerticalizationDockContent(QWidget):
         for key, (_label, templates) in CHYRON_TRACKS.items():
             if template in templates:
                 return key
-        return "headlines"
+        return "story_headline"
 
     @staticmethod
     def _ensure_chyron_tracks():
@@ -729,6 +745,11 @@ class VerticalizationDockContent(QWidget):
             if not track.data.get("smouk_chyron_track"):
                 continue
             key = track.data.get("smouk_chyron_track_key")
+            if key in LEGACY_CHYRON_TRACK_KEYS:
+                key = LEGACY_CHYRON_TRACK_KEYS[key]
+                track.data["smouk_chyron_track_key"] = key
+                track.data["label"] = CHYRON_TRACKS[key][0]
+                track.save()
             if key in CHYRON_TRACKS:
                 existing[key] = track
             elif legacy_track is None:
@@ -893,9 +914,9 @@ class VerticalizationDockContent(QWidget):
                               int(width * .31), int(height * .17)),
             "location": (int(width * .03), int(height * .09),
                          int(width * .35), int(height * .18)),
-            "presenter_left": (int(width * .10), int(height * .78),
+            "presenter_left": (int(width * .10), int(height * .82),
                                int(width * .45), int(height * .90)),
-            "presenter_right": (int(width * .55), int(height * .78),
+            "presenter_right": (int(width * .55), int(height * .82),
                                 int(width * .86), int(height * .90)),
             "name_cargo": (int(width * .03), int(height * .78),
                            int(width * .62), int(height * .89)),
@@ -927,8 +948,13 @@ class VerticalizationDockContent(QWidget):
         if template in ("presenter_left", "presenter_right"):
             # A presenter's compact orange label never fills its whole zone;
             # this prevents the full-width story banner becoming two names.
-            return .012 <= orange_ratio <= .65 and not VerticalizationDockContent._orange_spans_crop(
-                orange, numpy)
+            # The source picture can contain yellow/orange clothes. The TNM
+            # panel itself is a much more saturated orange, so require it here
+            # before treating a frame as a title candidate.
+            graphic_orange = cv2.inRange(hsv, (2, 190, 115), (18, 255, 255))
+            graphic_ratio = float(numpy.count_nonzero(graphic_orange)) / graphic_orange.size
+            return .012 <= graphic_ratio <= .65 and not VerticalizationDockContent._orange_spans_crop(
+                graphic_orange, numpy)
         if template == "live_location":
             # DIRECTE combines an orange tab with the dark location pill.
             return orange_ratio >= .006 and dark_ratio >= .20 and white_ratio >= .012
@@ -945,9 +971,13 @@ class VerticalizationDockContent(QWidget):
                        not VerticalizationDockContent._dark_spans_crop(value, saturation, numpy)
             return dark_ratio >= .20 and white_ratio >= .012
         if template == "name_cargo":
-            # Interview/presenter identity has an orange accent or panel.
-            return .003 <= orange_ratio <= .40 and white_ratio >= .025 and \
-                   not VerticalizationDockContent._orange_spans_crop(orange, numpy)
+            # Interviewee lower thirds have a small saturated orange accent.
+            # A broad orange panel belongs to a presenter label and is read by
+            # its own two templates instead of becoming a duplicate.
+            graphic_orange = cv2.inRange(hsv, (2, 190, 115), (18, 255, 255))
+            graphic_ratio = float(numpy.count_nonzero(graphic_orange)) / graphic_orange.size
+            return .001 <= graphic_ratio <= .10 and white_ratio >= .025 and \
+                   not VerticalizationDockContent._orange_spans_crop(graphic_orange, numpy)
         if template == "credit":
             # Reporter credits sit in a dark band and do not use the orange
             # identity panel, which stops a name/cargo clip being duplicated.
@@ -984,12 +1014,21 @@ class VerticalizationDockContent(QWidget):
         return 6
 
     @staticmethod
-    def _chyron_signature(crop, cv2):
-        """Make a small mask of white/orange TNM title graphics, not video."""
+    def _chyron_signature(crop, cv2, template=None):
+        """Make a title-graphic mask that ignores moving programme pictures.
+
+        Presenter and name/cargo labels use only the saturated TNM orange
+        panel. This is stable while people and bright clothing move behind it,
+        and lets OCR wait until the label has completed its entrance.
+        """
         hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
         white = cv2.inRange(hsv, (0, 0, 175), (180, 95, 255))
         orange = cv2.inRange(hsv, (2, 115, 115), (28, 255, 255))
-        signature = cv2.bitwise_or(white, orange)
+        if template in ("presenter_left", "presenter_right", "name_cargo"):
+            orange = cv2.inRange(hsv, (2, 190, 115), (18, 255, 255))
+            signature = orange
+        else:
+            signature = cv2.bitwise_or(white, orange)
         return cv2.resize(signature, (96, 24), interpolation=cv2.INTER_AREA)
 
     @staticmethod
@@ -1049,7 +1088,7 @@ class VerticalizationDockContent(QWidget):
                     break
                 crop = numpy.frombuffer(raw, dtype=numpy.uint8).reshape(
                     (crop_height, crop_width, 3))
-                signature = self._chyron_signature(crop, cv2)
+                signature = self._chyron_signature(crop, cv2, event["template"])
                 score = self._chyron_signature_similarity(signature, reference, cv2, numpy)
                 if score >= CHYRON_BOUNDARY_MATCH_THRESHOLD:
                     matching_frames.append(start_frame + index)
@@ -1125,7 +1164,7 @@ class VerticalizationDockContent(QWidget):
                         state.update({"previous": None, "stable_samples": 0,
                                       "last_ocr": None})
                         continue
-                    signature = self._chyron_signature(crop, cv2)
+                    signature = self._chyron_signature(crop, cv2, template)
                     previous_distance = self._chyron_signature_distance(
                         state["previous"], signature, numpy)
                     if previous_distance <= CHYRON_SIGNATURE_STABLE_DELTA:
