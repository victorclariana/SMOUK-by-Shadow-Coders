+    @staticmethod
+    def _clock_phase_from_differences(differences):
+        """Return the displayed-clock phase from native-frame change scores."""
+        starts, in_transition = [], False
+        for frame, score in differences:
+            changed = score >= 1.0
+            if changed and not in_transition:
+                starts.append(frame)
+            in_transition = changed
+        repeated = [later for earlier, later in zip(starts, starts[1:])
+                    if 22 <= later - earlier <= 28]
+        if not repeated:
+            return 0
+        # The standard TNM clock begins its digit animation two frames after
+        # the actual second boundary. This offset is measured from the video;
+        # it is never guessed from the OCR text.
+        return max(0, (repeated[0] - 2) % 25)
+
+    def _clock_presentation_phase(self, path, probe, progress=None):
+        """Measure the clock's frame phase without running OCR per frame."""
+        try:
+            import cv2
+            import numpy
+            ffmpeg = self._ffmpeg_path()
+            if not ffmpeg:
+                return 0
+            source_frame = int(probe.get("frame", round(
+                float(probe.get("seconds", 0.0)) * 25)))
+            width, height, samples = 640, 360, 80
+            if progress:
+                progress("%s: calibrando los fotogramas del reloj…" % os.path.basename(path))
+            command = [ffmpeg, "-v", "error", "-ss", "%.3f" % (source_frame / 25.0),
+                       "-i", path, "-vf", "fps=25,scale=%d:%d:flags=bilinear" %
+                       (width, height), "-an", "-frames:v", str(samples), "-f", "rawvideo",
+                       "-pix_fmt", "bgr24", "pipe:1"]
+            process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+            frame_size = width * height * 3
+            previous, differences = None, []
+            try:
+                for index in range(samples):
+                    raw = process.stdout.read(frame_size)
+                    if len(raw) != frame_size:
+                        break
+                    frame = numpy.frombuffer(raw, dtype=numpy.uint8).reshape((height, width, 3))
+                    panel = cv2.cvtColor(frame[int(height * .08):int(height * .78),
+                                               int(width * .68):], cv2.COLOR_BGR2GRAY)
+                    if previous is not None:
+                        differences.append((index, float(numpy.mean(cv2.absdiff(panel, previous)))))
+                    previous = panel
+            finally:
+                if process.poll() is None:
+                    process.kill()
+                process.wait(timeout=10)
+                process.stdout.close()
+            phase = self._clock_phase_from_differences(differences)
+            log.info("SMOUK clock phase %s: %s frames", os.path.basename(path), phase)
+            return phase
+        except Exception:
+            log.exception("Could not calibrate SMOUK clock frame phase")
+            return 0
+
