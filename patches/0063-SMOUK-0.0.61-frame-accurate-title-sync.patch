+    @staticmethod
+    def _chyron_signature_similarity(candidate, reference, cv2, numpy):
+        """Score a title graphic against an OCR-confirmed reference image."""
+        if candidate is None or reference is None:
+            return 0.0
+        correlation = float(cv2.matchTemplate(
+            candidate, reference, cv2.TM_CCOEFF_NORMED)[0][0])
+        reference_pixels = max(1, int(numpy.count_nonzero(reference)))
+        overlap = float(numpy.count_nonzero(cv2.bitwise_and(
+            candidate, reference))) / reference_pixels
+        return max(0.0, min(1.0, 0.75 * correlation + 0.25 * overlap))
+
+    def _refine_chyron_boundaries(self, program_path, event, cv2, numpy):
+        """Replace coarse OCR timestamps with the native visual title span.
+
+        The title scan samples one frame per second so it remains fast. Once
+        OCR has confirmed a title, this reads only its nearby lower-third crop
+        at 25 fps and uses template matching to preserve its real entry and
+        exit frames. It is deliberately read-only and has no Qt/project work.
+        """
+        reference = event.pop("_signature", None)
+        if reference is None or event.get("template") != "lower_third":
+            return event
+        ffmpeg = self._ffmpeg_path()
+        if not ffmpeg:
+            return event
+        x1, y1, x2, y2 = event["coordinates"]
+        source_event_start = int(event.pop("_source_start_frame", event["start_frame"]))
+        source_event_end = int(event.pop("_source_end_frame", event["end_frame"]))
+        absolute_origin = int(event["start_frame"]) - source_event_start
+        start_frame = max(0, source_event_start - CHYRON_BOUNDARY_REFINE_MARGIN_FRAMES)
+        end_frame = source_event_end + CHYRON_BOUNDARY_REFINE_MARGIN_FRAMES
+        frame_count = max(1, end_frame - start_frame + 1)
+        crop_width, crop_height = x2 - x1, y2 - y1
+        command = [ffmpeg, "-v", "error", "-ss", "%.3f" % (start_frame / 25.0),
+                   "-i", program_path, "-vf",
+                   "scale=960:540:flags=bilinear,crop=%d:%d:%d:%d,fps=25" %
+                   (crop_width, crop_height, x1, y1), "-an", "-frames:v", str(frame_count),
+                   "-f", "rawvideo", "-pix_fmt", "bgr24", "pipe:1"]
+        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
+        frame_size = crop_width * crop_height * 3
+        matching_frames = []
+        try:
+            for index in range(frame_count):
+                raw = process.stdout.read(frame_size)
+                if len(raw) != frame_size:
+                    break
+                crop = numpy.frombuffer(raw, dtype=numpy.uint8).reshape(
+                    (crop_height, crop_width, 3))
+                signature = self._chyron_signature(crop, cv2)
+                score = self._chyron_signature_similarity(signature, reference, cv2, numpy)
+                if score >= CHYRON_BOUNDARY_MATCH_THRESHOLD:
+                    matching_frames.append(start_frame + index)
+        finally:
+            if process.poll() is None:
+                process.kill()
+            process.wait(timeout=10)
+            process.stdout.close()
+        if not matching_frames:
+            return event
+        reference_frame = source_event_start
+        # Do not merge a later title that happens to use the same lower-third
+        # geometry. Keep the matching run that contains, or is closest to,
+        # the OCR-confirmed frame.
+        runs, run_start, previous = [], matching_frames[0], matching_frames[0]
+        for frame in matching_frames[1:]:
+            if frame > previous + 1:
+                runs.append((run_start, previous))
+                run_start = frame
+            previous = frame
+        runs.append((run_start, previous))
+        refined_start, refined_end = min(
+            runs, key=lambda run: 0 if run[0] <= reference_frame <= run[1]
+            else min(abs(reference_frame - run[0]), abs(reference_frame - run[1])))
+        event["start_frame"] = absolute_origin + refined_start
+        # OpenShot clip end is exclusive, so retain the last visible frame.
+        event["end_frame"] = absolute_origin + refined_end + 1
+        event["confidence"] = max(float(event.get("confidence", 0.0)), 0.90)
+        return event
+
