@@ -49,55 +52,89 @@ def _media_info(path):
         return {"exists": os.path.isfile(path)}
 
 
+def _ffmpeg_path():
+    """Return the FFmpeg executable used for reliable broadcast MP4 reads."""
+    path = (shutil.which("ffmpeg") or shutil.which("ffmpeg.exe") or
+            os.path.join(os.path.dirname(sys.executable), "ffmpeg.exe"))
+    return path if os.path.isfile(path) else None
+
+
+def _clock_components(frame, cv2):
+    """Measure the white/orange broadcast-clock graphic in a BGR frame."""
+    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+    _, binary = cv2.threshold(gray, 180, 255, cv2.THRESH_BINARY)
+    contours, _ = cv2.findContours(binary, cv2.RETR_LIST, cv2.CHAIN_APPROX_SIMPLE)
+    height, width = gray.shape[:2]
+    digit_like = 0
+    for contour in contours:
+        _x, _y, component_width, component_height = cv2.boundingRect(contour)
+        area = component_width * component_height
+        if (area >= 30
+                and component_height >= max(8, int(height * 0.015))
+                and component_width <= int(width * 0.35)):
+            digit_like += 1
+
+    # The supplied reference clock has white numerals on its characteristic
+    # high-saturation orange panels.  This rejects ordinary white programme
+    # text that would otherwise look like digit contours alone.
+    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
+    orange = cv2.inRange(hsv, (4, 120, 140), (24, 255, 255))
+    orange_ratio = float(cv2.countNonZero(orange)) / float(max(1, width * height))
+    return digit_like, orange_ratio
+
+
 def _clock_probe(path, fps=25, max_seconds=180):
     """Search the first *max_seconds* for the standard burned-in clock.
 
     The clock's final reading belongs to the OCR stage.  This lightweight
-    detector uses its shared bright graphic appearance to find the first
-    plausible clock frame, sampling exactly one frame per second at the
-    supplied frame rate.  Sampling at 25 fps therefore checks frames 0, 25,
-    50, ..., 4475 for the first three minutes.
+    detector uses the shared white-numeral/orange-panel appearance to find the
+    first plausible clock frame.  FFmpeg decodes broadcast MP4 files that
+    OpenCV cannot always seek reliably, producing one sample per second for
+    the first three minutes.
     """
