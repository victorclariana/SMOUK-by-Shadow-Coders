--- a/src/classes/smouk_titles.py
+++ b/src/classes/smouk_titles.py
@@ -11,11 +11,12 @@ import re
 import shutil
 import subprocess
 import sys
-import uuid
+import threading
 
 
 TIMECODE_RE = re.compile(r"^(?P<h>\d{1,2}):(?P<m>[0-5]\d):(?P<s>[0-5]\d)(?::(?P<f>\d{1,2}))?$")
 CLOCK_OCR_RE = re.compile(r"(?<!\d)([0-2]?\d)\s*[.:]\s*([0-5]\d)\s*[.:]\s*([0-5]\d)(?!\d)")
+_OCR_IMAGE_LOCK = threading.Lock()
 
 
 def parse_timecode(value, fps=25):
@@ -102,14 +103,14 @@ def ocr_image(image, psm=6, language=None):
         gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
         gray = cv2.resize(gray, None, fx=2.5, fy=2.5, interpolation=cv2.INTER_CUBIC)
         gray = cv2.normalize(gray, None, 0, 255, cv2.NORM_MINMAX)
-        # The bundled Windows Python can inherit a protected TEMP directory
-        # from the broadcast environment. Keep transient OCR files beside the
-        # writable SMOUK resources instead.
-        temporary_root = os.path.normpath(os.path.join(
-            os.path.dirname(__file__), "..", "resources", "smouk-ocr-tmp"))
+        # Reuse one file in the user's local SMOUK cache. The prior approach
+        # created and deleted a PNG for every frame, which can trip endpoint
+        # protection and is unnecessary because Tesseract runs serially here.
+        temporary_root = os.path.join(
+            os.environ.get("LOCALAPPDATA", os.path.expanduser("~")), "SMOUK", "ocr")
         os.makedirs(temporary_root, exist_ok=True)
-        image_path = os.path.join(temporary_root, "ocr-%s.png" % uuid.uuid4().hex)
-        try:
+        image_path = os.path.join(temporary_root, "current-ocr.png")
+        with _OCR_IMAGE_LOCK:
             if not cv2.imwrite(image_path, gray):
                 return {"text": "", "reason": "ocr_image_write_failed"}
             environment = os.environ.copy()
@@ -120,11 +121,6 @@ def ocr_image(image, psm=6, language=None):
                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                 encoding="utf-8", errors="replace",
                 timeout=45, check=False, env=environment)
-        finally:
-            try:
-                os.remove(image_path)
-            except OSError:
-                pass
         return {"text": completed.stdout.strip(), "language": language,
                 "reason": "" if completed.returncode == 0 else "tesseract_failed: " + completed.stderr.strip()[-500:]}
     except Exception as exc:
