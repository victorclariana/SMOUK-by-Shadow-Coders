Subject: [PATCH] SMOUK-0.0.45-compact-default-timeline

---
 src/classes/project_data.py   | 18 ++++++++++++++++++
 src/settings/_default.project | 21 ---------------------
 src/windows/main_window.py    | 30 +++++++++++++++++++++++++++++-
 3 files changed, 47 insertions(+), 22 deletions(-)

diff --git a/src/classes/project_data.py b/src/classes/project_data.py
index a8228678a..a193ce3c0 100644
--- a/src/classes/project_data.py
+++ b/src/classes/project_data.py
@@ -351,6 +351,24 @@ class ProjectDataStore(JsonDataStore, UpdateInterface):
             # Fall back to OpenShot defaults, if user defaults didn't load
             self._data = self.read_from_file(self.default_project_filepath)
 
+        # SMOUK starts each new blank project with a compact two-track stack.
+        # A previous OpenShot user-default project can still contain the old
+        # five-track template, so normalize it here as well as in the bundled
+        # default file.  Opening an existing .osp bypasses this data after
+        # load(), therefore its track layout remains untouched.
+        default_layers = list(self._data.get("layers") or [])
+        default_layers.sort(key=lambda layer: int(layer.get("number", 0)))
+        self._data["layers"] = default_layers[:2]
+        while len(self._data["layers"]) < 2:
+            index = len(self._data["layers"]) + 1
+            self._data["layers"].append({
+                "id": "L%s" % index,
+                "label": "",
+                "number": index * 1000000,
+                "y": 0,
+                "lock": False,
+            })
+
         self.current_filepath = None
         self.has_unsaved_changes = False
 
