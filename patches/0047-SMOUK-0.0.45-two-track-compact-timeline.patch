diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 8a724c518..13ff095f0 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,8 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.44"
+SMOUK_VERSION = "0.0.45"
+SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v1"
 
 
 class MainWindow(updates.UpdateWatcher, QMainWindow):
@@ -4447,6 +4448,11 @@ class MainWindow(updates.UpdateWatcher, QMainWindow):
         hidden_names = get_app().get_settings().get('hidden_docks') or []
         self._restore_hidden_docks(hidden_names)
         QTimer.singleShot(0, self._restore_saved_video_dock_width)
+        if not get_app().get_settings().get(SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION):
+            # One SMOUK migration: earlier layouts used the five-track-sized
+            # Timeline.  Apply the compact two-track height after Qt restores
+            # that old splitter state, then leave later manual resizes alone.
+            QTimer.singleShot(0, self._apply_smouk_compact_timeline_height)
         QTimer.singleShot(100, lambda: self._save_layout_checkpoint(force=True))
         log.info("Restored SMOUK UI layout (Qt state accepted=%s)", restored)
 
@@ -4530,6 +4536,28 @@ class MainWindow(updates.UpdateWatcher, QMainWindow):
             self.saved_timeline_height,
             Qt.Vertical)
 
+    def _apply_smouk_compact_timeline_height(self):
+        """Fit the default Timeline to its toolbar, ruler, and two tracks."""
+        dock = getattr(self, "dockTimeline", None)
+        timeline = getattr(self, "timeline", None)
+        toolbar = getattr(self, "timelineToolbar", None)
+        if not dock:
+            return
+
+        # Derive the height from the active theme instead of assuming a fixed
+        # row size.  The small allowance covers the dock layout margins and
+        # prevents clipping the horizontal scrollbar.
+        track_height = max(1, int(getattr(timeline, "track_height", 48) or 48))
+        ruler_height = max(1, int(getattr(timeline, "ruler_height", 28) or 28))
+        toolbar_height = toolbar.sizeHint().height() if toolbar else 28
+        target_height = max(150, toolbar_height + ruler_height + (2 * track_height) + 16)
+        self._force_dock_extent_once(dock, target_height, Qt.Vertical)
+
+        settings = get_app().get_settings()
+        settings.set(SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION, True)
+        settings.save()
+        log.info("Applied SMOUK compact Timeline height: %s px", target_height)
+
     def show_property_timeout(self):
         """Callback for show property timer"""
 
