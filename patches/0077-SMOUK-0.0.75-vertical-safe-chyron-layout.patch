+            "presenter_right": 34,
+            "name_cargo": 34,
+            "credit": 34,
+            "pretitle": 34,
+            "story_headline": 46,
+            "persistent_headline": 34,
         }
-        x_ratio, y_ratio, anchor, font_size = styles.get(template, styles["story_headline"])
-        x, y = width * x_ratio, height * y_ratio
-        if template == "story_headline":
-            safe_left, safe_top, safe_right, safe_bottom = self._vertical_title_safe_area(width, height)
-            safe_width = safe_right - safe_left
-            usable_width = safe_width * (1.0 - 2.0 * VERTICAL_TITLE_SAFE_MARGIN)
-            max_characters = max(12, int(usable_width / (font_size * .60)))
-            lines = self._wrap_story_headline(text, max_characters)
-            # Center the multiline block in the lower third.  Its text stays
