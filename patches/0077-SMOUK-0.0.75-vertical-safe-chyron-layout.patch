-            # inside the 9:16 viewer guide.
-            line_height = font_size * 1.12
-            x = (safe_left + safe_right) / 2.0
-            y = height * .84 - (len(lines) - 1) * line_height / 2.0
-            rendered = "".join(
-                '<text x="%.1f" y="%.1f" text-anchor="middle" '
-                'font-family="Arial, sans-serif" font-size="%d" font-weight="bold" '
-                'fill="white" stroke="black" stroke-width="1.5" paint-order="stroke" '
-                'textLength="%.1f" lengthAdjust="spacingAndGlyphs">%s</text>' % (
-                    x, y + index * line_height, font_size,
-                    min(usable_width, max(font_size * 3.0, len(line) * font_size * .56)),
-                    html.escape(line))
-                for index, line in enumerate(lines) if line.strip())
-            return ('<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" '
-                    'viewBox="0 0 %d %d"><defs><clipPath id="smouk-vertical-title-safe">'
-                    '<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f"/></clipPath></defs>'
-                    '<g clip-path="url(#smouk-vertical-title-safe)">%s</g></svg>') % (
-                        width, height, width, height, safe_left, safe_top, safe_width,
-                        safe_bottom - safe_top, rendered)
-        lines = [html.escape(line.strip()) for line in str(text).splitlines() if line.strip()][:2]
-        rendered = "".join('<text x="%.1f" y="%.1f" text-anchor="%s" font-family="Arial, sans-serif" font-size="%d" font-weight="bold" fill="white" stroke="black" stroke-width="1.5" paint-order="stroke">%s</text>' % (x, y + index * font_size * 1.12, anchor, font_size, line) for index, line in enumerate(lines))
-        return '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">%s</svg>' % (width, height, width, height, rendered)
+        font_size = styles.get(template, styles["story_headline"])
+        safe_left, safe_top, safe_right, safe_bottom = self._vertical_title_safe_area(width, height)
+        safe_width = safe_right - safe_left
+        usable_width = safe_width * (1.0 - 2.0 * VERTICAL_TITLE_SAFE_MARGIN)
+        max_characters = max(12, int(usable_width / (font_size * .60)))
+        lines = self._wrap_story_headline(text, max_characters)
+        preferences = self._chyron_vertical_slot_preferences(template)
+        slot = preferences[0] if vertical_slot is None else int(vertical_slot)
