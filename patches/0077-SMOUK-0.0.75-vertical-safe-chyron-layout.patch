+                '<g clip-path="url(#smouk-vertical-title-safe)">%s</g></svg>') % (
+                    width, height, width, height, safe_left, safe_top, safe_width,
+                    safe_bottom - safe_top, rendered)
 
     def _add_chyron_clip(self, svg_path, layer, position, duration, event):
         data, _duration = inspect_media(svg_path, max_width=int(get_app().project.get("width") or 1920),
