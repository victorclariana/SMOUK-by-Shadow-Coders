             words = source_line.split()
@@ -873,51 +888,69 @@ class VerticalizationDockContent(QWidget):
         left = (float(width) - safe_width) / 2.0
         return left, 0.0, left + safe_width, float(height)
 
-    def _title_svg(self, text, template, width, height):
+    @staticmethod
+    def _chyron_vertical_slot_preferences(template):
+        return CHYRON_VERTICAL_SLOT_PREFERENCES.get(
+            template, CHYRON_VERTICAL_SLOT_PREFERENCES["story_headline"])
+
+    def _assign_chyron_vertical_slots(self, events):
+        """Assign distinct safe-area lanes to temporally overlapping chyrons."""
+        active = []
+        for event in sorted(events, key=lambda item: (
+                int(item.get("start_frame", 0)),
+                self._chyron_vertical_slot_preferences(item.get("template", ""))[0],
+                int(item.get("end_frame", 0)))):
+            start_frame = int(event.get("start_frame", 0))
+            active = [candidate for candidate in active
+                      if int(candidate.get("end_frame", 0)) > start_frame]
+            occupied = {candidate.get("vertical_slot") for candidate in active}
+            preferences = self._chyron_vertical_slot_preferences(event.get("template", ""))
+            slot = next((candidate for candidate in preferences if candidate not in occupied),
+                        preferences[0])
+            event["vertical_slot"] = slot
+            active.append(event)
+        return events
+
+    def _title_svg(self, text, template, width, height, vertical_slot=None):
         """Build an editable transparent SVG for a detected broadcast chyron."""
         styles = {
-            "live_location": (.04, .14, "start", 42),
