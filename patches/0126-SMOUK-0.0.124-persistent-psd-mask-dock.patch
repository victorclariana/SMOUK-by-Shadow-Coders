+class MaskSettingsDialog(QDialog):
+    """Non-blocking configuration dialog for the optional PSD readability mask."""
+
+    def __init__(self, owner, parent=None):
+        super().__init__(parent or owner)
+        self.owner = owner
+        self.setWindowTitle("MASK")
+        self.setMinimumWidth(460)
+        layout = QVBoxLayout(self)
+        title = QLabel("MASK", self)
+        title.setStyleSheet("font-weight: bold; font-size: 16px;")
+        layout.addWidget(title)
+        description = QLabel(
+            "Carga una máscara PSD transparente centrada en la zona 9:16. "
+            "La pista queda por encima del vídeo y por debajo de títulos y subtítulos.", self)
+        description.setWordWrap(True)
+        layout.addWidget(description)
+
+        row = QHBoxLayout()
+        self.browse = QPushButton("Browse PSD", self)
+        self.browse.clicked.connect(lambda: owner._on_browse_mask(self))
+        row.addWidget(self.browse)
+        self.path_label = QLabel("No PSD selected", self)
+        self.path_label.setWordWrap(True)
+        row.addWidget(self.path_label, 1)
+        layout.addLayout(row)
+
+        self.x_label = QLabel(self)
+        self.y_label = QLabel(self)
+        self.x_slider = QSlider(Qt.Horizontal, self)
+        self.y_slider = QSlider(Qt.Horizontal, self)
+        for slider in (self.x_slider, self.y_slider):
+            slider.setRange(-100, 100)
+            slider.setSingleStep(1)
+        self.x_slider.valueChanged.connect(lambda value: owner._on_mask_position_changed("x", value, self))
+        self.y_slider.valueChanged.connect(lambda value: owner._on_mask_position_changed("y", value, self))
+        layout.addWidget(self.x_label)
+        layout.addWidget(self.x_slider)
+        layout.addWidget(self.y_label)
+        layout.addWidget(self.y_slider)
+
+        buttons = QDialogButtonBox(QDialogButtonBox.Close, parent=self)
+        buttons.rejected.connect(self.close)
+        buttons.accepted.connect(self.close)
+        layout.addWidget(buttons)
+        self.refresh_from_settings()
+
+    def refresh_from_settings(self):
+        settings = get_app().get_settings()
+        path = str(settings.get("smouk_mask_path_v1") or "")
+        self.path_label.setText(path or "No PSD selected")
+        self.x_slider.blockSignals(True)
+        self.y_slider.blockSignals(True)
+        self.x_slider.setValue(int(round(float(settings.get("smouk_mask_x_v1") or 0.0) * 100)))
+        self.y_slider.setValue(int(round(float(settings.get("smouk_mask_y_v1") or 0.0) * 100)))
+        self.x_slider.blockSignals(False)
+        self.y_slider.blockSignals(False)
+        self.x_label.setText("X: %+.2f (centrado = 0.00)" % (self.x_slider.value() / 100.0))
+        self.y_label.setText("Y: %+.2f (centrado = 0.00)" % (self.y_slider.value() / 100.0))
+
+
