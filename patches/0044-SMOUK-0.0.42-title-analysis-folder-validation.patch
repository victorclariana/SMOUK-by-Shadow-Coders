+    def _build_title_import_controls(self, _):
+        """Add the first-pass folder validator for title reconstruction.
+
+        The button intentionally stops after validation.  OCR and Timeline
+        creation are separate stages so an invalid media set can never mutate
+        the current project.
+        """
+        self.btn_browse_title_folder = QPushButton(
+            _("Select title-analysis folder"), self)
+        self.btn_browse_title_folder.setObjectName("verticalizationBrowseTitleFolder")
+        self.btn_browse_title_folder.setToolTip(_(
+            "Choose a folder containing CLEAN.MP4, DATA.JSON and PROGRAMA.MP4."))
+        self.btn_browse_title_folder.clicked.connect(self._on_browse_title_folder)
+        self.title_folder_results = QLabel(
+            _("No title-analysis folder has been selected."), self)
+        self.title_folder_results.setObjectName("verticalizationTitleFolderResults")
+        self.title_folder_results.setWordWrap(True)
+        self.sections["titles"].add_widget(self.btn_browse_title_folder)
+        self.sections["titles"].add_widget(self.title_folder_results)
+        self.title_analysis_data = None
+
+    def _on_browse_title_folder(self):
+        """Validate a folder before the OCR/title reconstruction stage."""
+        _ = get_app()._tr
+        project_path = getattr(get_app().project, "current_filepath", "")
+        directory = os.path.dirname(project_path) if project_path else ""
+        folder = QFileDialog.getExistingDirectory(
+            self, _("Choose title-analysis folder"), directory,
+            QFileDialog.ShowDirsOnly)
+        if not folder:
+            return
+        result = validate_title_folder(folder, fps=25)
+        self.title_analysis_data = result
+        if not result.get("valid"):
+            details = "\n".join(result.get("errors") or [])
+            self.title_folder_results.setText(
+                _("Invalid title-analysis folder:\n%s") % details)
+            QMessageBox.warning(
+                self, _("Title analysis"),
+                _("The selected folder is not valid. Choose a folder containing "
+                  "CLEAN.MP4, DATA.JSON and PROGRAMA.MP4, with valid cut timecodes.\n\n%s") % details)
+            return
+
+        files = result["files"]
+        tc = result["timecodes"]
+        warnings = result.get("warnings") or []
+        summary = _(
+            "Folder accepted.\nCorte: %s – %s\nClean Feed: %s\nPrograma: %s") % (
+                tc.get("clip_in"), tc.get("clip_out"),
+                os.path.basename(files["clean"]), os.path.basename(files["program"]))
+        if warnings:
+            summary += "\n" + _("Avisos: ") + "; ".join(warnings)
+        self.title_folder_results.setText(summary)
+        QMessageBox.information(self, _("Title analysis"), summary)
+
     def _sync_logo_opacity(self):
         """Show the selected SMOUK logo clip's current alpha value."""
         if not hasattr(self, "logo_opacity_slider"):
