+def _clock_features(frame, cv2):
+    """Return the colour, shape, and visual region used for clock matching."""
+    height, width = frame.shape[:2]
+    frame_area = float(max(1, width * height))
     hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
     orange = cv2.inRange(hsv, (4, 120, 140), (24, 255, 255))
-    orange_ratio = float(cv2.countNonZero(orange)) / float(max(1, width * height))
-    _count, _labels, stats, _centres = cv2.connectedComponentsWithStats(orange)
-    largest_orange = max((int(stat[cv2.CC_STAT_AREA]) for stat in stats[1:]), default=0)
-    largest_orange_ratio = float(largest_orange) / float(max(1, width * height))
-    return digit_like, orange_ratio, largest_orange_ratio
+    neutral = cv2.inRange(hsv, (0, 0, 130), (35, 35, 235))
+    colour_region = cv2.bitwise_or(orange, neutral)
+    points = cv2.findNonZero(colour_region)
+    if points is None:
+        bbox = (0, 0, width, height)
+    else:
+        bbox = cv2.boundingRect(points)
+    x, y, region_width, region_height = bbox
+    region_width = max(1, region_width)
+    region_height = max(1, region_height)
+    return {
+        "orange_ratio": float(cv2.countNonZero(orange)) / frame_area,
+        "neutral_ratio": float(cv2.countNonZero(neutral)) / frame_area,
+        "bbox": (x, y, region_width, region_height),
+        "aspect": float(region_width) / float(region_height),
+        "area_ratio": float(region_width * region_height) / frame_area,
+        "region": frame[y:y + region_height, x:x + region_width],
+    }
+
