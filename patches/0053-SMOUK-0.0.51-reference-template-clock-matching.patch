+def _similarity(value, reference):
+    """Return a bounded similarity score for positive scalar measurements."""
+    reference = max(float(reference), 0.0001)
+    return max(0.0, 1.0 - abs(float(value) - reference) / reference)
+
+
+def _extract_clock_reference(path, ffmpeg, cv2, numpy, second=83):
+    """Build a visual clock template from CLEAN near the expected 01:23."""
+    output_width, output_height = 640, 360
+    # Inspect a narrow window so an edit boundary around exactly 01:23 does
+    # not prevent finding the stable clock frame.
+    start = max(0, int(second) - 2)
+    command = [
+        ffmpeg, "-v", "error", "-ss", str(start), "-t", "5", "-i", path,
+        "-vf", "fps=1,scale=%s:%s:flags=bilinear" % (output_width, output_height),
+        "-an", "-frames:v", "5", "-f", "rawvideo", "-pix_fmt", "bgr24", "pipe:1",
+    ]
+    completed = subprocess.run(  # nosec B603 -- fixed executable and argv list
+        command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+        check=False, timeout=120)
+    frame_size = output_width * output_height * 3
+    available = len(completed.stdout) // frame_size
+    if completed.returncode or not available:
+        return None
+
+    best = None
+    for index in range(available):
+        offset = index * frame_size
+        frame = numpy.frombuffer(completed.stdout[offset:offset + frame_size], dtype=numpy.uint8)
+        frame = frame.reshape((output_height, output_width, 3))
+        features = _clock_features(frame, cv2)
+        # The actual clock fills the view with its orange and neutral panels.
+        quality = features["orange_ratio"] + features["neutral_ratio"]
+        if best is None or quality > best["quality"]:
+            best = {"frame": frame.copy(), "features": features,
+                    "second": float(start + index), "quality": quality}
+    if best is None or best["features"]["orange_ratio"] < 0.20:
+        return None
+
+    region = best["features"]["region"]
+    template = cv2.cvtColor(region, cv2.COLOR_BGR2GRAY)
+    return {
+        "template": template,
+        "template_width": int(template.shape[1]),
+        "template_height": int(template.shape[0]),
+        "features": best["features"],
+        "second": best["second"],
+    }
 
 
-def _clock_probe(path, fps=25, max_seconds=180, progress_callback=None):
+def _clock_score(frame, reference, cv2):
+    """Combine colour, form, template, aspect, and area into one score."""
+    features = _clock_features(frame, cv2)
+    expected = reference["features"]
+    region = features["region"]
+    candidate = cv2.cvtColor(region, cv2.COLOR_BGR2GRAY)
+    candidate = cv2.resize(
+        candidate, (reference["template_width"], reference["template_height"]),
+        interpolation=cv2.INTER_AREA)
+    template_raw = float(cv2.matchTemplate(
+        candidate, reference["template"], cv2.TM_CCOEFF_NORMED)[0][0])
+    template_score = max(0.0, min(1.0, (template_raw + 1.0) / 2.0))
+    color_score = (
+        _similarity(features["orange_ratio"], expected["orange_ratio"]) +
+        _similarity(features["neutral_ratio"], expected["neutral_ratio"])) / 2.0
+    form_score = _similarity(features["aspect"], expected["aspect"])
+    area_score = _similarity(features["area_ratio"], expected["area_ratio"])
+    score = (0.25 * color_score + 0.15 * form_score + 0.45 * template_score +
+             0.15 * area_score)
+    return score, template_score, features
+
+
+def _clock_probe(path, reference, fps=25, max_seconds=180, progress_callback=None):
     """Search the first *max_seconds* for the standard burned-in clock.
 
     The clock's final reading belongs to the OCR stage.  This lightweight
-    detector uses the shared white-numeral/orange-panel appearance to find the
-    first plausible clock frame.  FFmpeg decodes broadcast MP4 files that
-    OpenCV cannot always seek reliably, producing one sample per second for
-    the first three minutes.
+    detector compares every candidate against the reference region with a
+    weighted colour, form, size, aspect, and OpenCV template score.  Three
+    successive sampled frames must agree before a clock is accepted.
     """
     try:
         import cv2
@@ -118,6 +188,7 @@ def _clock_probe(path, fps=25, max_seconds=180, progress_callback=None):
         samples = 0
         first_candidate = None
         candidate_samples = 0
+        persistence = 0
         try:
             while samples < requested_samples:
                 raw_frame = process.stdout.read(frame_size)
@@ -125,22 +196,22 @@ def _clock_probe(path, fps=25, max_seconds=180, progress_callback=None):
                     break
                 frame = numpy.frombuffer(raw_frame, dtype=numpy.uint8)
                 frame = frame.reshape((output_height, output_width, 3))
-                digit_like, orange_ratio, largest_orange_ratio = _clock_components(frame, cv2)
