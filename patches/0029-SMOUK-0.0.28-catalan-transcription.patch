+
+    @staticmethod
+    def _smouk_workspace_root():
+        return os.path.dirname(os.path.dirname(os.path.dirname(
+            os.path.dirname(os.path.abspath(__file__)))))
+
+    @classmethod
+    def _transcription_paths(cls):
+        root = cls._smouk_workspace_root()
+        return {
+            "python": os.path.join(root, ".smouk-transcription", "Scripts", "python.exe"),
+            "setup": os.path.join(root, "scripts", "setup_smouk_transcription.py"),
+            "worker": os.path.join(root, "scripts", "smouk_transcribe.py"),
+            "models": os.path.join(root, ".smouk-models"),
+            "outputs": os.path.join(root, ".smouk-transcriptions"),
+            "venv": os.path.join(root, ".smouk-transcription"),
+        }
+
+    @staticmethod
+    def _same_media_path(left, right):
+        try:
+            return os.path.normcase(os.path.abspath(left)) == os.path.normcase(os.path.abspath(right))
+        except (TypeError, ValueError):
+            return False
+
+    def _on_transcribe_catalan(self):
+        """Transcribe each unique source represented by timeline clips."""
+        _ = get_app()._tr
+        clips = self._timeline_video_clips()
+        sources = []
+        for clip in clips:
+            reader = clip.data.get("reader", {})
+            if reader.get("has_audio") is False:
+                continue
+            path = str(reader.get("path", ""))
+            if path and not any(self._same_media_path(path, existing) for existing in sources):
+                sources.append(path)
+        if not sources:
+            QMessageBox.warning(self, _("Catalan Transcription"),
+                                _("Add one or more videos with audio to the timeline first."))
+            return
+
+        paths = self._transcription_paths()
+        self._transcription_sources = sources
+        self._transcription_outputs = []
+        self._transcription_completed_sources = 0
+        self.transcription_progress.setRange(0, 100)
+        self.transcription_progress.setValue(0)
+        self.transcription_progress.setVisible(True)
+        self.btn_transcribe.setEnabled(False)
+
+        if not os.path.isfile(paths["python"]):
+            answer = QMessageBox.question(
+                self, _("Install Catalan transcription"),
+                _("The first use installs the local faster-whisper engine and then downloads "
+                  "the BSC Catalan model (several GB). Continue?"),
+                QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
+            if answer != QMessageBox.Yes:
+                self._finish_transcription_ui(_("Transcription cancelled."))
+                return
+            launcher = shutil.which("py.exe") or shutil.which("py")
+            if not launcher:
+                self._finish_transcription_ui(
+                    _("Python Launcher was not found. Install Python 3.12 and try again."))
+                return
+            self.transcription_progress.setRange(0, 0)
+            self.transcription_results.setText(_("Installing the transcription engine…"))
+            self._start_transcription_process(
+                launcher, ["-3.12", paths["setup"], "--venv", paths["venv"]], "setup")
+            return
+
+        self._start_next_transcription()
+
+    def _start_transcription_process(self, program, arguments, stage):
+        process = QProcess(self)
+        process.setProcessChannelMode(QProcess.MergedChannels)
+        process.readyReadStandardOutput.connect(self._read_transcription_output)
+        process.finished.connect(self._transcription_process_finished)
+        self._transcription_process = process
+        self._transcription_stage = stage
+        self._transcription_output_buffer = ""
+        self._transcription_log_tail = []
+        process.start(program, arguments)
+
+    def _start_next_transcription(self):
+        _ = get_app()._tr
+        if not self._transcription_sources:
+            self._apply_transcription_outputs()
+            return
+        paths = self._transcription_paths()
+        source = self._transcription_sources[0]
+        digest = hashlib.sha1(os.path.normcase(os.path.abspath(source)).encode(
+            "utf-8", errors="surrogatepass")).hexdigest()[:16]
+        output = os.path.join(paths["outputs"], digest + ".json")
+        self._current_transcription_output = output
+        self.transcription_progress.setRange(0, 100)
+        self.transcription_results.setText(
+            _("Transcribing source %s of %s in Catalan…") %
+            (self._transcription_completed_sources + 1,
+             self._transcription_completed_sources + len(self._transcription_sources)))
+        self._start_transcription_process(paths["python"], [
+            paths["worker"], "--input", source, "--output", output,
+            "--model-dir", paths["models"],
+        ], "transcribe")
+
+    def _read_transcription_output(self):
+        process = self._transcription_process
+        if process is None:
+            return
+        chunk = bytes(process.readAllStandardOutput()).decode("utf-8", errors="replace")
+        self._transcription_output_buffer += chunk
+        lines = self._transcription_output_buffer.split("\n")
+        self._transcription_output_buffer = lines.pop()
+        for line in lines:
+            self._handle_transcription_line(line.strip())
+
+    def _handle_transcription_line(self, line):
+        if not line:
+            return
+        self._transcription_log_tail.append(line)
+        self._transcription_log_tail = self._transcription_log_tail[-30:]
+        if self._transcription_stage == "setup":
+            self.transcription_results.setText(line)
+            return
+        try:
+            event = json.loads(line)
+        except json.JSONDecodeError:
+            log.debug("SMOUK transcription output: %s", line)
+            return
+        event_name = event.get("event")
+        if event_name == "status":
+            self.transcription_results.setText(str(event.get("text", "")))
+        elif event_name == "progress":
+            local = max(0, min(100, int(event.get("value", 0))))
+            total = self._transcription_completed_sources + len(self._transcription_sources)
+            overall = int(round((self._transcription_completed_sources + local / 100.0) * 100 / total))
+            self.transcription_progress.setValue(overall)
+
+    def _transcription_process_finished(self, exit_code, _exit_status):
+        _ = get_app()._tr
+        if self._transcription_output_buffer.strip():
+            self._handle_transcription_line(self._transcription_output_buffer.strip())
+        stage = self._transcription_stage
+        self._transcription_process = None
+        if exit_code != 0:
+            message = "\n".join(self._transcription_log_tail)
+            log.warning("SMOUK %s process failed with exit code %s: %s", stage, exit_code, message)
+            self._finish_transcription_ui(
+                _("Transcription failed. See openshot-qt.log for details."))
+            return
+        if stage == "setup":
+            self.transcription_progress.setRange(0, 100)
+            self._start_next_transcription()
+            return
+
+        try:
+            with open(self._current_transcription_output, "r", encoding="utf-8") as handle:
+                self._transcription_outputs.append(json.load(handle))
+        except (OSError, ValueError) as ex:
+            log.warning("Could not load SMOUK transcription result: %s", ex)
+            self._finish_transcription_ui(_("The transcription result could not be loaded."))
+            return
+        self._transcription_sources.pop(0)
+        self._transcription_completed_sources += 1
+        self._start_next_transcription()
+
+    @staticmethod
+    def _upsert_transcription_caption(clip, caption_text, language, model):
+        effects = clip.data.get("effects")
+        if not isinstance(effects, list):
+            effects = []
+            clip.data["effects"] = effects
+        for effect in effects:
+            if isinstance(effect, dict) and effect.get("smouk_transcription"):
+                effect["caption_text"] = caption_text
+                effect["smouk_transcription_language"] = language
+                effect["smouk_transcription_model"] = model
+                return
+        caption = openshot.EffectInfo().CreateEffect("Caption")
+        caption.Id(get_app().project.generate_id())
+        effect = json.loads(caption.Json())
+        effect["caption_text"] = caption_text
+        effect["smouk_transcription"] = True
+        effect["smouk_transcription_language"] = language
+        effect["smouk_transcription_model"] = model
+        effects.append(effect)
+
+    def _apply_transcription_outputs(self):
+        _ = get_app()._tr
+        clips = self._timeline_video_clips()
+        changed = cue_count = 0
+        transaction_id = (get_app().window.timeline.get_uuid()
+                          if getattr(get_app().window, "timeline", None) else None)
+        get_app().updates.transaction_id = transaction_id
+        try:
+            for result in self._transcription_outputs:
+                source = result.get("source", "")
+                caption_text = str(result.get("srt", "")).strip()
+                language = str(result.get("language", "ca"))
+                model = str(result.get("model", ""))
+                cue_count += len(result.get("cues", []))
+                if not caption_text:
+                    log.info("No speech was detected in %s; no Caption effect added", source)
+                    continue
+                file_obj = File.get(path=source)
+                if file_obj:
+                    file_obj.data["caption"] = caption_text
+                    file_obj.data["smouk_transcription_language"] = language
+                    file_obj.data["smouk_transcription_model"] = model
+                    file_obj.save()
+                for clip in clips:
+                    clip_path = str(clip.data.get("reader", {}).get("path", ""))
+                    if self._same_media_path(clip_path, source):
+                        self._upsert_transcription_caption(clip, caption_text, language, model)
+                        clip.save()
+                        changed += 1
+        finally:
+            get_app().updates.transaction_id = None
+        if changed:
+            get_app().window.refreshFrameSignal.emit()
+        self.transcription_progress.setRange(0, 100)
+        self.transcription_progress.setValue(100)
+        self._finish_transcription_ui(
+            _("Finished: %s Catalan subtitle cues applied to %s clips.") %
+            (cue_count, changed), keep_progress=True)
+
+    def _finish_transcription_ui(self, message, keep_progress=False):
+        self.btn_transcribe.setEnabled(True)
+        if not keep_progress:
+            self.transcription_progress.setRange(0, 100)
+            self.transcription_progress.setVisible(False)
+        self.transcription_results.setText(message)
+
