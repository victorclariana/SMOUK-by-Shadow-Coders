+    def _build_transcription_controls(self, _):
+        """Add one-click offline Catalan transcription and Caption insertion."""
+        self.btn_transcribe = QPushButton(_("Transcribe timeline in Catalan"), self)
+        self.btn_transcribe.setObjectName("verticalizationTranscribeCatalan")
+        self.btn_transcribe.setToolTip(_(
+            "Transcribe every unique timeline source with the local BSC Catalan model "
+            "and apply editable Caption effects."))
+        self.btn_transcribe.clicked.connect(self._on_transcribe_catalan)
+        self.sections["subtitles"].add_widget(self.btn_transcribe)
+
+        self.transcription_progress = QProgressBar(self)
+        self.transcription_progress.setObjectName("verticalizationTranscriptionProgress")
+        self.transcription_progress.setRange(0, 100)
+        self.transcription_progress.setValue(0)
+        self.transcription_progress.setVisible(False)
+        self.sections["subtitles"].add_widget(self.transcription_progress)
+
+        self.transcription_results = QLabel(_("No transcription has been run."), self)
+        self.transcription_results.setObjectName("verticalizationTranscriptionResults")
+        self.transcription_results.setWordWrap(True)
+        self.sections["subtitles"].add_widget(self.transcription_results)
+
+        self._transcription_process = None
+        self._transcription_stage = None
+        self._transcription_sources = []
+        self._transcription_outputs = []
+        self._transcription_output_buffer = ""
+        self._transcription_log_tail = []
