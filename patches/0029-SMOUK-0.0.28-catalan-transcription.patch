+"""Focused tests for SMOUK's standalone subtitle worker."""
+
+import importlib.util
+import os
+import unittest
+
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(__file__))))
+WORKER = os.path.join(ROOT, "scripts", "smouk_transcribe.py")
+SPEC = importlib.util.spec_from_file_location("smouk_transcribe", WORKER)
+worker = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(worker)
+
+
+class SmoukTranscriptionTests(unittest.TestCase):
+    def test_catalan_words_split_on_pause_and_keep_accents(self):
+        cues = worker.words_to_cues([
+            {"start": 0.0, "end": 0.3, "word": "Bon"},
+            {"start": 0.31, "end": 0.8, "word": "dia."},
+            {"start": 1.5, "end": 1.9, "word": "Això"},
+            {"start": 1.91, "end": 2.4, "word": "funciona."},
+        ])
+
+        self.assertEqual([cue["text"] for cue in cues], ["Bon dia.", "Això funciona."])
+        self.assertEqual(cues[1]["start"], 1.5)
+
+    def test_srt_uses_millisecond_timecodes(self):
+        text = worker.cues_to_srt([
+            {"start": 1.234, "end": 2.5, "text": "Parlem en català."},
+        ])
+
+        self.assertEqual(
+            text,
+            "1\n00:00:01,234 --> 00:00:02,500\nParlem en català.\n",
+        )
+
+    def test_long_caption_is_limited_to_two_lines(self):
+        words = [
+            {"start": index * 0.2, "end": index * 0.2 + 0.15, "word": word}
+            for index, word in enumerate(
+                "Aquest és un subtítol català prou llarg per comprovar que la pantalla "
+                "es divideix de manera llegible".split())
+        ]
+
+        cues = worker.words_to_cues(words)
+
+        self.assertTrue(cues)
+        self.assertTrue(all(len(cue["text"].splitlines()) <= 2 for cue in cues))
+        self.assertTrue(all(len(cue["text"].replace("\n", " ")) <= 84 for cue in cues))
+
+
+if __name__ == "__main__":
+    unittest.main()
