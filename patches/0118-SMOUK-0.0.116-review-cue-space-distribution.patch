From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Fri, 25 Sep 2026 15:57:43 +0200
Subject: [PATCH] SMOUK 0.0.116 distribute overlong review cues

---
 src/windows/main_window.py     |  2 +-
 src/windows/verticalization.py | 43 +++++++++++++++++++++++++++++++++-
 2 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 1dd868f5e..50435862c 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.115"
+SMOUK_VERSION = "0.0.116"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index 8a050ae1b..310ee6903 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -2361,8 +2361,49 @@ class VerticalizationDockContent(QWidget):
             self._transcription_outputs[result_index]["cues"][cue_index]["text"] = "\n".join(
                 self._subtitle_lines(merged))
         for result in self._transcription_outputs:
+            result["cues"] = self._redistribute_review_cues(result.get("cues", []))
             result["reviewed_with_parlabe"] = True
 
+    @classmethod
+    def _redistribute_review_cues(cls, cues, max_chars=52):
+        """Keep every post-review cue within one or two safe rows.
+
+        If a manual correction made one original timed cue too long, divide
+        its words over adjacent interpolated intervals before SVG creation.
+        The fixed subtitle font is never resized or distorted.
+        """
+        redistributed = []
+        for cue in cues:
+            text = " ".join(str(cue.get("text", "")).replace("\n", " ").split())
+            words = text.split()
+            chunks = []
+            current = []
+            for word in words:
+                proposed = " ".join(current + [word])
+                if current and len(proposed) > max_chars:
+                    chunks.append(" ".join(current))
+                    current = [word]
+                else:
+                    current.append(word)
+            if current:
+                chunks.append(" ".join(current))
+            if not chunks:
+                continue
+            start = float(cue.get("start", 0.0))
+            end = float(cue.get("end", start))
+            span = max(0.0, end - start)
+            total = float(sum(max(1, len(chunk)) for chunk in chunks))
+            cursor = start
+            for index, chunk in enumerate(chunks):
+                next_cursor = end if index == len(chunks) - 1 else cursor + span * max(1, len(chunk)) / total
+                item = dict(cue)
+                item["start"] = cursor
+                item["end"] = next_cursor
+                item["text"] = "\n".join(cls._subtitle_lines(chunk))
+                redistributed.append(item)
+                cursor = next_cursor
+        return redistributed
+
     def _read_transcription_output(self):
         # Retained for compatibility with older dock instances.  New jobs
         # are drained by _poll_transcription_process above.
@@ -2599,7 +2640,7 @@ class VerticalizationDockContent(QWidget):
         # Fixed typography: no textLength, scale or per-cue font adjustment.
         # The usable width determines one constant pixel size for the whole
         # subtitle track; long corrected text is wrapped into more rows.
-        font_size = min(128.0 * guide_fraction, text_width / (26.0 * 0.60))
+        font_size = min(128.0 * guide_fraction, text_width / (26.0 * 0.72))
         line_height = font_size * 1.15
         center_y = float(height) * VERTICAL_SUBTITLE_CENTER
         first_y = center_y - (len(lines) - 1) * line_height / 2.0
