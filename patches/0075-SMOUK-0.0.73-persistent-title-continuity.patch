+    @staticmethod
+    def _merge_persistent_chyrons(events):
+        """Bridge OCR blind spots in one unchanged TNM topic label.
+
+        The lower-left persistent label remains valid across a story, but can
+        be obscured by broadcaster subtitles or lose contrast at a scene cut.
+        It must therefore stay one editable Timeline clip. Other template
+        types keep their exact visual spans.
+        """
+        merged = []
+        maximum_gap = PERSISTENT_TITLE_BRIDGE_SECONDS * 25
+        for event in sorted(events, key=lambda item: item.get("start_frame", 0)):
+            # Other simultaneous labels may occur between two sampling hits;
+            # find the most recent persistent label without crossing a change
+            # to a different persistent topic.
+            previous = next((candidate for candidate in reversed(merged)
+                             if candidate.get("template") == "persistent_headline"), None)
+            if (event.get("template") == "persistent_headline" and previous and
+                    previous.get("template") == "persistent_headline" and
+                    event.get("start_frame", 0) - previous.get("end_frame", 0) <= maximum_gap and
+                    VerticalizationDockContent._same_chyron_text(
+                        previous.get("text"), event.get("text"))):
+                previous["end_frame"] = max(previous["end_frame"], event["end_frame"])
+                previous["confidence"] = max(float(previous.get("confidence", 0.0)),
+                                             float(event.get("confidence", 0.0)))
+                previous["samples"] = previous.get("samples", 0) + event.get("samples", 0)
+                if len(event.get("text", "")) > len(previous.get("text", "")):
+                    previous["text"] = event["text"]
+                    previous["normalised"] = event.get("normalised", event["text"].casefold())
+                continue
+            merged.append(event)
+        return merged
+
     @staticmethod
     def _chyron_regions(width, height):
         """Return the TNM title zones from the editorial graphics manual.
@@ -1302,7 +1343,7 @@ class VerticalizationDockContent(QWidget):
                      95 + int(3 * number / max(1, total_events)), 100)
             refined_events.append(self._refine_chyron_boundaries(
                 program_path, event, cv2, numpy))
-        events = refined_events
+        events = self._merge_persistent_chyrons(refined_events)
         if len(events) > MAX_CHYRON_EVENTS:
             raise RuntimeError(
                 "Se han detectado %s candidatos; el límite seguro es %s. "
