@@ -357,6 +364,51 @@ class VerticalizationDockContent(QWidget):
             return None
         return Clip.get(id=clip_ids[0])
 
+    def _connect_reframe_sync(self):
+        """Keep the slider aligned with timeline selection and playhead state."""
+        if hasattr(self.window, "SelectionAdded"):
+            self.window.SelectionAdded.connect(lambda *_args: self._sync_reframe_slider())
+        if hasattr(self.window, "SelectionRemoved"):
+            self.window.SelectionRemoved.connect(lambda *_args: self._sync_reframe_slider())
+        if hasattr(self.window, "SeekSignal"):
+            self.window.SeekSignal.connect(lambda *_args: self._sync_reframe_slider())
+
+    def _on_reframe_press(self):
+        self._reframe_dragging = True
+
+    def _on_reframe_release(self):
+        self._reframe_dragging = False
+
+    def _reframe_max_offset(self):
+        return (1.0 - (self._output_ratio() / (16.0 / 9.0))) / 2.0
+
+    def _reframe_value_at_frame(self, clip, frame):
+        """Evaluate the clip's existing location_x keyframe at a source frame."""
+        keyframe_data = clip.data.get("location_x")
+        if not keyframe_data or not keyframe_data.get("Points"):
+            return 0.0
+        try:
+            keyframe = openshot.Keyframe()
+            keyframe.SetJson(json.dumps(keyframe_data))
+            return float(keyframe.GetValue(frame))
+        except (RuntimeError, TypeError, ValueError):
+            return 0.0
+
+    def _sync_reframe_slider(self):
+        """Show centre for untouched clips, or their saved reframe position."""
+        if self._reframe_dragging:
+            return
+        window = get_app().window
+        clip = self._selected_clip()
+        value = 0.0
+        if window is not None and clip is not None:
+            value = self._reframe_value_at_frame(clip, self._clip_frame(clip, window))
+        max_offset = max(self._reframe_max_offset(), 0.0001)
+        slider_value = int(round(max(-1.0, min(1.0, value / max_offset)) * 1000))
+        self.reframe_slider.blockSignals(True)
+        self.reframe_slider.setValue(slider_value)
+        self.reframe_slider.blockSignals(False)
+
     @staticmethod
     def _clip_frame(clip, window):
         """Return the selected clip's current one-based source frame."""
@@ -383,8 +435,7 @@ class VerticalizationDockContent(QWidget):
             return
 
         # Keep the selected output crop entirely inside a 16:9 source frame.
-        max_offset = (1.0 - (self._output_ratio() / (16.0 / 9.0))) / 2.0
-        value = (self.reframe_slider.value() / 1000.0) * max_offset
+        value = (self.reframe_slider.value() / 1000.0) * self._reframe_max_offset()
         fps = get_app().project.get("fps")
         fps_value = float(fps["num"]) / float(fps["den"])
         frame = self._clip_frame(clip, window)
