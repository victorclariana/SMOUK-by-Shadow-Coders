izationDockContent(QWidget):        def _start_parlabe_review(self):          """Run conservative sentence correction before showing the editor.""" +        log.info("SMOUK transcription boundary: entering ParlaBE review setup")          paths = self._transcription_paths()          if not os.path.isfile(paths["parlabe_worker"]):              log.warning("ParlaBE correction worker is not available; showing raw transcription") -            self._show_transcription_review(self._transcription_outputs) +            self._schedule_transcription_review(self._transcription_outputs, +                                                "ParlaBE worker unavailable")              return          output_dir = paths["outputs"]          os.makedirs(output_dir, exist_ok=True) @@ -2222,9 +2247,17 @@ class VerticalizationDockContent(QWidget):          correction_python = os.environ.get("SMOUK_PARLABE_PYTHON", "")          if not correction_python or not os.path.isfile(correction_python):              correction_python = shutil.which("python") or paths["python"] +        log.info("SMOUK transcription boundary: starting ParlaBE child program=%s", correction_python)          self._start_transcription_process(correction_python, arguments, "correct")   +    def _schedule_transcription_review(self, outputs, reason): +        """Open review only after the worker/timer callback has returned.""" +        log.info("SMOUK transcription boundary: scheduling review dialog (%s)", reason) +        QtCore.QTimer.singleShot(150, lambda outputs=outputs: +                                 self._show_transcription_review(outputs)) +      def _show_transcription_review(self, outputs): +        """Create a modal, non-blocking review dialog at a safe Qt boundary."""          sentences = []          if isinstance(outputs, dict):              sentences = outputs.get("sentences", []) @@ -2239,15 +2272,38 @@ class VerticalizationDockContent(QWidget):                                        "corrected": " ".join(str(cue.get("text", "")).split())})          self._transcription_review_sentences = sentences          if not sentences: -            self._apply_transcription_outputs() +            log.info("SMOUK transcription boundary: no review sentences; scheduling Timeline placement") +            QtCore.QTimer.singleShot(0, self._apply_transcription_outputs)              return          dialog = TranscriptionReviewDialog(sentences, self) -        if dialog.exec_() != QDialog.Accepted: -            self._finish_transcription_ui(_("Transcription review cancelled.")) -            return -        self._apply_review_sentences(sentences) +        # QDialog.exec_() starts a nested event loop.  Invoking it from a +        # process-completion timer was the native Qt crash path.  open() keeps +        # the same modal user experience without nesting the event loop. +        self._transcription_review_dialog = dialog +        dialog.setModal(True) +        dialog.accepted.connect(self._accept_transcription_review) +        dialog.rejected.connect(self._cancel_transcription_review) +        dialog.finished.connect(self._release_transcription_review_dialog) +        log.info("SMOUK transcription boundary: opening non-blocking review dialog; sentences=%s", +                 len(sentences)) +        dialog.open() + +    def _accept_transcription_review(self): +        """Apply editor changes only after the dialog has emitted Accepted.""" +        log.info("SMOUK transcription boundary: review accepted; scheduling Timeline placement") +        QtCore.QTimer.singleShot(0, self._commit_transcription_review) + +    def _commit_transcription_review(self): +        self._apply_review_sentences(self._transcription_review_sentences)          self._apply_transcription_outputs()   +    def _cancel_transcription_review(self): +        log.info("SMOUK transcription boundary: review cancelled") +        self._finish_transcription_ui(_("Transcription review cancelled.")) + +    def _release_transcription_review_dialog(self, _result): +        self._transcription_review_dialog = None +      @staticmethod      def _split_review_text(text, count, original_lengths=None):          words = str(text or "").split() @@ -2325,8 +2381,6 @@ class VerticalizationDockContent(QWidget):              # and publish the final state when the process finishes.              self._transcription_last_status = str(event.get("text", ""))              log.info("SMOUK worker status: %s", self._transcription_last_status) -            if self._transcription_stage == "correct" and self._transcription_last_status: -                self.transcription_results.setText(self._transcription_last_status)          elif event_name == "partial":              text = str(event.get("text", "")).strip()              if text: @@ -2340,12 +2394,13 @@ class VerticalizationDockContent(QWidget):              self._transcription_last_progress = overall              log.info("SMOUK worker progress: %s%%", overall)   -    def _transcription_process_finished(self, exit_code, _exit_status): +    def _transcription_process_finished(self, exit_code, _exit_status, completed_stage=None):          _ = get_app()._tr +        self._transcription_completion_pending = False          if self._transcription_output_buffer.strip():              self._handle_transcription_line(self._transcription_output_buffer.strip()) -        stage = self._transcription_stage -        log.info("SMOUK transcription worker finished: stage=%s exit_code=%s", +        stage = completed_stage or self._transcription_stage +        log.info("SMOUK transcription boundary: completing deferred stage=%s exit_code=%s",                   stage, exit_code)          self._transcription_process = None          self._transcription_reader = None @@ -2353,9 +2408,9 @@ class VerticalizationDockContent(QWidget):              message = "\n".join(self._transcription_log_tail)              log.warning("SMOUK %s process failed with exit code %s: %s", stage, exit_code, message