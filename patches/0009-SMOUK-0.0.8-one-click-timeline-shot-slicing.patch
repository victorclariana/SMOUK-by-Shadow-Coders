+        video_extensions = {".avi", ".m4v", ".mkv", ".mov", ".mp4", ".mpeg", ".mpg", ".webm"}
+        clips = []
+        for clip in Clip.filter():
+            path = str(clip.data.get("reader", {}).get("path", ""))
+            if path and os.path.isfile(path) and os.path.splitext(path)[1].lower() in video_extensions:
+                clips.append(clip)
+        return clips
 
