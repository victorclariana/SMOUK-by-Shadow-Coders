+    @staticmethod
+    def _slice_clip_at_cuts(window, clip, cuts):
+        """Slice one clip right-to-left so every split keeps both resulting sides."""
+        clip_start = float(clip.data.get("start", 0.0))
+        clip_end_value = clip.data.get("end")
+        clip_end = (float(clip_end_value) if clip_end_value is not None else
+                    clip_start + float(clip.data.get("duration", 0.0)))
+        clip_position = float(clip.data.get("position", 0.0))
+        valid_cuts = [cut for cut in cuts if clip_start < cut < clip_end]
+        for cut in sorted(valid_cuts, reverse=True):
+            window.timeline.Slice_Triggered(
+                MenuSlice.KEEP_BOTH, [clip.id], [],
+                clip_position + (cut - clip_start))
+        return len(valid_cuts)
 
