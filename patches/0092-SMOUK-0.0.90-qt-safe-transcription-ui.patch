From f17a6a9069aa7a601285d1b7d581c653d8f88a4e Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Tue, 22 Sep 2026 18:04:57 +0200
Subject: [PATCH] SMOUK 0.0.90 defer Qt transcription updates

---
 src/windows/main_window.py     |  2 +-
 src/windows/verticalization.py | 19 ++++++++++++++-----
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index e90569b87..c3c2a2f22 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.89"
+SMOUK_VERSION = "0.0.90"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index 3f37dc46c..b69d1b450 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -430,6 +430,9 @@ class VerticalizationDockContent(QWidget):
         self._transcription_outputs = []
         self._transcription_output_buffer = ""
         self._transcription_log_tail = []
+        self._transcription_last_status = ""
+        self._transcription_last_progress = 0
+        self._transcription_last_partial = ""
         self._transcription_completed_sources = 0
         # Keep worker stdout off Qt's QProcess readyRead path.  On the
         # packaged MSYS2 Qt build, bursts of progress signals can trigger a
@@ -2130,18 +2133,24 @@ class VerticalizationDockContent(QWidget):
             log.error("SMOUK worker error: %s", json.dumps(event, ensure_ascii=False))
             return
         if event_name == "status":
-            self.transcription_results.setText(str(event.get("text", "")))
+            # Do not mutate Qt widgets from the high-frequency worker drain.
+            # Qt5Core on the managed MSYS2 build can fail-fast immediately
+            # after the first native inference result. Keep the breadcrumb
+            # and publish the final state when the process finishes.
+            self._transcription_last_status = str(event.get("text", ""))
+            log.info("SMOUK worker status: %s", self._transcription_last_status)
         elif event_name == "partial":
             text = str(event.get("text", "")).strip()
             if text:
-                self.transcription_results.setText(
-                    _("Partial Catalan transcription (%s words): %s") %
-                    (event.get("words", 0), text))
+                self._transcription_last_partial = text
+                log.info("SMOUK worker partial: words=%s text=%s",
+                         event.get("words", 0), text)
         elif event_name == "progress":
             local = max(0, min(100, int(event.get("value", 0))))
             total = self._transcription_completed_sources + len(self._transcription_sources)
             overall = int(round((self._transcription_completed_sources + local / 100.0) * 100 / total))
-            self.transcription_progress.setValue(overall)
+            self._transcription_last_progress = overall
+            log.info("SMOUK worker progress: %s%%", overall)
 
     def _transcription_process_finished(self, exit_code, _exit_status):
         _ = get_app()._tr
