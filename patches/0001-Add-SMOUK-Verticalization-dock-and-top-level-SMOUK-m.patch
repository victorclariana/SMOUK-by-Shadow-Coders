+ A PARTICULAR PURPOSE. See the GNU General Public License for more details.
+"""
+
+from qt_api import (
+    Qt, QWidget, QFrame, QLabel, QScrollArea, QToolButton, QVBoxLayout,
+)
+
+from classes.app import get_app
+
+
+VERTICALIZATION_DOCK_MIN_WIDTH = 320
+
+
+class CollapsibleSection(QFrame):
+    """A collapsible panel with a header toggle and a content area."""
+
+    def __init__(self, title, parent=None):
+        super().__init__(parent)
+        self.setObjectName("verticalizationSection")
+
+        outer = QVBoxLayout(self)
+        outer.setContentsMargins(0, 0, 0, 0)
+        outer.setSpacing(0)
+
+        self.toggle_button = QToolButton(self)
+        self.toggle_button.setObjectName("verticalizationSectionHeader")
+        self.toggle_button.setText(title)
+        self.toggle_button.setCheckable(True)
+        self.toggle_button.setChecked(True)
+        self.toggle_button.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
+        self.toggle_button.setArrowType(Qt.DownArrow)
+        self.toggle_button.setCursor(Qt.PointingHandCursor)
+        self.toggle_button.toggled.connect(self._on_toggled)
+        outer.addWidget(self.toggle_button)
+
+        self.content = QWidget(self)
+        self.content.setObjectName("verticalizationSectionContent")
+        self.content_layout = QVBoxLayout(self.content)
+        self.content_layout.setContentsMargins(8, 6, 8, 8)
+        self.content_layout.setSpacing(4)
+        outer.addWidget(self.content)
+
+    def _on_toggled(self, checked):
+        """Show/hide the content area and update the arrow direction."""
+        self.content.setVisible(checked)
+        self.toggle_button.setArrowType(Qt.DownArrow if checked else Qt.RightArrow)
+
+    def add_widget(self, widget):
+        """Add a widget to the section's content area."""
+        self.content_layout.addWidget(widget)
+
+
+class VerticalizationDockContent(QWidget):
+    """SMOUK verticalization dock, organized as collapsible sections.
+
+    This is the first skeleton: the sections exist and are collapsible, but no
+    business logic is wired up yet.
+    """
+
+    # (object key, translated title, short description)
+    SECTIONS = [
+        ("source_video", "Source Video", "Select and import a horizontal MP4."),
+        ("shot_detection", "Shot Detection", "Detect and review scene cuts."),
+        ("automatic_reframing", "Automatic Reframing", "Auto reframe each shot to 9:16."),
+        ("titles", "Titles", "Add identifying titles."),
+        ("subtitles", "Subtitles", "Generate Catalan subtitles."),
+        ("logo", "Logo", "Add a company logo overlay."),
+        ("poster", "Poster", "Export a PNG poster from a frame."),
+        ("export", "Export", "Export the vertical video."),
+    ]
+
+    def __init__(self, window, parent=None):
+        super().__init__(parent)
+        self.window = window
+        _ = get_app()._tr
+
+        self.setFocusPolicy(Qt.NoFocus)
+        self.setMinimumWidth(VERTICALIZATION_DOCK_MIN_WIDTH)
+
+        outer = QVBoxLayout(self)
+        outer.setContentsMargins(0, 0, 0, 0)
+        outer.setSpacing(0)
+
+        self.scroll_area = QScrollArea(self)
+        self.scroll_area.setWidgetResizable(True)
+        self.scroll_area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
+        self.scroll_area.setFrameShape(QScrollArea.NoFrame)
+        self.scroll_area.setStyleSheet(
+            "QScrollArea { border: none; background: transparent; }")
+        outer.addWidget(self.scroll_area)
+
+        self.scroll_content = QWidget()
+        self.scroll_area.setWidget(self.scroll_content)
+        layout = QVBoxLayout(self.scroll_content)
+        layout.setContentsMargins(8, 8, 8, 8)
+        layout.setSpacing(6)
+
+        self.sections = {}
+        for key, title, description in self.SECTIONS:
+            section = CollapsibleSection(_(title))
+            placeholder = QLabel(_(description), section.content)
+            placeholder.setObjectName("verticalizationPlaceholder")
+            placeholder.setWordWrap(True)
+            section.add_widget(placeholder)
+            self.sections[key] = section
+            layout.addWidget(section)
+
+        layout.addStretch(1)
