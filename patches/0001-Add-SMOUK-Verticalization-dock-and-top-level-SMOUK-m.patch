diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 843715975..ee693bf82 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -83,6 +83,7 @@ from windows.models.files_model import FilesModel
 from windows.views.optimized_preview_menu import populate_optimized_preview_menu
 from windows.models.transition_model import TransitionsModel
 from windows.audio_recording import AudioRecordingDockContent, RECORDING_DOCK_MIN_WIDTH
+from windows.verticalization import VerticalizationDockContent, VERTICALIZATION_DOCK_MIN_WIDTH
 from windows.preview_thread import PreviewParent
 from windows.scope_panel import WaveformDockContent, HistogramDockContent, VectorscopeDockContent, AudioMeterWidget
 from windows.video_widget import VideoWidget
@@ -5461,9 +5462,30 @@ class MainWindow(updates.UpdateWatcher, QMainWindow):
         self.dockAudioRecording.hide()
         self.addDockWidget(Qt.RightDockWidgetArea, self.dockAudioRecording)
 
+        # SMOUK verticalization dock
+        self.verticalization_content = VerticalizationDockContent(self)
+        self.dockVerticalization = QDockWidget(_("Verticalization"), self)
+        self.dockVerticalization.setObjectName("dockVerticalization")
+        self.dockVerticalization.setProperty("_skip_auto_tab_order", True)
+        self.dockVerticalization.setFocusPolicy(Qt.NoFocus)
+        self.dockVerticalization.setMinimumWidth(VERTICALIZATION_DOCK_MIN_WIDTH)
+        self.dockVerticalization.setWidget(self.verticalization_content)
+        self.dockVerticalization.hide()
+        self.addDockWidget(Qt.RightDockWidgetArea, self.dockVerticalization)
+
         # Add Docks submenu to View menu
         self.addViewDocksMenu()
 
+        # Add a top-level SMOUK menu (placed before Help) with the
+        # Verticalization dock toggle and room for future SMOUK actions.
+        self.menuSmouk = QMenu(_("SMOUK"), self.menuBar())
+        self.menuSmouk.setObjectName("menuSmouk")
+        if hasattr(self, "menuHelp"):
+            self.menuBar().insertMenu(self.menuHelp.menuAction(), self.menuSmouk)
+        else:
+            self.menuBar().addMenu(self.menuSmouk)
+        self.menuSmouk.addAction(self.dockVerticalization.toggleViewAction())
+
         # Set up status bar
         self.statusBar = QStatusBar()
         self.setStatusBar(self.statusBar)
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
new file mode 100644
index 000000000..0f4bcd250
