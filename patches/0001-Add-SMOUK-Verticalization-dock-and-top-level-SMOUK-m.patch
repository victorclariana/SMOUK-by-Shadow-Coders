+++ b/src/windows/verticalization.py
@@ -0,0 +1,125 @@
+"""
+ @file
+ @brief Verticalization dock for SMOUK (auto-verticalize 16:9 to 9:16).
+ @author Shadow Coders
+
+ @section LICENSE
+
+ Copyright (c) 2026 Shadow Coders. This file is part of SMOUK by Shadow Coders,
