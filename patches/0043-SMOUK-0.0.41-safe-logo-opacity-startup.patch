From 711a74426677678532cea23782726c2e06f71c02 Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Wed, 16 Sep 2026 22:38:15 +0200
Subject: [PATCH] SMOUK 0.0.41 safe logo opacity startup

---
 src/windows/main_window.py     | 2 +-
 src/windows/verticalization.py | 5 -----
 2 files changed, 1 insertion(+), 6 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 3ba7864f2..1017c72f5 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.40"
+SMOUK_VERSION = "0.0.41"
 
 
 class MainWindow(updates.UpdateWatcher, QMainWindow):
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index ffac81c87..c8796290a 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -1487,11 +1487,6 @@ class VerticalizationDockContent(QWidget):
             self.window.SelectionRemoved.connect(lambda *_args: self._sync_reframe_slider())
         if hasattr(self.window, "SeekSignal"):
             self.window.SeekSignal.connect(lambda *_args: self._sync_reframe_slider())
-            self.window.SeekSignal.connect(lambda *_args: self._sync_logo_opacity())
-        if hasattr(self.window, "SelectionAdded"):
-            self.window.SelectionAdded.connect(lambda *_args: self._sync_logo_opacity())
-        if hasattr(self.window, "SelectionRemoved"):
-            self.window.SelectionRemoved.connect(lambda *_args: self._sync_logo_opacity())
 
     def _on_reframe_press(self):
         self._reframe_dragging = True
