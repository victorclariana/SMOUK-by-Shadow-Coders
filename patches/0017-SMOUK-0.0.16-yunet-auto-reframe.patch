+    def _build_auto_reframe_controls(self, _):
+        """Add the offline YuNet face-following action."""
+        self.btn_auto_reframe = QPushButton(_("Auto reframe timeline clips"), self)
+        self.btn_auto_reframe.setObjectName("verticalizationAutoReframe")
+        self.btn_auto_reframe.setToolTip(
+            _("Detect the main face in each shot and write smooth horizontal keyframes."))
+        self.btn_auto_reframe.clicked.connect(self._on_auto_reframe_timeline)
+        self.sections["automatic_reframing"].add_widget(self.btn_auto_reframe)
+
+        self.reframe_progress = QProgressBar(self)
+        self.reframe_progress.setObjectName("verticalizationReframeProgress")
+        self.reframe_progress.setVisible(False)
+        self.sections["automatic_reframing"].add_widget(self.reframe_progress)
+
+        self.reframe_results = QLabel(_("No automatic reframing has been run."), self)
+        self.reframe_results.setObjectName("verticalizationReframeResults")
+        self.reframe_results.setWordWrap(True)
+        self.sections["automatic_reframing"].add_widget(self.reframe_results)
+
+    @staticmethod
+    def _yunet_model_path():
+        return os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+                            "models", "face_detection_yunet_2023mar.onnx")
+
+    def _auto_reframe_clip(self, clip, cv2):
+        """Track the largest detected face and return sparse clip keyframes."""
+        path = str(clip.data.get("reader", {}).get("path", ""))
+        capture = cv2.VideoCapture(path)
+        if not capture.isOpened():
+            raise RuntimeError("could not open video")
+        try:
+            fps = float(capture.get(cv2.CAP_PROP_FPS) or 0)
+            width = int(capture.get(cv2.CAP_PROP_FRAME_WIDTH) or 0)
+            height = int(capture.get(cv2.CAP_PROP_FRAME_HEIGHT) or 0)
+            if fps <= 0 or width <= 0 or height <= 0:
+                raise RuntimeError("video has no valid dimensions")
+
+            detector = cv2.FaceDetectorYN_create(self._yunet_model_path(), "", (width, height),
+                                                  0.78, 0.3, 5000)
+            start = float(clip.data.get("start", 0.0))
+            end = float(clip.data.get("end") or (start + float(clip.data.get("duration", 0.0))))
+            if end <= start:
+                return []
+            sample_step = max(1, int(round(fps / 4.0)))  # four samples per second
+            redetect_step = max(sample_step, int(round(fps)))
+            tracker = None
+            smoothed_x = None
+            samples = []
+            frame_number = int(round(start * fps))
+            end_number = int(round(end * fps))
+            capture.set(cv2.CAP_PROP_POS_FRAMES, frame_number)
+
+            while frame_number <= end_number:
+                ok, frame = capture.read()
+                if not ok:
+                    break
+                box = None
+                if frame_number % redetect_step == 0 or tracker is None:
+                    _ok, faces = detector.detect(frame)
+                    if faces is not None and len(faces):
+                        face = max(faces, key=lambda candidate: candidate[2] * candidate[3])
+                        box = tuple(float(value) for value in face[:4])
+                        tracker = cv2.TrackerCSRT_create()
+                        tracker.init(frame, box)
+                elif tracker is not None:
+                    tracked, tracked_box = tracker.update(frame)
+                    if tracked:
+                        box = tracked_box
+
+                if box is not None:
+                    face_center = (box[0] + (box[2] / 2.0)) / width
+                    target = max(-self._reframe_max_offset(), min(
+                        self._reframe_max_offset(),
+                        -(face_center - 0.5) * 2.0 * self._reframe_max_offset()))
+                    smoothed_x = target if smoothed_x is None else (0.65 * smoothed_x + 0.35 * target)
+                    samples.append((frame_number + 1, smoothed_x))
+
+                for _unused in range(sample_step - 1):
+                    if not capture.grab():
+                        break
+                frame_number += sample_step
+
+            if not samples:
+                return []
+            # Keep sparse keyframes; values under 1% of the permitted travel
+            # are visually indistinguishable and only create jitter.
+            points = [samples[0]]
+            threshold = self._reframe_max_offset() * 0.02
+            for sample in samples[1:-1]:
+                if abs(sample[1] - points[-1][1]) >= threshold:
+                    points.append(sample)
+            if samples[-1][0] != points[-1][0]:
+                points.append(samples[-1])
+            return points
+        finally:
+            capture.release()
+
+    def _on_auto_reframe_timeline(self):
+        """Apply YuNet + CSRT horizontal framing to every timeline video clip."""
+        _ = get_app()._tr
+        try:
+            import cv2
+        except ImportError:
+            QMessageBox.warning(self, _("Automatic Reframing"),
+                                _("OpenCV Python is not installed."))
+            return
+        if not os.path.isfile(self._yunet_model_path()):
+            QMessageBox.warning(self, _("Automatic Reframing"),
+                                _("The YuNet face model is missing."))
+            return
+        clips = self._timeline_video_clips()
+        if not clips:
+            QMessageBox.warning(self, _("Automatic Reframing"),
+                                _("Add one or more video clips to the timeline first."))
+            return
+
+        self.btn_auto_reframe.setEnabled(False)
+        self.reframe_progress.setRange(0, len(clips))
+        self.reframe_progress.setValue(0)
+        self.reframe_progress.setVisible(True)
+        changed = failed = 0
+        try:
+            for index, clip in enumerate(clips, start=1):
+                self.reframe_results.setText(_("Following faces in clip %s of %s…") % (index, len(clips)))
+                get_app().processEvents()
+                try:
+                    points = self._auto_reframe_clip(clip, cv2)
+                    if points:
+                        clip.data["location_x"] = {"Points": [
+                            {"co": {"X": frame, "Y": value}, "interpolation": openshot.BEZIER}
+                            for frame, value in points]}
+                        clip.save()
+                        changed += 1
+                except Exception as ex:
+                    failed += 1
+                    log.warning("SMOUK automatic reframing failed for %s: %s", clip.id, ex)
+                self.reframe_progress.setValue(index)
+                get_app().processEvents()
+        finally:
+            self.btn_auto_reframe.setEnabled(True)
+        if changed:
+            get_app().window.refreshFrameSignal.emit()
+        self.reframe_results.setText(_("Finished: %s clips reframed%s.") %
+                                     (changed, _("; %s failed") % failed if failed else ""))
+
     @staticmethod
     def _format_timecode(seconds):
         minutes, seconds = divmod(float(seconds), 60.0)
