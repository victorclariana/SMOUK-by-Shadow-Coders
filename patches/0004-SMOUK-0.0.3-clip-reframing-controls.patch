-# Built-in 9:16 profile shipped with OpenShot (FHD Vertical 1080p 30 fps).
-VERTICAL_PROFILE_FILE = "01080x1920p0030_09-16"
+# OpenShot ships these profiles. SMOUK exposes the supported output choices
+# without changing the 16:9 editing project.
+OUTPUT_PROFILES = (
+    ("1080 x 1350 (4:5) - 25 fps", "01080x1350p0025_04-05", 4.0 / 5.0),
+    ("1080 x 1350 (4:5) - 30 fps", "01080x1350p0030_04-05", 4.0 / 5.0),
+    ("1080 x 1920 (9:16) - 25 fps", "01080x1920p0025_09-16", 9.0 / 16.0),
