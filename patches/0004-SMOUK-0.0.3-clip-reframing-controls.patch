         layout.addWidget(controls)
 
-    def _on_set_vertical_project(self):
-        """Switch the current project to the built-in 9:16 vertical profile."""
-        profile_path = os.path.join(info.PROFILES_PATH, VERTICAL_PROFILE_FILE)
-        try:
-            profile = openshot.Profile(profile_path)
-        except Exception as ex:
-            log.warning("SMOUK: unable to load vertical profile '%s': %s",
-                        profile_path, ex)
-            return
+    def _on_output_profile_changed(self, _index):
+        """Persist the selected SMOUK output profile without changing the edit canvas."""
+        profile_id = self.output_profile.currentData()
+        settings = get_app().get_settings()
+        settings.set("smouk_vertical_output_profile", profile_id)
+        if hasattr(settings, "save"):
+            settings.save()
+        self._apply_output_ratio_to_preview()
+
+    def _output_ratio(self):
+        return OUTPUT_PROFILES[self.output_profile.currentIndex()][2]
+
+    def _apply_output_ratio_to_preview(self):
+        preview = getattr(get_app().window, "videoPreview", None)
+        if preview is not None and hasattr(preview, "set_verticalization_overlay_ratio"):
+            preview.set_verticalization_overlay_ratio(self._output_ratio())
+
+    def _selected_clip(self):
+        """Return the one timeline clip currently being reframed, if any."""
+        window = get_app().window
+        clip_ids = getattr(window, "selected_clips", []) if window else []
+        if callable(clip_ids):
+            clip_ids = clip_ids()
+        if not clip_ids:
+            return None
+        return Clip.get(id=clip_ids[0])
+
+    @staticmethod
+    def _clip_frame(clip, window):
+        """Return the selected clip's current one-based source frame."""
+        fps = get_app().project.get("fps")
+        fps_value = float(fps["num"]) / float(fps["den"])
+        playhead = float(getattr(window.preview_thread, "current_frame", 1))
+        position = float(clip.data.get("position", 0.0)) * fps_value
+        clip_start = float(clip.data.get("start", 0.0)) * fps_value
+        return max(1, int(round(playhead - position + clip_start)))
+
+    @staticmethod
+    def _clip_end_frame(clip, fps_value, start_frame):
+        end = clip.data.get("end")
+        if end is None:
+            return start_frame
+        return max(start_frame, int(round(float(end) * fps_value)))
+
+    def _on_reframe_changed(self):
+        """Store a fixed reframe, or a keyframe at the current playhead position."""
         window = get_app().window
-        if window is not None and hasattr(window, "actionProfile_trigger"):
-            window.actionProfile_trigger(profile)
+        clip = self._selected_clip()
+        if window is None or clip is None:
+            log.info("SMOUK: select one timeline clip before reframing")
+            return
+
+        # Keep the selected output crop entirely inside a 16:9 source frame.
+        max_offset = (1.0 - (self._output_ratio() / (16.0 / 9.0))) / 2.0
+        value = (self.reframe_slider.value() / 1000.0) * max_offset
+        fps = get_app().project.get("fps")
+        fps_value = float(fps["num"]) / float(fps["den"])
+        frame = self._clip_frame(clip, window)
+
+        if self.chk_keyframes.isChecked():
+            window.videoPreview.updateClipProperty(clip.id, frame, "location_x", value)
+            return
+
+        start_frame = max(1, int(round(float(clip.data.get("start", 0.0)) * fps_value)) + 1)
+        end_frame = self._clip_end_frame(clip, fps_value, start_frame)
+        clip.data["location_x"] = {
+            "Points": [
+                {"co": {"X": start_frame, "Y": value}, "interpolation": openshot.BEZIER},
+                {"co": {"X": end_frame, "Y": value}, "interpolation": openshot.BEZIER},
+            ]
+        }
+        clip.save()
+        window.refreshFrameSignal.emit()
 
     def _on_toggle_overlay(self, enabled):
         """Enable/disable the 9:16 guide overlay on the video preview."""
         preview = getattr(get_app().window, "videoPreview", None)
         if preview is not None and hasattr(preview, "set_verticalization_overlay"):
+            self._apply_output_ratio_to_preview()
             preview.set_verticalization_overlay(enabled)
