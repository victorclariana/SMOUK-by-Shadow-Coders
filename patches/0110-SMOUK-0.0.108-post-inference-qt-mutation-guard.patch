From 69e6f7c3e37a93c9abdd3b9a21b9e36a71f9e8a2 Mon Sep 17 00:00:00 2001 From: Shadow Coders <shadowcoders@users.noreply.github.com> Date: Fri, 25 Sep 2026 12:38:11 +0200 Subject: [PATCH] SMOUK 0.0.108 guard post-inference UI mutation  ---  src/windows/main_window.py     |  2 +-  src/windows/verticalization.py | 11 ++++++++++-  2 files changed, 11 insertions(+), 2 deletions(-)  diff --git a/src/windows/main_window.py b/src/windows/main_window.py index 6e5e25b2f..81e8f6cb4 100644 --- a/src/windows/main_window.py +++ b/src/windows/main_window.py @@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager    # SMOUK application version. Increment this patch number for every SMOUK UI  # or workflow change released from this codebase. -SMOUK_VERSION = "0.0.107" +SMOUK_VERSION = "0.0.108"  SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"  SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")   diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py index 9f5897d92..d0fd5c600 100644 --- a/src/windows/verticalization.py +++ b/src/windows/verticalization.py @@ -2224,6 +2224,7 @@ class VerticalizationDockContent(QWidget):          """Run conservative sentence correction before showing the editor."""          log.info("SMOUK transcription boundary: entering ParlaBE review setup")          paths = self._transcription_paths() +        log.info("SMOUK ParlaBE setup step=paths-ready worker=%s", paths["parlabe_worker"])          if not os.path.isfile(paths["parlabe_worker"]):              log.warning("ParlaBE correction worker is not available; showing raw transcription")              self._schedule_transcription_review(self._transcription_outputs, @@ -2231,13 +2232,20 @@ class VerticalizationDockContent(QWidget):              return          output_dir = paths["outputs"]          os.makedirs(output_dir, exist_ok=True) +        log.info("SMOUK ParlaBE setup step=output-directory-ready path=%s", output_dir)          token = uuid.uuid4().hex[:10]          self._transcription_review_input = os.path.join(output_dir, "review-%s-input.json" % token)          self._transcription_review_output = os.path.join(output_dir, "review-%s.json" % token) +        log.info("SMOUK ParlaBE setup step=review-paths-ready token=%s", token)          with open(self._transcription_review_input, "w", encoding="utf-8") as handle:              json.dump({"outputs": self._transcription_outputs}, handle,                        ensure_ascii=False, indent=2) -        self.transcription_results.setText(_("Correcting Catalan sentences with ParlaBE…")) +        log.info("SMOUK ParlaBE setup step=input-json-saved cues=%s", sum( +            len(item.get("cues", [])) for item in self._transcription_outputs)) +        # Do not change a Qt widget in this sensitive post-inference boundary. +        # The MSYS2 Qt runtime has repeatedly failed fast from Qt5Core.dll at +        # this exact kind of mutation. The worker and the persistent log still +        # provide progress; the next UI update happens after the review opens.          arguments = [paths["parlabe_worker"], "--input", self._transcription_review_input,                       "--output", self._transcription_review_output,                       "--model-dir", paths["models"]] @@ -2247,6 +2255,7 @@ class VerticalizationDockContent(QWidget):          correction_python = os.environ.get("SMOUK_PARLABE_PYTHON", "")          if not correction_python or not os.path.isfile(correction_python):              correction_python = shutil.which("python") or paths["python"] +        log.info("SMOUK ParlaBE setup step=child-command-ready")          log.info("SMOUK transcription boundary: starting ParlaBE child program=%s", correction_python)          self._start_transcription_process(correction_python, arguments, "correct")   --  2.55.0.windows.3 