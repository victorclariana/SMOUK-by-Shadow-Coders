diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index e7c61ea3c..ce10067c2 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -405,7 +405,45 @@ class VerticalizationDockContent(QWidget):
         self._start_next_transcription()
 
     @staticmethod
-    def _upsert_transcription_caption(clip, caption_text, language, model):
+    def _constant_effect_value(value):
+        return {"Points": [{
+            "co": {"X": 1.0, "Y": float(value)},
+            "handle_left": {"X": 0.5, "Y": 1.0},
+            "handle_right": {"X": 0.5, "Y": 0.0},
+            "handle_type": 0,
+            "interpolation": 0,
+        }]}
+
+    @classmethod
+    def _set_effect_color(cls, effect, key, red, green, blue, alpha=255):
+        effect[key] = {
+            "red": cls._constant_effect_value(red),
+            "green": cls._constant_effect_value(green),
+            "blue": cls._constant_effect_value(blue),
+            "alpha": cls._constant_effect_value(alpha),
+        }
+
+    def _style_transcription_caption(self, effect):
+        """Style Caption in the vertical guide, after horizontal clip transforms."""
+        guide_fraction = min(1.0, self._output_ratio() / (16.0 / 9.0))
+        horizontal_margin = (1.0 - guide_fraction * 0.86) / 2.0
+        effect["apply_before_clip"] = False
+        effect["caption_font"] = "Arial"
+        effect["left"] = self._constant_effect_value(horizontal_margin)
+        effect["right"] = self._constant_effect_value(horizontal_margin)
+        effect["top"] = self._constant_effect_value(0.69)
+        effect["bottom"] = self._constant_effect_value(0.14)
+        # Caption scales text from the complete 16:9 width. Compensate for the
+        # guide width so preview typography matches the final 1080px export.
+        effect["font_size"] = self._constant_effect_value(35.0 * guide_fraction)
+        effect["stroke_width"] = self._constant_effect_value(2.3 * guide_fraction)
+        effect["line_spacing"] = self._constant_effect_value(1.0)
+        effect["background_alpha"] = self._constant_effect_value(0.0)
+        self._set_effect_color(effect, "color", 255, 255, 255)
+        self._set_effect_color(effect, "stroke", 0, 0, 0)
+        effect["smouk_caption_style"] = "vertical-reference-v1"
+
+    def _upsert_transcription_caption(self, clip, caption_text, language, model):
         effects = clip.data.get("effects")
         if not isinstance(effects, list):
             effects = []
@@ -415,6 +453,7 @@ class VerticalizationDockContent(QWidget):
                 effect["caption_text"] = caption_text
                 effect["smouk_transcription_language"] = language
                 effect["smouk_transcription_model"] = model
+                self._style_transcription_caption(effect)
                 return
         caption = openshot.EffectInfo().CreateEffect("Caption")
         caption.Id(get_app().project.generate_id())
@@ -423,8 +462,24 @@ class VerticalizationDockContent(QWidget):
         effect["smouk_transcription"] = True
         effect["smouk_transcription_language"] = language
         effect["smouk_transcription_model"] = model
+        self._style_transcription_caption(effect)
         effects.append(effect)
 
+    def _restyle_transcription_captions(self):
+        """Update existing generated captions when the vertical profile changes."""
+        changed = False
+        for clip in self._timeline_video_clips():
+            clip_changed = False
+            for effect in clip.data.get("effects", []):
+                if isinstance(effect, dict) and effect.get("smouk_transcription"):
+                    before = json.dumps(effect, sort_keys=True)
+                    self._style_transcription_caption(effect)
+                    clip_changed = clip_changed or json.dumps(effect, sort_keys=True) != before
+            if clip_changed:
+                clip.save()
+                changed = True
+        return changed
+
     def _apply_transcription_outputs(self):
         _ = get_app()._tr
         clips = self._timeline_video_clips()
@@ -1016,6 +1071,10 @@ class VerticalizationDockContent(QWidget):
             window = get_app().window
             if window is not None:
                 window.refreshFrameSignal.emit()
+        if self._restyle_transcription_captions():
+            window = get_app().window
+            if window is not None:
+                window.refreshFrameSignal.emit()
         self._apply_output_ratio_to_preview()
 
     def _output_ratio(self):
