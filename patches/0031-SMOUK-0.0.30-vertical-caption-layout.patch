     def _on_verticalization_visibility_changed(self, visible):
         """Show the framing guide whenever the Verticalization dock is active."""
         if visible:
+            self._refresh_smouk_caption_style()
             if not self.verticalization_content.chk_overlay.isChecked():
                 self.verticalization_content.chk_overlay.setChecked(True)
         elif self.verticalization_content.chk_overlay.isChecked():
             self.verticalization_content.chk_overlay.setChecked(False)
 
+    def _refresh_smouk_caption_style(self):
+        """Migrate generated captions into the active vertical safe area."""
+        content = getattr(self, "verticalization_content", None)
+        if content and content._restyle_transcription_captions():
+            log.info("Updated existing SMOUK captions for the vertical safe area")
+            self.refreshFrameSignal.emit()
+
     def _anchor_and_show_properties_dock(self):
