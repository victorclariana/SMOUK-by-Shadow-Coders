+class SmoukClockOcrWorker(QtCore.QThread):
+    """Read clock digits off the Qt thread so media decoding cannot freeze SMOUK."""
+    stage = QtCore.pyqtSignal(str)
+    completed = QtCore.pyqtSignal(object)
+
+    def __init__(self, dock, files, probes):
+        super().__init__(dock)
+        self.dock = dock
+        self.files = files
+        self.probes = probes
+
+    def run(self):
+        try:
+            self.stage.emit("OCR: extrayendo el fotograma del reloj de CLEAN.MP4…")
+            clean = self.dock._ocr_clock_at(self.files["clean"], self.probes["clean"])
+            self.stage.emit("OCR: extrayendo el fotograma del reloj de PROGRAMA.MP4…")
+            program = self.dock._ocr_clock_at(self.files["program"], self.probes["program"])
+            self.completed.emit({"clean": clean, "program": program, "error": ""})
+        except Exception as exc:
+            log.exception("SMOUK clock OCR worker failed")
+            self.completed.emit({"clean": {}, "program": {}, "error": str(exc)})
+
+
