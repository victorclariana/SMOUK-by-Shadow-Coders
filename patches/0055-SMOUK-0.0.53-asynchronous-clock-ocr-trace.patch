+    def _on_title_clock_ocr_completed(self, result, payload):
+        """Continue in Qt after background FFmpeg and Tesseract clock OCR."""
+        _ = get_app()._tr
+        files, probes, timecodes = result["files"], result.get("clock_probes", {}), result["timecodes"]
+        clean_clock, program_clock = payload.get("clean", {}), payload.get("program", {})
+        if payload.get("error") or clean_clock.get("frames") is None or program_clock.get("frames") is None:
+            details = payload.get("error") or "CLEAN: %s; PROGRAMA: %s" % (
+                clean_clock.get("text", "—"), program_clock.get("text", "—"))
+            self.title_folder_results.setText(_("Clock OCR could not read both timecodes. Timeline was not changed. %s") % details)
+            self._title_progress(_("Clock OCR needs review; see the trace above."), 100, 100)
+            log.warning("SMOUK title pipeline: clock OCR unusable: %s", details)
+            return
+        self._title_progress(_("Clock OCR completed. Calculating the Clean Feed cut…"), 35, 100)
+        clean_origin = int(clean_clock["frames"] - float(probes["clean"]["seconds"]) * 25)
+        program_origin = int(program_clock["frames"] - float(probes["program"]["seconds"]) * 25)
+        clip_in, clip_out = timecodes["clip_in_frames"], timecodes["clip_out_frames"]
+        clean_start, clean_end = (clip_in - clean_origin) / 25.0, (clip_out - clean_origin) / 25.0
+        if clean_start < 0 or clean_end <= clean_start:
+            self.title_folder_results.setText(_("The JSON cut is outside CLEAN.MP4 after clock synchronisation. Timeline was not changed."))
+            return
+        self._title_progress(_("Importing the CLEAN Feed cut into Track 2…"), 45, 100)
+        log.info("SMOUK title pipeline: import clean %.3f to %.3f", clean_start, clean_end)
+        self._clear_generated_title_import()
+        self._add_clean_feed_clip(files["clean"], clean_start, clean_end, clean_origin)
+        get_app().window.refreshFilesSignal.emit()
+        get_app().window.refreshFrameSignal.emit()
+        self.title_analysis_data.update({"clean_clock_ocr": clean_clock, "program_clock_ocr": program_clock,
+                                         "clean_origin": clean_origin, "program_origin": program_origin})
+        self._title_progress(_("CLEAN Feed imported. OCR title scan begins in PROGRAMA.MP4…"), 55, 100)
+        program_start = (clip_in - program_origin) / 25.0
+        events, added = self._scan_and_place_chyrons(
+            files["program"], program_start, clean_end - clean_start, program_origin, clip_in)
+        self.title_analysis_data["chyrons"] = events
+        get_app().window.refreshFilesSignal.emit()
+        get_app().window.refreshFrameSignal.emit()
+        self.title_folder_results.setText(_("CLEAN.MP4 imported in Track 2 (%s–%s). Clock OCR: CLEAN %s / PROGRAMA %s. %s chyron detections were placed as editable clips in CHYRONS.") % (timecodes["clip_in"], timecodes["clip_out"], clean_clock.get("text", ""), program_clock.get("text", ""), added))
+        self._title_progress(_("Title import completed: %s editable chyron clips.") % added, 100, 100)
