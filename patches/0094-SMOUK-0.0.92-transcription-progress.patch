From 1995f5e5223ca79eeb7eb8e22fde5b8fdca95e9f Mon Sep 17 00:00:00 2001 From: Shadow Coders <shadowcoders@users.noreply.github.com> Date: Tue, 22 Sep 2026 18:43:18 +0200 Subject: [PATCH] SMOUK 0.0.92 show safe transcription progress  ---  src/windows/main_window.py     |  2 +-  src/windows/verticalization.py | 16 ++++++++++++++++  2 files changed, 17 insertions(+), 1 deletion(-)  diff --git a/src/windows/main_window.py b/src/windows/main_window.py index 4d7eec0c6..78405c870 100644 --- a/src/windows/main_window.py +++ b/src/windows/main_window.py @@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager    # SMOUK application version. Increment this patch number for every SMOUK UI  # or workflow change released from this codebase. -SMOUK_VERSION = "0.0.91" +SMOUK_VERSION = "0.0.92"  SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"  SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")   diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py index b69d1b450..b395eb733 100644 --- a/src/windows/verticalization.py +++ b/src/windows/verticalization.py @@ -434,6 +434,7 @@ class VerticalizationDockContent(QWidget):          self._transcription_last_progress = 0          self._transcription_last_partial = ""          self._transcription_completed_sources = 0 +        self._transcription_last_ui_update = 0.0          # Keep worker stdout off Qt's QProcess readyRead path.  On the          # packaged MSYS2 Qt build, bursts of progress signals can trigger a          # native Qt fail-fast while the local transcription worker is running. @@ -2001,6 +2002,7 @@ class VerticalizationDockContent(QWidget):          self._transcription_sources = sources          self._transcription_outputs = []          self._transcription_completed_sources = 0 +        self._transcription_last_ui_update = 0.0          self.transcription_progress.setRange(0, 100)          self.transcription_progress.setValue(0)          self.transcription_progress.setVisible(True) @@ -2150,6 +2152,20 @@ class VerticalizationDockContent(QWidget):              total = self._transcription_completed_sources + len(self._transcription_sources)              overall = int(round((self._transcription_completed_sources + local / 100.0) * 100 / total))              self._transcription_last_progress = overall +            # This handler is already running on the Qt GUI thread via the +            # polling timer.  Throttle widget updates to avoid the Qt5 crash +            # triggered by high-frequency progress signals while still giving +            # the user visible feedback during long GPU inference runs. +            now = time.monotonic() +            if (now - self._transcription_last_ui_update >= 0.5 or +                    overall >= 100): +                self.transcription_progress.setRange(0, 100) +                self.transcription_progress.setValue(overall) +                self.transcription_results.setText( +                    _("Transcribing source %s of %s in Catalan… %s%%") % +                    (self._transcription_completed_sources + 1, +                     len(self._transcription_sources), overall)) +                self._transcription_last_ui_update = now              log.info("SMOUK worker progress: %s%%", overall)        def _transcription_process_finished(self, exit_code, _exit_status): --  2.55.0.windows.3 