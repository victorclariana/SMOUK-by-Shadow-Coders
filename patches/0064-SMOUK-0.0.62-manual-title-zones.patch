+            refined_events.append(self._refine_chyron_boundaries(
+                program_path, event, cv2, numpy))
+        events = refined_events
         if len(events) > MAX_CHYRON_EVENTS:
             raise RuntimeError(
                 "Se han detectado %s candidatos; el límite seguro es %s. "
@@ -1052,6 +1131,8 @@ class VerticalizationDockContent(QWidget):
         os.makedirs(asset_dir, exist_ok=True)
         added = 0
         for index, event in enumerate(events, start=1):
+            self._title_progress("Creando títulos editables: %s de %s…" % (index, len(events)),
+                                 96 + int(3 * index / max(1, len(events))), 100)
             event["timecode_start"] = format_timecode(event["start_frame"])
             event["timecode_end"] = format_timecode(event["end_frame"])
             position = (event["start_frame"] - clip_in) / 25.0
