                     previous_distance = self._chyron_signature_distance(
                         state["previous"], signature, numpy)
@@ -993,11 +1066,11 @@ class VerticalizationDockContent(QWidget):
                     progress("OCR català %s: segon %s/%s…" %
                              (template, index + 1, sample_count),
                              55 + int(40 * index / sample_count), 100)
-                    reading = ocr_image(crop, psm=6, language="cat")
+                    reading = ocr_image(crop, psm=self._chyron_ocr_psm(template), language="cat")
                     if reading.get("reason"):
                         raise RuntimeError("Tesseract: " + reading["reason"])
                     state["last_ocr"] = signature
-                    text = self._normalise_chyron_text(reading.get("text"))
+                    text = self._normalise_chyron_text(reading.get("text"), template)
                     if not text:
                         if template in active:
                             candidate = active.pop(template)
@@ -1035,8 +1108,14 @@ class VerticalizationDockContent(QWidget):
                 process.kill()
             process.wait(timeout=10)
             process.stdout.close()
-        events = [self._refine_chyron_boundaries(program_path, event, cv2, numpy)
-                  for event in events]
+        total_events = len(events)
+        refined_events = []
+        for number, event in enumerate(events, start=1):
