         return max(candidates, default=(0, ""))[1]
 
     @staticmethod
@@ -818,22 +832,75 @@ class VerticalizationDockContent(QWidget):
 
     @staticmethod
     def _chyron_regions(width, height):
-        """Return the two TNM title-safe areas in a 16:9 programme frame.
+        """Return the TNM title zones from the editorial graphics manual.
 
-        TNM locations and dates live in the upper-left banner. Names, credits,
-        lower thirds, and the persistent headline live in the lower band. The
-        central picture is deliberately excluded: it contains interviews and
-        video content, not editorial titles.
+        Coordinates intentionally leave out the picture, the right-side TN
+        bug, the clock, and the central subtitle band.  Several graphic layers
+        may coexist, so each is scanned independently and becomes an editable
+        Timeline clip of its own.
         """
         return {
-            "location": (int(width * .02), int(height * .06),
-                         int(width * .56), int(height * .31)),
-            # Start at the upper edge of the graphic itself. Including the
-            # moving picture above it made a stable lower-third appear to
-            # change every second and delayed its OCR recognition.
-            "lower_third": (0, int(height * .78), width, int(height * .94)),
+            "live_location": (int(width * .03), int(height * .09),
+                              int(width * .31), int(height * .17)),
+            "location": (int(width * .03), int(height * .09),
+                         int(width * .35), int(height * .18)),
+            "presenter_left": (int(width * .10), int(height * .78),
+                               int(width * .45), int(height * .90)),
+            "presenter_right": (int(width * .55), int(height * .78),
+                                int(width * .86), int(height * .90)),
+            "name_cargo": (int(width * .03), int(height * .78),
+                           int(width * .62), int(height * .89)),
+            "credit": (int(width * .03), int(height * .80),
+                       int(width * .42), int(height * .89)),
+            "pretitle": (int(width * .25), int(height * .71),
+                         int(width * .72), int(height * .79)),
+            "story_headline": (0, int(height * .78),
+                               int(width * .90), int(height * .93)),
+            "persistent_headline": (int(width * .03), int(height * .88),
+                                    int(width * .60), int(height * .96)),
         }
 
+    @staticmethod
+    def _chyron_graphic_present(template, crop, cv2, numpy):
+        """Reject picture content and subtitles before invoking Catalan OCR."""
+        hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
+        value = hsv[:, :, 2]
+        saturation = hsv[:, :, 1]
+        orange = cv2.inRange(hsv, (2, 115, 115), (28, 255, 255))
+        white = cv2.inRange(hsv, (0, 0, 175), (180, 95, 255))
+        orange_ratio = float(numpy.count_nonzero(orange)) / orange.size
+        white_ratio = float(numpy.count_nonzero(white)) / white.size
+        dark_ratio = float(numpy.count_nonzero((value < 75) & (saturation < 120))) / value.size
+        if template == "story_headline":
+            # Orange is present in the TNM headline bar and presenter labels;
+            # ordinary subtitles never carry this graphic accent.
+            return orange_ratio >= .012
+        if template in ("presenter_left", "presenter_right"):
+            # A presenter's compact orange label never fills its whole zone;
+            # this prevents the full-width story banner becoming two names.
+            return .012 <= orange_ratio <= .65
+        if template == "live_location":
+            # DIRECTE combines an orange tab with the dark location pill.
+            return orange_ratio >= .006 and dark_ratio >= .20 and white_ratio >= .012
+        if template == "location":
+            # A regular location/date has the same dark pill but no DIRECTE
+            # tab, so it must not duplicate a live location.
+            return orange_ratio < .006 and dark_ratio >= .20 and white_ratio >= .012
+        if template in ("pretitle", "persistent_headline"):
+            return dark_ratio >= .20 and white_ratio >= .012
+        if template == "name_cargo":
+            # Interview/presenter identity has an orange accent or panel.
+            return .003 <= orange_ratio <= .40 and white_ratio >= .025
+        if template == "credit":
+            # Reporter credits sit in a dark band and do not use the orange
+            # identity panel, which stops a name/cargo clip being duplicated.
+            return orange_ratio < .003 and dark_ratio >= .28 and white_ratio >= .025
+        return False
+
+    @staticmethod
+    def _chyron_ocr_psm(template):
+        return 6 if template in ("name_cargo", "credit", "live_location", "location") else 7
+
     @staticmethod
     def _chyron_signature(crop, cv2):
         """Make a small mask of white/orange TNM title graphics, not video."""
