diff --git a/src/windows/export.py b/src/windows/export.py
index f889a9b62..5eba6566e 100644
--- a/src/windows/export.py
+++ b/src/windows/export.py
@@ -64,6 +64,8 @@ MAX_FPS_SPINBOX_VALUE = 2147483647
 # SMOUK output profiles. The editing project remains 16:9; these settings are
 # applied only to the isolated Timeline created by this export dialog.
 SMOUK_OUTPUT_PROFILES = {
+    "00608x1080p0025_09-16": (608, 1080, 25),
+    "00608x1080p0030_09-16": (608, 1080, 30),
     "01080x1350p0025_04-05": (1080, 1350, 25),
     "01080x1350p0030_04-05": (1080, 1350, 30),
     "01080x1920p0025_09-16": (1080, 1920, 25),
diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index bcba0fb08..c2691676a 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.68"
+SMOUK_VERSION = "0.0.69"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index 3d17fccab..36de077a7 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -94,6 +94,8 @@ LEGACY_CHYRON_TRACK_KEYS = {
 # OpenShot ships these profiles. SMOUK exposes the supported output choices
 # without changing the 16:9 editing project.
 OUTPUT_PROFILES = (
+    ("608 x 1080 (9:16) - 25 fps", "00608x1080p0025_09-16", 608.0 / 1080.0),
+    ("608 x 1080 (9:16) - 30 fps", "00608x1080p0030_09-16", 608.0 / 1080.0),
     ("1080 x 1350 (4:5) - 25 fps", "01080x1350p0025_04-05", 4.0 / 5.0),
     ("1080 x 1350 (4:5) - 30 fps", "01080x1350p0030_04-05", 4.0 / 5.0),
     ("1080 x 1920 (9:16) - 25 fps", "01080x1920p0025_09-16", 9.0 / 16.0),
@@ -2443,7 +2445,16 @@ class VerticalizationDockContent(QWidget):
         self.output_profile.setObjectName("verticalizationOutputProfile")
         for title, profile_id, _ratio in OUTPUT_PROFILES:
             self.output_profile.addItem(_(title), profile_id)
-        saved_profile = get_app().get_settings().get("smouk_vertical_output_profile")
+        settings = get_app().get_settings()
+        # 0.0.69 changes SMOUK's shipped default to the native-height preset.
+        # Migrate existing installs once so an unmodified old default does not
+        # hide the new choice on first launch after upgrading.
+        if not settings.get("smouk_vertical_output_profile_608_default_v1"):
+            settings.set("smouk_vertical_output_profile", "00608x1080p0025_09-16")
+            settings.set("smouk_vertical_output_profile_608_default_v1", True)
+            if hasattr(settings, "save"):
+                settings.save()
+        saved_profile = settings.get("smouk_vertical_output_profile")
         saved_index = self.output_profile.findData(saved_profile)
         if saved_index >= 0:
             self.output_profile.setCurrentIndex(saved_index)
