+                {"num": 30, "den": 1, "progressive": true, "dar": {"num": 76, "den": 135}, "notes": "", "sar": {"num": 1, "den": 1}}
+            ]
+        },
         { "width": 1080, "height": 1350, "notes": "HD Vertical", "fps": [
                 {"num": 24, "den": 1, "progressive": true, "dar": {"num": 4, "den": 5}, "notes": "", "sar": {"num": 1, "den": 1}},
                 {"num": 25, "den": 1, "progressive": true, "dar": {"num": 4, "den": 5}, "notes": "", "sar": {"num": 1, "den": 1}},
@@ -48,4 +53,4 @@
             ]
         }
     ]
-}
