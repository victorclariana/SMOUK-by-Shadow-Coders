+class SmoukTitlesMovWorker(QtCore.QThread):
+    """Sample PROGRAM and alpha MOVs sparsely, OCR stable title states off-UI."""
+    stage = QtCore.pyqtSignal(str)
+    completed = QtCore.pyqtSignal(object)
+
+    def __init__(self, dock, program_path, mov_folder):
+        super().__init__(dock)
+        self.dock = dock
+        self.program_path = program_path
+        self.mov_folder = mov_folder
+
+    def run(self):
+        try:
+            with PaddleOcrSession() as reader:
+                program = self.dock._scan_titles_mov_file(
+                    self.program_path, reader, alpha=False, stage=self.stage.emit)
+                assets = []
+                files = sorted(os.path.join(self.mov_folder, name)
+                               for name in os.listdir(self.mov_folder)
+                               if name.lower().endswith(".mov"))
+                if not files:
+                    raise RuntimeError("La carpeta no contiene ficheros .mov")
+                for index, path in enumerate(files, 1):
+                    self.stage.emit("OCR de MOV %d/%d: %s" %
+                                    (index, len(files), os.path.basename(path)))
+                    assets.extend(self.dock._scan_titles_mov_file(
+                        path, reader, alpha=True, stage=self.stage.emit))
+            self.completed.emit({"program": program, "assets": assets})
+        except Exception as exc:
+            log.exception("SMOUK TITLES MOV analysis failed")
+            self.completed.emit({"error": str(exc)})
+
+
