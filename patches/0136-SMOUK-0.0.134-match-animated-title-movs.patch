+        self.titles_mov_table_program.setHorizontalHeaderLabels(
+            [_("PROGRAM title"), _("Text"), _("In"), _("Out")])
+        self.titles_mov_table_assets = QtWidgets.QTableWidget(0, 3, self)
+        self.titles_mov_table_assets.setHorizontalHeaderLabels(
+            [_("MOV file"), _("Text"), _("In / Out")])
+        for table in (self.titles_mov_table_program, self.titles_mov_table_assets):
+            table.setObjectName("verticalizationTitlesMovTable")
+            table.setEditTriggers(QtWidgets.QAbstractItemView.NoEditTriggers)
+            table.setMaximumHeight(190)
+            table.horizontalHeader().setStretchLastSection(True)
+            table.setWordWrap(True)
+        section = self.sections["titles_mov"]
+        for widget in (self.titles_mov_program_label, self.btn_titles_mov_program,
+                       self.titles_mov_folder_label, self.btn_titles_mov_folder,
+                       self.btn_titles_mov_analyze, self.titles_mov_status,
+                       QLabel(_("PROGRAM titles"), self), self.titles_mov_table_program,
+                       QLabel(_("Title MOV contents"), self), self.titles_mov_table_assets):
+            section.add_widget(widget)
+        self.titles_mov_program_events = []
+        self.titles_mov_asset_events = []
+        self._titles_mov_worker = None
+
+    def _browse_titles_mov_program(self, _checked=False):
+        _ = get_app()._tr
+        path, _selected = QFileDialog.getOpenFileName(
+            self, _("Choose PROGRAM video"), self.titles_mov_program_path,
