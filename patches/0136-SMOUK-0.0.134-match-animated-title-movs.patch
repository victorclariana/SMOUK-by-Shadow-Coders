+        self.titles_mov_program_label.setWordWrap(True)
+        self.btn_titles_mov_program = QPushButton(_("Browse PROGRAM"), self)
+        self.btn_titles_mov_program.clicked.connect(self._browse_titles_mov_program)
+        self.titles_mov_folder_label = QLabel(_("No chyron folder selected."), self)
+        self.titles_mov_folder_label.setWordWrap(True)
+        self.btn_titles_mov_folder = QPushButton(_("Select Chyrons Folder"), self)
+        self.btn_titles_mov_folder.clicked.connect(self._browse_titles_mov_folder)
+        self.btn_titles_mov_analyze = QPushButton(_("Analyze and match titles"), self)
+        self.btn_titles_mov_analyze.clicked.connect(self._start_titles_mov_analysis)
+        self.btn_titles_mov_analyze.setEnabled(False)
+        self.titles_mov_status = QLabel(_("Select PROGRAM and the folder containing title MOVs."), self)
+        self.titles_mov_status.setWordWrap(True)
