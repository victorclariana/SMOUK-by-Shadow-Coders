+
+    def _browse_titles_mov_folder(self, _checked=False):
+        _ = get_app()._tr
+        folder = QFileDialog.getExistingDirectory(
+            self, _("Choose folder with title MOVs"), self.titles_mov_folder,
+            QFileDialog.ShowDirsOnly)
+        if folder:
+            self.titles_mov_folder = folder
+            self.titles_mov_folder_label.setText(folder)
+            self._sync_titles_mov_button()
+
+    def _sync_titles_mov_button(self):
+        self.btn_titles_mov_analyze.setEnabled(
+            bool(self.titles_mov_program_path and self.titles_mov_folder and
+                 not (self._titles_mov_worker and self._titles_mov_worker.isRunning())))
+
+    def _start_titles_mov_analysis(self, _checked=False):
+        if not self.titles_mov_program_path or not self.titles_mov_folder:
+            return
+        if self._titles_mov_worker and self._titles_mov_worker.isRunning():
+            return
+        self.titles_mov_status.setText("Preparando OCR local; todavía no se modifica el Timeline…")
+        self.titles_mov_table_program.setRowCount(0)
+        self.titles_mov_table_assets.setRowCount(0)
+        self.btn_titles_mov_analyze.setEnabled(False)
+        worker = SmoukTitlesMovWorker(self, self.titles_mov_program_path,
+                                      self.titles_mov_folder)
+        worker.stage.connect(self.titles_mov_status.setText)
+        worker.completed.connect(self._finish_titles_mov_analysis)
+        self._titles_mov_worker = worker
+        worker.start()
+
+    @staticmethod
+    def _titles_mov_normalize(text):
+        text = unicodedata.normalize("NFKD", str(text or "").casefold())
+        text = "".join(character for character in text
+                       if not unicodedata.combining(character))
+        text = re.sub(r"[^\wÀ-ÿ]+", " ", text, flags=re.UNICODE)
+        return " ".join(text.split())
+
+    def _scan_titles_mov_file(self, path, reader, alpha=False, stage=None):
+        """Find high-contrast title lines at 2 Hz and OCR only their tight crops."""
+        import cv2
+        import numpy
+        ffmpeg = self._ffmpeg_path()
+        if not ffmpeg:
+            raise RuntimeError("No se encuentra FFmpeg para analizar los títulos")
+        info, duration = inspect_media(path)
+        duration = float(duration or 0)
+        if duration <= 0:
+            raise RuntimeError("Duración no válida: %s" % os.path.basename(path))
+        # MOVs include short entrance/exit animations, so sample them more
+        # densely than PROGRAM while remaining far below frame-by-frame OCR.
+        fps = 4 if alpha else 2
+        # Keep native detail. Halving the supplied 1920x1080 media made fine
+        # white title text unreadable and degraded otherwise clean OCR results.
+        width = int(info.get("width") or 1920)
+        height = int(info.get("height") or 1080)
+        width += width % 2
+        height += height % 2
+        sample_count = max(1, int(math.ceil(duration * fps)))
+        pix_fmt = "rgba" if alpha else "rgb24"
+        command = [ffmpeg, "-v", "error", "-i", path, "-vf", "fps=%d" % fps,
+                   "-an", "-frames:v", str(sample_count), "-f", "rawvideo",
+                   "-pix_fmt", pix_fmt, "pipe:1"]
+        process = subprocess.Popen(command, stdout=subprocess.PIPE,
+                                   stderr=subprocess.DEVNULL)
+        channels = 4 if alpha else 3
+        frame_size = width * height * channels
+        active = {}
+        events = []
+
+        def flush(key, state):
+            if state["count"] >= 2 and state["text"]:
+                events.append({"path": path, "filename": os.path.basename(path),
+                               "text": state["text"], "lane": key[0],
+                               "in": state["start"], "out": state["end"],
+                               "confidence": state["confidence"],
+                               "media_duration": duration})
+
+        def title_lines(crop):
+            """Find dark-on-light or light-on-dark title text, grouped by line."""
+            gray = cv2.cvtColor(crop, cv2.COLOR_BGR2GRAY)
+            boxes = []
+            kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (17, 1))
+            for polarity, mask in (("light", cv2.threshold(
+                    gray, 185, 255, cv2.THRESH_BINARY)[1]),
+                    ("dark", cv2.threshold(
+                        gray, 105, 255, cv2.THRESH_BINARY_INV)[1])):
+                mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
+                count, _labels, stats, _centres = cv2.connectedComponentsWithStats(mask)
+                for x, y, box_width, box_height, area in stats[1:count]:
+                    density = area / float(max(1, box_width * box_height))
+                    if (box_width < 24 or box_height < 8 or box_height > 90 or
+                            box_width / float(max(1, box_height)) < 1.35 or area < 70 or
+                            (polarity == "dark" and box_width > 80 and density > .72)):
+                        continue
+                    candidate = (int(x), int(y), int(box_width), int(box_height))
+                    if not any(abs(candidate[0] - prior[0]) < 8 and
+                               abs(candidate[1] - prior[1]) < 8 and
+                               abs(candidate[2] - prior[2]) < 12 and
+                               abs(candidate[3] - prior[3]) < 12 for prior in boxes):
+                        boxes.append(candidate)
+            lines = []
+            for box in sorted(boxes, key=lambda item: (item[1], item[0])):
+                x, y, box_width, box_height = box
+                centre = y + box_height / 2.0
+                match = next((line for line in lines
+                              if abs(line["centre"] - centre) <=
+                              max(12, min(box_height, line["height"]) * .5) and
+                              x <= line["right"] + 110 and
+                              x + box_width >= line["left"] - 110), None)
+                if match is None:
+                    lines.append({"left": x, "top": y, "right": x + box_width,
+                                  "bottom": y + box_height, "centre": centre,
+                                  "height": box_height})
+                else:
+                    match["left"] = min(match["left"], x)
+                    match["top"] = min(match["top"], y)
+                    match["right"] = max(match["right"], x + box_width)
+                    match["bottom"] = max(match["bottom"], y + box_height)
+                    match["centre"] = (match["top"] + match["bottom"]) / 2.0
+                    match["height"] = match["bottom"] - match["top"]
+            results = []
+            for line in lines:
+                if line["right"] - line["left"] < 48:
+                    continue
+                pad_x, pad_y = 22, 14
+                x1 = max(0, line["left"] - pad_x)
+                y1 = max(0, line["top"] - pad_y)
+                x2 = min(crop.shape[1], line["right"] + pad_x)
+                y2 = min(crop.shape[0], line["bottom"] + pad_y)
+                results.append(crop[y1:y2, x1:x2])
+            return results
+
+        try:
+            for index in range(sample_count):
+                watchdog = threading.Timer(30, process.kill)
+                watchdog.daemon = True
+                watchdog.start()
+                try:
+                    raw = process.stdout.read(frame_size)
+                finally:
+                    watchdog.cancel()
+                if len(raw) != frame_size:
+                    break
+                frame = numpy.frombuffer(raw, dtype=numpy.uint8).reshape(
+                    (height, width, channels))
+                # FFmpeg's raw RGB(A) output must be converted to BGR for CV/OCR.
+                bgr = cv2.cvtColor(frame[:, :, :3], cv2.COLOR_RGB2BGR)
+                if alpha:
+                    alpha_plane = frame[:, :, 3]
+                    # qtrle alpha is preserved. Ignore fully transparent samples.
+                    if int(numpy.count_nonzero(alpha_plane > 16)) < 80:
+                        for key, state in list(active.items()):
+                            state["missed"] += 1
+                            if state["missed"] >= 2:
+                                flush(key, state)
+                                active.pop(key, None)
+                        continue
+                    # Decode the MOV at 4 Hz to locate animation changes, but
+                    # invoke OCR only twice a second; animated graphics need
+                    # more temporal precision than a PROGRAM while staying sparse.
+                    if index % 2:
+                        continue
+                if alpha:
+                    # These MOV compositions place their actual titles in the
+                    # phone-shaped vertical canvas; exclude repeated 3Cat
+                    # wallpaper lettering at the sides of that canvas.
+                    left, right = int(width * .30), int(width * .70)
+                    lane_regions = ((left, 0, right, int(height * .40)),
+                                    (left, int(height * .58), right, height))
+                else:
+                    # PROGRAM is 16:9: broadcast upper straps and lower thirds
+                    # can occupy different horizontal positions.
+                    lane_regions = ((0, 0, width, int(height * .42)),
+                                    (0, int(height * .62), width, height))
+                observed = {}
+                for lane, (x1, y1, x2, y2) in enumerate(lane_regions):
+                    lane_crop = bgr[y1:y2, x1:x2]
+                    for crop in title_lines(lane_crop):
+                        reading = reader.read(crop, mode="line")
+                        text = " ".join(str(reading.get("text", "")).split()).strip()
+                        normalized = self._titles_mov_normalize(text)
+                        confidence = float(reading.get("confidence", 0.0) or 0.0)
+                        letters = re.sub(r"[^A-Za-zÀ-ÖØ-öø-ÿ]", "", text)
+                        if len(letters) < 4 or confidence < .65:
+                            continue
+                        observed[(lane, normalized)] = (text, confidence)
+                sample_time = index / float(fps)
+                sample_period = (2.0 if alpha else 1.0) / fps
+                sample_end = min(duration, sample_time + sample_period)
+                for key, state in list(active.items()):
+                    if key in observed:
+                        text, confidence = observed[key]
+                        state["count"] += 1
+                        state["missed"] = 0
+                        state["end"] = sample_end
+                        if confidence > state["confidence"]:
+                            state.update({"text": text, "confidence": confidence})
+                    else:
+                        state["missed"] += 1
+                        if state["missed"] >= 2:
+                            flush(key, state)
+                            active.pop(key, None)
+                for key, (text, confidence) in observed.items():
+                    if key not in active:
+                        active[key] = {"text": text, "confidence": confidence,
+                                       "start": sample_time, "end": sample_end,
+                                       "count": 1, "missed": 0}
+                if stage and index % 4 == 0:
+                    stage("PP-OCRv5: %s, muestra %d/%d" %
+                          (os.path.basename(path), index + 1, sample_count))
+        finally:
+            if process.poll() is None:
+                process.kill()
+            process.wait(timeout=10)
+            process.stdout.close()
+        for key, state in active.items():
+            flush(key, state)
+        return sorted(events, key=lambda event: (event["in"], event["lane"]))
+
+    def _finish_titles_mov_analysis(self, payload):
+        _ = get_app()._tr
+        self._sync_titles_mov_button()
+        if payload.get("error"):
+            self.titles_mov_status.setText("Error de análisis: %s" % payload["error"])
+            return
+        program = payload.get("program") or []
+        assets = payload.get("assets") or []
+        self.titles_mov_program_events = program
+        self.titles_mov_asset_events = assets
+        self._fill_titles_mov_tables()
+        matches = []
+        seen_placements = set()
+        for event in program:
+            normalized = self._titles_mov_normalize(event["text"])
+            candidates = []
+            for asset in assets:
+                candidate = self._titles_mov_normalize(asset["text"])
+                score = SequenceMatcher(None, normalized, candidate).ratio()
+                if score >= .78:
+                    program_duration = max(.25, float(event["out"]) - float(event["in"]))
+                    asset_duration = max(.25, float(asset["out"]) - float(asset["in"]))
+                    duration_similarity = min(program_duration, asset_duration) / max(
+                        program_duration, asset_duration)
+                    candidates.append((score, duration_similarity, asset))
+            if candidates:
+                score, _duration_similarity, asset = max(
+                    candidates, key=lambda value: (value[0], value[1]))
+                placement_key = (asset["path"], round(float(event["in"]), 2),
+                                 round(float(event["out"]), 2))
+                if placement_key not in seen_placements:
+                    seen_placements.add(placement_key)
+                    matches.append((event, asset, score))
+        if not matches:
+            self.titles_mov_status.setText(
+                "OCR terminó: %d rótulos en PROGRAM y %d en MOV; no hubo coincidencias fiables. "
+                "El Timeline no se ha modificado." % (len(program), len(assets)))
+            return
+        try:
+            placed = self._place_titles_mov_matches(matches)
+        except Exception as exc:
+            log.exception("Could not apply TITLES AUTO matches")
+            self.titles_mov_status.setText(
+                "No se sustituyó la pista anterior: %s" % exc)
+            return
+        self.titles_mov_status.setText(
+            "OCR: %d rótulos PROGRAM, %d títulos MOV; %d coincidencias colocadas en TITLES AUTO."
+            % (len(program), len(assets), placed))
+
+    def _fill_titles_mov_tables(self):
+        for table, events, asset_table in (
+                (self.titles_mov_table_program, self.titles_mov_program_events, False),
+                (self.titles_mov_table_assets, self.titles_mov_asset_events, True)):
+            table.setRowCount(len(events))
+            for row, event in enumerate(events):
+                values = ([event["filename"], event["text"],
+                           "%s – %s" % (self._format_timecode(event["in"]),
+                                         self._format_timecode(event["out"]))]
+                          if asset_table else
+                          ["Title %d" % (row + 1), event["text"],
+                           self._format_timecode(event["in"]),
+                           self._format_timecode(event["out"])])
+                for column, value in enumerate(values):
+                    table.setItem(row, column, QtWidgets.QTableWidgetItem(str(value)))
+            table.resizeColumnsToContents()
+
+    def _place_titles_mov_matches(self, matches):
+        """Place each alpha MOV so its stable readable interval aligns to PROGRAM."""
+        window = get_app().window
+        for _program_event, asset, _score in matches:
+            if not os.path.isfile(asset.get("path", "")):
+                raise RuntimeError("Falta el título MOV: %s" % asset.get("filename", ""))
+            if float(asset.get("media_duration", 0.0) or 0.0) <= 0:
+                raise RuntimeError("El título MOV no tiene duración válida: %s" %
+                                   asset.get("filename", ""))
+        video_layers = []
+        for track in Track.filter():
+            for clip in Clip.filter(layer=track.data.get("number")):
+                if clip.data.get("reader", {}).get("has_video"):
+                    video_layers.append(int(track.data.get("number", 0)))
+                    break
+        low = max(video_layers or [0])
+        higher_generated = [int(track.data.get("number", 0)) for track in Track.filter()
+                            if track.data.get("smouk_subtitle_track") or
+                            track.data.get("smouk_chyron_track") or
+                            track.data.get("smouk_logo_track")]
+        high = min([number for number in higher_generated if number > low] or [low + 1000000])
+        layer = low + max(1, (high - low) // 2)
+        track = next((item for item in Track.filter()
+                      if item.data.get("smouk_titles_auto_track")), None)
+        if track is None:
+            track = Track()
+            track.data = {"number": layer, "y": 0, "label": "TITLES AUTO", "lock": False,
+                          "smouk_titles_auto_track": True}
+            track.save()
+        else:
+            layer = int(track.data.get("number", layer))
+        ensure = getattr(window, "ensure_tracks_for_layers", None)
+        if callable(ensure):
+            ensure([layer])
+        placed = 0
+        created = []
+        try:
+            for program_event, asset, _score in matches:
+                path = asset["path"]
+                file_obj = File.get(path=path)
+                if not file_obj:
+                    data, _duration = inspect_media(path)
+                    data["media_type"] = get_media_type(data)
+                    file_obj = File()
+                    file_obj.data = data
+                    file_obj.save()
+                clip_data = window.timeline.addClip(
+                    file_obj.id, QtCore.QPoint(0, 0), layer,
+                    ignore_refresh=False, call_manual_move=False)
+                if not clip_data:
+                    raise RuntimeError("OpenShot no pudo añadir %s" % os.path.basename(path))
+                clip = Clip.get(id=clip_data.get("id"))
+                if clip is None:
+                    raise RuntimeError("OpenShot no devolvió el clip añadido: %s" %
+                                       os.path.basename(path))
+                created.append(clip)
+                media_duration = float(file_obj.data.get("duration", 0.0) or 0.0)
+                if not media_duration:
+                    _info, media_duration = inspect_media(path)
+                    media_duration = float(media_duration or 0.0)
