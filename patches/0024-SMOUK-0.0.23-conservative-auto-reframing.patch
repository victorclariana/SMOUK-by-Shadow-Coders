+    def _conservative_reframe_points(self, samples, fps):
+        """Return a fixed framing unless a long, one-direction pan is clear.
+
+        Detection is deliberately advisory: the default is the median subject
+        position for the whole shot. A camera move must be substantial,
+        sustained and predominantly one-directional before SMOUK writes two
+        slow linear keyframes. This prevents a face detector swapping subjects
+        from producing left-right camera movement.
+        """
+        if not samples:
+            return []
+        first_frame, last_frame = samples[0][0], samples[-1][0]
+        values = [value for _frame, value in samples]
+        fixed = float(statistics.median(values))
+        fixed_points = [(first_frame, fixed), (last_frame, fixed)]
+        duration = (last_frame - first_frame) / max(float(fps), 1.0)
+        if len(values) < 7 or duration < 3.0:
+            return fixed_points
+
+        window_size = min(3, len(values))
+        initial = float(statistics.median(values[:window_size]))
+        final = float(statistics.median(values[-window_size:]))
+        net_shift = final - initial
+        minimum_shift = self._reframe_max_offset() * 0.35
+        if abs(net_shift) < minimum_shift:
+            return fixed_points
+
+        noise_floor = self._reframe_max_offset() * 0.04
+        deltas = [right - left for left, right in zip(values, values[1:])]
+        significant = [delta for delta in deltas if abs(delta) >= noise_floor]
+        if not significant:
+            return fixed_points
+        expected_direction = 1 if net_shift > 0 else -1
+        aligned = sum(1 for delta in significant if delta * expected_direction > 0)
+        total_variation = sum(abs(delta) for delta in deltas)
+        # A true pan has a clear direction. Reversals or oscillation are a
+        # sign of detector/tracker uncertainty, so keep a fixed median crop.
+        if (aligned / len(significant) < 0.75 or
+                total_variation > abs(net_shift) * 1.45):
+            return fixed_points
+
+        return [(first_frame, initial), (last_frame, final)]
+
