+        # SMOUK treats HDV-style 1440x1080 footage with non-square 4:3 pixels
+        # as 16:9 display media. Upgrade existing FIT clips as well as newly
+        # imported ones, while preserving any deliberate Crop/None/Stretch.
+        files = {
+            file_data.get("id"): file_data
+            for file_data in self._data.get("files", [])
+            if isinstance(file_data, dict)
+        }
+        for file_data in files.values():
+            normalize_anamorphic_1440x1080(file_data)
+        for clip in self._data.get("clips", []):
+            reader = clip.get("reader") or files.get(clip.get("file_id"), {})
+            if (normalize_anamorphic_1440x1080(reader) and
+                    clip.get("scale", openshot.SCALE_FIT) == openshot.SCALE_FIT):
+                clip["scale"] = openshot.SCALE_STRETCH
+                log.info("SMOUK: expanded anamorphic clip %s to 16:9", clip.get("id", ""))
+
         # Fix default project id (if found)
         if self._data.get("id") == "T0":
             self._data["id"] = self.generate_id()
