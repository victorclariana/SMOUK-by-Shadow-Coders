+def normalize_anamorphic_1440x1080(media: Any) -> bool:
+    """Recognize 1440x1080 widescreen media and normalize it to 16:9 SAR/DAR.
+
+    HD anamorphic material stores 4:3 pixels in a 1440x1080 raster. FFmpeg
+    normally reports SAR 4:3 and DAR 16:9, but accepting either signal keeps
+    imports robust across containers which omit one of them.
+    """
+    metadata = _as_mapping(media)
+    if not isinstance(metadata, MutableMapping):
+        return False
+    if (_rounded_int(metadata.get("width")) != 1440 or
+            _rounded_int(metadata.get("height")) != 1080):
+        return False
+
+    pixel_ratio = _as_mapping(metadata.get("pixel_ratio"))
+    display_ratio = _as_mapping(metadata.get("display_ratio"))
+    pixel_num = _to_positive_float(pixel_ratio.get("num"))
+    pixel_den = _to_positive_float(pixel_ratio.get("den"))
+    display_num = _to_positive_float(display_ratio.get("num"))
+    display_den = _to_positive_float(display_ratio.get("den"))
+    par = pixel_num / pixel_den if pixel_num and pixel_den else 1.0
+    dar = display_num / display_den if display_num and display_den else 4.0 / 3.0
+    if abs(par - (4.0 / 3.0)) > 0.02 and abs(dar - (16.0 / 9.0)) > 0.02:
+        return False
+
+    metadata["pixel_ratio"] = {"num": 4, "den": 3}
+    metadata["display_ratio"] = {"num": 16, "den": 9}
+    return True
+
+
