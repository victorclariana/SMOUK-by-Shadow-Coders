From d120932deb2e07ac4c3f3bf7fee10ae953f2de00 Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Sat, 12 Sep 2026 17:20:06 +0200
Subject: [PATCH] SMOUK-0.0.32-bold-generated-captions

---
 src/windows/main_window.py     | 2 +-
 src/windows/verticalization.py | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 18a877503..42b74bfdf 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.31"
+SMOUK_VERSION = "0.0.32"
 
 
 class MainWindow(updates.UpdateWatcher, QMainWindow):
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index b4201915d..b41c1aee5 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -428,7 +428,7 @@ class VerticalizationDockContent(QWidget):
         guide_fraction = min(1.0, self._output_ratio() / (16.0 / 9.0))
         horizontal_margin = (1.0 - guide_fraction * 0.86) / 2.0
         effect["apply_before_clip"] = False
-        effect["caption_font"] = "Arial"
+        effect["caption_font"] = "Arial Bold"
         effect["left"] = self._constant_effect_value(horizontal_margin)
         effect["right"] = self._constant_effect_value(horizontal_margin)
         effect["top"] = self._constant_effect_value(0.69)
-- 
