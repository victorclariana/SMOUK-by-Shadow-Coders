+    def read(self, image):
+        """Recognize one BGR crop and return text plus model confidence."""
+        try:
+            import cv2
+            encoded_ok, encoded = cv2.imencode(".png", image)
+            if not encoded_ok:
+                return {"text": "", "confidence": 0.0, "reason": "ppocr_encode_failed"}
+            request = {"image": base64.b64encode(encoded.tobytes()).decode("ascii")}
+            with self.lock:
+                self._start()
+                self.process.stdin.write(json.dumps(request) + "\n")
+                self.process.stdin.flush()
+                timeout = threading.Timer(90, self.close)
+                timeout.daemon = True
+                timeout.start()
+                try:
+                    response = self.process.stdout.readline()
+                finally:
+                    timeout.cancel()
+            if not response:
+                return {"text": "", "confidence": 0.0, "reason": "ppocr_no_response"}
+            payload = json.loads(response)
+            return {"text": str(payload.get("text", "")).strip(),
+                    "confidence": float(payload.get("confidence", 0.0) or 0.0),
+                    "reason": str(payload.get("reason", ""))}
+        except Exception as exc:
+            return {"text": "", "confidence": 0.0, "reason": "ppocr_failed: %s" % exc}
 
 
