+def _workspace_root():
+    """Return SMOUK's root from ``openshot-qt/src/classes``."""
+    return os.path.normpath(os.path.join(os.path.dirname(__file__), "..", "..", ".."))
+
+
+def _ppocr_paths():
+    root = _workspace_root()
+    runtime = os.path.join(root, ".third_party", "paddleocr", "venv", "Scripts", "python.exe")
+    helper = os.path.join(os.path.dirname(__file__), "smouk_ppocr.py")
+    model = os.path.join(root, ".third_party", "paddleocr", "cache", "official_models",
+                         "latin_PP-OCRv5_mobile_rec")
+    return root, runtime, helper, model
+
+
+def ppocr_runtime_status():
+    """Return whether the verified local PP-OCRv5 runtime is ready to use."""
+    _root, runtime, helper, model = _ppocr_paths()
+    if not os.path.isfile(runtime):
+        return {"available": False, "reason": "ppocr_runtime_not_installed"}
+    if not os.path.isfile(helper):
+        return {"available": False, "reason": "ppocr_helper_not_found"}
+    required = ("inference.json", "inference.pdiparams", "inference.yml")
+    if not all(os.path.isfile(os.path.join(model, name)) for name in required):
+        return {"available": False, "reason": "ppocr_latin_v5_model_not_installed"}
+    return {"available": True, "reason": "", "model": "latin_PP-OCRv5_mobile_rec"}
+
+
+class PaddleOcrSession:
+    """A persistent local PP-OCRv5 recognizer process for one title worker."""
+
+    def __init__(self):
+        self.process = None
+        self.lock = threading.Lock()
+
+    def __enter__(self):
+        status = ppocr_runtime_status()
+        if not status["available"]:
+            raise RuntimeError(status["reason"])
+        return self
+
+    def __exit__(self, _type, _value, _traceback):
+        self.close()
+
+    def _start(self):
+        if self.process and self.process.poll() is None:
+            return
+        root, runtime, helper, _model = _ppocr_paths()
+        environment = os.environ.copy()
+        environment["PADDLE_PDX_CACHE_HOME"] = os.path.join(root, ".third_party", "paddleocr", "cache")
+        environment["PADDLE_PDX_MODEL_SOURCE"] = "bos"
+        environment["PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK"] = "True"
+        self.process = subprocess.Popen(
+            [runtime, helper], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL, text=True, encoding="utf-8", errors="replace",
+            cwd=root, env=environment)
+
+    def close(self):
+        process, self.process = self.process, None
+        if process is None:
+            return
+        try:
+            if process.stdin:
+                process.stdin.close()
+            process.terminate()
+            process.wait(timeout=5)
+        except Exception:
+            try:
+                process.kill()
+            except Exception:
+                pass
 
