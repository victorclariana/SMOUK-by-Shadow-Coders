+    @title_pipeline_guard
+    def _run_source_import(self, result):
+        """OCR only CLEAN's clock, then import the JSON-defined CLEAN interval."""
+        probe = (result.get("clock_probes") or {}).get("clean") or {}
+        if not probe.get("candidate"):
+            self._finish_source_pipeline(
+                "No se ha detectado el reloj de CLEAN.MP4; Timeline sin cambios.")
+            return
+        self._source_pending_result = result
+        self._source_progress("OCR de reloj: preparando CLEAN.MP4…", 0, 100)
+        worker = SmoukClockOcrWorker(self, result["files"], {"clean": probe}, ("clean",))
+        worker.stage.connect(self._on_source_worker_stage)
+        worker.completed.connect(self._on_source_clock_ocr_completed)
+        self._start_title_worker(worker)
+
+    @title_pipeline_guard
+    def _on_source_worker_stage(self, message, value=None, maximum=None):
+        self._source_progress(message, value, maximum)
+
+    @title_pipeline_guard
+    def _on_source_clock_ocr_completed(self, payload):
+        """Import the CLEAN clip after its visual-clock calibration succeeds."""
+        result = self._source_pending_result
+        files, probes, timecodes = result["files"], result.get("clock_probes", {}), result["timecodes"]
+        clean_clock = payload.get("clean", {})
+        if payload.get("error") or clean_clock.get("frames") is None:
+            details = payload.get("error") or clean_clock.get("reason") or clean_clock.get("text") or "sin lectura"
+            self._finish_source_pipeline("No se ha podido leer el reloj de CLEAN.MP4: %s" % details)
+            return
+        clean_origin = int(clean_clock["frames"] - clean_clock.get(
+            "source_frame", round(float(probes["clean"]["seconds"]) * 25)) -
+            clean_clock.get("presentation_phase_frames", 0))
+        clip_in, clip_out = timecodes["clip_in_frames"], timecodes["clip_out_frames"]
+        clean_start, clean_end = (clip_in - clean_origin) / 25.0, (clip_out - clean_origin) / 25.0
+        clean_duration = float(files.get("clean_info", {}).get("duration", 0) or 0)
+        if clean_start < 0 or clean_end <= clean_start or (clean_duration > 0 and clean_end > clean_duration):
+            self._finish_source_pipeline(
+                "El corte calculado queda fuera de CLEAN.MP4; revisar OCR. Timeline sin cambios.")
+            return
+        self._source_progress("Importando el corte de CLEAN.MP4 en Track 2…", 70, 100)
+        self._clear_generated_clean_feed_import()
+        # Chyrons from a prior folder cannot stay synchronised with a new CLEAN
+        # source. They are recreated only by the explicit Titles action.
+        self._clear_generated_chyrons()
+        self._add_clean_feed_clip(files["clean"], clean_start, clean_end, clean_origin)
+        get_app().window.refreshFilesSignal.emit()
+        get_app().window.refreshFrameSignal.emit()
+        result.update({"clean_clock_ocr": clean_clock, "clean_origin": clean_origin,
+                       "clean_start": clean_start, "clean_end": clean_end,
+                       "clean_duration": clean_end - clean_start, "chyrons": []})
+        self.title_analysis_data = result
+        self.source_clock_progress.setValue(100)
+        self._finish_source_pipeline(
+            "CLEAN.MP4 importado en Track 2. Puedes detectar los chyrons en Titles.")
+
+    @title_pipeline_guard
+    def _on_detect_titles(self, _checked=False):
+        """Read PROGRAM only and create chyrons over the prepared CLEAN clip."""
+        if self._source_busy or self._title_busy:
+            return
+        result = self.title_analysis_data or {}
+        if result.get("clean_origin") is None:
+            self._title_progress("Selecciona primero una carpeta y prepara CLEAN.MP4 en Source Video.")
