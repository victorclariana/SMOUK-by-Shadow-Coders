From adb1c84731976e4a8ccaac216469065c9139f17a Mon Sep 17 00:00:00 2001 From: Shadow Coders <shadowcoders@users.noreply.github.com> Date: Tue, 22 Sep 2026 19:45:41 +0200 Subject: [PATCH] SMOUK 0.0.94 transcribe timeline clip ranges  ---  src/windows/main_window.py     |  2 +-  src/windows/verticalization.py | 51 ++++++++++++++++++++++++++++++----  2 files changed, 46 insertions(+), 7 deletions(-)  diff --git a/src/windows/main_window.py b/src/windows/main_window.py index b6106529b..6e5ef880b 100644 --- a/src/windows/main_window.py +++ b/src/windows/main_window.py @@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager    # SMOUK application version. Increment this patch number for every SMOUK UI  # or workflow change released from this codebase. -SMOUK_VERSION = "0.0.93" +SMOUK_VERSION = "0.0.94"  SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"  SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")   diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py index 0b47e05cc..b4bcbc22b 100644 --- a/src/windows/verticalization.py +++ b/src/windows/verticalization.py @@ -1990,8 +1990,25 @@ class VerticalizationDockContent(QWidget):              if reader.get("has_audio") is False:                  continue              path = str(reader.get("path", "")) -            if path and not any(self._same_media_path(path, existing) for existing in sources): -                sources.append(path) +            if not path: +                continue +            try: +                source_start = max(0.0, float(clip.data.get("start", 0.0))) +                source_end = float(clip.data.get("end", source_start)) +                timeline_position = float(clip.data.get("position", 0.0) or 0.0) +            except (TypeError, ValueError): +                continue +            if source_end <= source_start: +                continue +            descriptor = {"path": path, "source_start": source_start, +                          "source_end": source_end, +                          "timeline_position": timeline_position} +            if not any(self._same_media_path(path, item["path"]) and +                       abs(source_start - item["source_start"]) < 0.001 and +                       abs(source_end - item["source_end"]) < 0.001 and +                       abs(timeline_position - item["timeline_position"]) < 0.001 +                       for item in sources): +                sources.append(descriptor)          if not sources:              QMessageBox.warning(self, _("Catalan Transcription"),                                  _("Add one or more videos with audio to the timeline first.")) @@ -2092,18 +2109,24 @@ class VerticalizationDockContent(QWidget):              return          paths = self._transcription_paths()          source = self._transcription_sources[0] -        digest = hashlib.sha1(os.path.normcase(os.path.abspath(source)).encode( +        source_path = source["path"] +        digest_key = "%s|%.6f|%.6f|%.6f" % ( +            os.path.normcase(os.path.abspath(source_path)), source["source_start"], +            source["source_end"], source["timeline_position"]) +        digest = hashlib.sha1(digest_key.encode(              "utf-8", errors="surrogatepass")).hexdigest()[:16]          output = os.path.join(paths["outputs"], digest + ".json")          self._current_transcription_output = output -        self.transcription_progress.setRange(0, 100) +        self.transcription_progress.setRange(0, 0)          self.transcription_results.setText(              _("Transcribing source %s of %s in Catalan…") %              (self._transcription_completed_sources + 1,               self._transcription_completed_sources + len(self._transcription_sources)))          arguments = [ -            paths["worker"], "--input", source, "--output", output, +            paths["worker"], "--input", source_path, "--output", output,              "--model-dir", paths["models"], +            "--start", "%.6f" % source["source_start"], +            "--duration", "%.6f" % (source["source_end"] - source["source_start"]),          ]          ffmpeg_path = self._ffmpeg_path()          if ffmpeg_path: @@ -2178,7 +2201,15 @@ class VerticalizationDockContent(QWidget):            try:              with open(self._current_transcription_output, "r", encoding="utf-8") as handle: -                self._transcription_outputs.append(json.load(handle)) +                result = json.load(handle) +            source = self._transcription_sources[0] +            offset = float(source["source_start"]) +            for cue in result.get("cues", []): +                cue["start"] = float(cue.get("start", 0.0)) + offset +                cue["end"] = float(cue.get("end", cue["start"])) + offset +            result["source_start"] = source["source_start"] +            result["source_end"] = source["source_end"] +            self._transcription_outputs.append(result)          except (OSError, ValueError) as ex:              log.warning("Could not load SMOUK transcription result: %s", ex)              self._finish_transcription_ui(_("The transcription result could not be loaded.")) @@ -2390,6 +2421,14 @@ class VerticalizationDockContent(QWidget):                      if self._same_media_path(                          str(clip.data.get("reader", {}).get("path", "")), source)                  ] +                if result.get("source_start") is not None: +                    source_start = float(result.get("source_start", 0.0)) +                    source_end = float(result.get("source_end", source_start)) +                    source_clips = [ +                        clip for clip in source_clips +                        if abs(float(clip.data.get("start", 0.0)) - source_start) < 0.04 and +                        abs(float(clip.data.get("end", 0.0)) - source_end) < 0.04 +                    ]                  for cue_index, cue in enumerate(cues, start=1):                      segments = [(clip, self._subtitle_clip_segments(clip, cue))                                  for clip in source_clips] --  2.55.0.windows.3 