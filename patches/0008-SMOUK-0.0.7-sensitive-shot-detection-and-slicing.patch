@@ -219,7 +227,7 @@ class VerticalizationDockContent(QWidget):
         try:
             result = subprocess.run(  # nosec B603 -- fixed executable and argv list
                 [ffmpeg, "-hide_banner", "-i", source_path,
-                 "-vf", "select='gt(scene,0.30)',showinfo",
