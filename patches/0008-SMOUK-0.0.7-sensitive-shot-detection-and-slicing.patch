                  "-an", "-f", "null", "-"],
                 stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                 text=True, check=False, timeout=600)
@@ -240,14 +248,52 @@ class VerticalizationDockContent(QWidget):
         self.detected_cuts = [float(value) for value in re.findall(
             r"pts_time:([0-9]+(?:\.[0-9]+)?)", result.stderr)]
         if not self.detected_cuts:
-            self.shot_results.setText(_("No cuts detected at sensitivity 0.30."))
+            self.btn_slice_shots.setEnabled(False)
+            self.shot_results.setText(_("No cuts detected at sensitivity 0.20."))
             return
 
         timecodes = ", ".join(self._format_timecode(value)
                               for value in self.detected_cuts)
         self.shot_results.setText(
-            _("%s cuts detected (sensitivity 0.30): %s") %
+            _("%s cuts detected (sensitivity 0.20): %s") %
             (len(self.detected_cuts), timecodes))
+        self.btn_slice_shots.setEnabled(True)
+
+    def _on_slice_detected_shots(self):
+        """Slice the selected instance of the analysed file, keeping both sides."""
+        _ = get_app()._tr
+        window = get_app().window
+        clip = self._selected_clip()
+        if window is None or clip is None:
+            QMessageBox.warning(self, _("Shot Detection"),
+                                _("Select one matching clip in the timeline first."))
+            return
+
+        source_path = self.shot_source_path.text().strip()
+        clip_path = str(clip.data.get("reader", {}).get("path", ""))
+        if os.path.normcase(os.path.abspath(source_path)) != os.path.normcase(os.path.abspath(clip_path)):
+            QMessageBox.warning(self, _("Shot Detection"),
+                                _("The selected timeline clip is not the analysed video."))
+            return
+
+        clip_start = float(clip.data.get("start", 0.0))
+        clip_end = float(clip.data.get("end", clip_start))
+        clip_position = float(clip.data.get("position", 0.0))
+        cuts = [cut for cut in self.detected_cuts if clip_start < cut < clip_end]
+        if not cuts:
+            QMessageBox.information(self, _("Shot Detection"),
+                                    _("No detected cuts fall inside this clip."))
+            return
+
+        # Slice from right to left: the original clip stays the left segment,
+        # so each earlier cut can safely target its same ID.
+        for cut in sorted(cuts, reverse=True):
+            timeline_position = clip_position + (cut - clip_start)
+            window.timeline.Slice_Triggered(
+                MenuSlice.KEEP_BOTH, [clip.id], [], timeline_position)
+
+        self.shot_results.setText(
+            _("%s cuts inserted into the selected timeline clip.") % len(cuts))
 
     def _build_controls(self, layout, _):
         """Build the verticalization control area (project output + guide)."""
