@@ -34,6 +34,7 @@ import openshot
 from classes.app import get_app
 from classes.logger import log
 from classes.query import Clip
+from windows.views.timeline_backend.enums import MenuSlice
 
 
 VERTICALIZATION_DOCK_MIN_WIDTH = 320
@@ -175,6 +176,13 @@ class VerticalizationDockContent(QWidget):
         self.btn_detect_shots.clicked.connect(self._on_detect_shots)
         self.sections["shot_detection"].add_widget(self.btn_detect_shots)
 
