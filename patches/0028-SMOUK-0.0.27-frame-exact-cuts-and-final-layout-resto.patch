+    def test_slice_keep_both_has_contiguous_timeline_and_source_frames(self):
+        """A 25 fps scene boundary must neither repeat nor drop a frame."""
+        helper = self.make_slice_helper()
+        clip_data = {
+            "id": "C1", "position": 0.0, "layer": 1,
+            "start": 0.0, "end": 60.0, "duration": 60.0,
+        }
+        left_clip = types.SimpleNamespace(
+            id="C1", type="update", key=["clips", {"id": "C1"}],
+            data=copy.deepcopy(clip_data),
+        )
+        right_clip = types.SimpleNamespace(
+            id="C1", type="update", key=["clips", {"id": "C1"}],
+            data=copy.deepcopy(clip_data),
+        )
+        saved_right = []
+        right_clip.save = lambda: saved_right.append(copy.deepcopy(right_clip.data))
+        app = types.SimpleNamespace(
+            project=types.SimpleNamespace(
+                get=lambda key: {"fps": {"num": 25, "den": 1}, "layers": []}[key]
+            ),
+            updates=types.SimpleNamespace(transaction_id=None),
+            window=types.SimpleNamespace(
+                IgnoreUpdates=types.SimpleNamespace(emit=lambda *_args, **_kwargs: None)
+            ),
+        )
+
+        with ExitStack() as stack:
+            stack.enter_context(patch.object(self.timeline_module, "get_app", return_value=app))
+            stack.enter_context(patch.object(
+                self.timeline_module.Clip, "get", side_effect=[left_clip, right_clip]))
+            stack.enter_context(patch.object(self.timeline_module.Transition, "get", return_value=None))
+            self.timeline_module.TimelineView.Slice_Triggered(
+                helper, self.timeline_module.MenuSlice.KEEP_BOTH,
+                ["C1"], [], 34.28, snap_to_project_frames=False)
+
+        left = helper.updated_clips[0]
+        right = saved_right[0]
+        self.assertAlmostEqual(left["end"], 34.28)
+        self.assertAlmostEqual(right["start"], 34.28)
+        self.assertAlmostEqual(right["position"], 34.28)
+        # libopenshot's actual conversion in Timeline.cpp: left end is
+        # round((position + duration) * fps), right begins at round(position * fps) + 1.
+        left_last_timeline_frame = round(
+            (left["position"] + left["duration"]) * 25)
+        right_first_timeline_frame = round(right["position"] * 25) + 1
+        left_last_source_frame = round(left["end"] * 25)
+        right_first_source_frame = round(right["start"] * 25) + 1
+        self.assertEqual(right_first_timeline_frame, left_last_timeline_frame + 1)
+        self.assertEqual(right_first_source_frame, left_last_source_frame + 1)
+
