From 1ad0e453ca975ced8e82744019f00fffc90628e1 Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Mon, 21 Sep 2026 17:05:33 +0200
Subject: [PATCH] SMOUK 0.0.79 separate title subtitle bands

---
 src/windows/main_window.py     |  2 +-
 src/windows/verticalization.py | 17 +++++++++++------
 2 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 34ffe4090..12b7cc80e 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.78"
+SMOUK_VERSION = "0.0.79"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index d0f1ad17d..76a8b4e42 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -77,7 +77,7 @@ VERTICAL_TITLE_SAFE_MARGIN = .05
 # These are editorial lanes inside the safe crop.  They let several concurrent
 # graphics remain independently editable while preserving a clear gap between
 # location, identification, pretitle, persistent label, and main headline.
-VERTICAL_TITLE_SLOT_RATIOS = (.14, .28, .42, .56, .65, .74, .85)
+VERTICAL_TITLE_SLOT_RATIOS = (.14, .25, .37, .44, .49, .60, .75)
 CHYRON_VERTICAL_SLOT_PREFERENCES = {
     "live_location": (0, 1, 2, 3, 4, 5, 6),
     "location": (0, 1, 2, 3, 4, 5, 6),
@@ -85,10 +85,15 @@ CHYRON_VERTICAL_SLOT_PREFERENCES = {
     "presenter_right": (4, 3, 2, 5, 1, 0, 6),
     "name_cargo": (3, 2, 4, 1, 5, 0, 6),
     "credit": (3, 2, 4, 1, 5, 0, 6),
-    "pretitle": (4, 3, 5, 2, 1, 0, 6),
-    "persistent_headline": (5, 4, 3, 2, 1, 0, 6),
+    "pretitle": (5, 6, 4, 3, 2, 1, 0),
+    "persistent_headline": (5, 6, 4, 3, 2, 1, 0),
     "story_headline": (6, 5, 4, 3, 2, 1, 0),
 }
+# The transcript occupies the dedicated middle band shown in the SMOUK guide.
+# These values are shared by editable SVG subtitles and legacy Caption effects.
+VERTICAL_SUBTITLE_CENTER = .50
+VERTICAL_CAPTION_TOP = .44
+VERTICAL_CAPTION_BOTTOM = .43
 # A recognition score describes text quality.  It must survive duration
 # refinement unchanged so a visually well-bounded but unreadable banner never
 # becomes an apparently reliable chyron.
@@ -2129,8 +2134,8 @@ class VerticalizationDockContent(QWidget):
         effect["caption_font"] = "Arial Black"
         effect["left"] = self._constant_effect_value(horizontal_margin)
         effect["right"] = self._constant_effect_value(horizontal_margin)
-        effect["top"] = self._constant_effect_value(0.69)
-        effect["bottom"] = self._constant_effect_value(0.14)
+        effect["top"] = self._constant_effect_value(VERTICAL_CAPTION_TOP)
+        effect["bottom"] = self._constant_effect_value(VERTICAL_CAPTION_BOTTOM)
         # Caption scales text from the complete 16:9 width. Compensate for the
         # guide width so preview typography matches the final 1080px export.
         effect["font_size"] = self._constant_effect_value(39.0 * guide_fraction)
@@ -2228,7 +2233,7 @@ class VerticalizationDockContent(QWidget):
         font_size = min(104.0 * guide_fraction,
                         guide_width / max(max(len(line) for line in lines) * 0.65, 1.0))
         line_height = font_size * 1.15
-        center_y = float(height) * 0.82
+        center_y = float(height) * VERTICAL_SUBTITLE_CENTER
         first_y = center_y - (len(lines) - 1) * line_height / 2.0
         tspans = []
         for index, line in enumerate(lines):
-- 
2.55.0.windows.3

