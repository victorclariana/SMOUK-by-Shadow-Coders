+    @staticmethod
+    def _yolo_model_path():
+        return os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
+                            "models", "yolo11n.onnx")
+
+    # COCO labels emitted by YOLO11n.  A small semantic preference prevents a
+    # large but unimportant background object from winning over the action.
+    _YOLO_CLASSES = (
+        "person", "bicycle", "car", "motorcycle", "airplane", "bus", "train", "truck", "boat",
+        "traffic light", "fire hydrant", "stop sign", "parking meter", "bench", "bird", "cat", "dog",
+        "horse", "sheep", "cow", "elephant", "bear", "zebra", "giraffe", "backpack", "umbrella",
+        "handbag", "tie", "suitcase", "frisbee", "skis", "snowboard", "sports ball", "kite",
+        "baseball bat", "baseball glove", "skateboard", "surfboard", "tennis racket", "bottle", "wine glass",
+        "cup", "fork", "knife", "spoon", "bowl", "banana", "apple", "sandwich", "orange", "broccoli",
+        "carrot", "hot dog", "pizza", "donut", "cake", "chair", "couch", "potted plant", "bed",
+        "dining table", "toilet", "tv", "laptop", "mouse", "remote", "keyboard", "cell phone", "microwave",
+        "oven", "toaster", "sink", "refrigerator", "book", "clock", "vase", "scissors", "teddy bear",
+        "hair drier", "toothbrush",
+    )
+    _YOLO_PRIORITY = {
+        "person": 1.0, "bicycle": 0.90, "car": 0.90, "motorcycle": 0.90, "bus": 0.85,
+        "train": 0.85, "truck": 0.85, "boat": 0.85, "dog": 0.85, "cat": 0.85,
+        "horse": 0.85, "sports ball": 0.80, "bird": 0.75, "tv": 0.70,
+    }
+
+    @staticmethod
+    def _create_yolo_detector(cv2):
+        """Load the compact ONNX object detector through OpenCV DNN only."""
+        model_path = Verticalization._yolo_model_path()
+        if not os.path.isfile(model_path):
+            return None
+        try:
+            return cv2.dnn.readNetFromONNX(model_path)
+        except cv2.error as ex:
+            log.warning("SMOUK YOLO model could not be loaded: %s", ex)
+            return None
+
+    def _yolo_subject_center(self, frame, detector, cv2):
+        """Return the most relevant COCO object's horizontal centre, if any."""
+        if detector is None:
+            return None
+        height, width = frame.shape[:2]
+        try:
+            blob = cv2.dnn.blobFromImage(frame, 1.0 / 255.0, (640, 640),
+                                         swapRB=True, crop=False)
+            detector.setInput(blob)
+            output = detector.forward()
+            # Standard YOLO11 detection ONNX output is [1, 84, 8400].
+            rows = output[0].T if len(output.shape) == 3 and output.shape[1] < output.shape[2] else output[0]
+            boxes, confidences, class_ids = [], [], []
+            scale_x = float(width) / 640.0
+            scale_y = float(height) / 640.0
+            for row in rows:
+                if len(row) < 5:
+                    continue
+                scores = row[4:]
+                class_id = int(scores.argmax())
+                confidence = float(scores[class_id])
+                if confidence < 0.35:
+                    continue
+                cx, cy, box_w, box_h = [float(value) for value in row[:4]]
+                x = int(round((cx - box_w / 2.0) * scale_x))
+                y = int(round((cy - box_h / 2.0) * scale_y))
+                boxes.append([x, y, int(round(box_w * scale_x)), int(round(box_h * scale_y))])
+                confidences.append(confidence)
+                class_ids.append(class_id)
+            if not boxes:
+                return None
+            indexes = cv2.dnn.NMSBoxes(boxes, confidences, 0.35, 0.45)
+            best = None
+            for index in indexes:
+                index = int(index[0] if hasattr(index, "__len__") else index)
+                x, _y, box_w, box_h = boxes[index]
+                class_name = (self._YOLO_CLASSES[class_ids[index]]
+                              if class_ids[index] < len(self._YOLO_CLASSES) else "object")
+                # Confidence is most important, then semantic relevance and
+                # visible size. The capped area avoids huge backgrounds winning.
+                area = min(1.0, (box_w * box_h) / float(width * height))
+                score = confidences[index] * (0.55 + 0.45 * self._YOLO_PRIORITY.get(class_name, 0.55))
+                score *= 0.65 + 0.35 * area
+                candidate = (score, max(0.0, min(1.0, (x + box_w / 2.0) / float(width))))
+                if best is None or candidate[0] > best[0]:
+                    best = candidate
