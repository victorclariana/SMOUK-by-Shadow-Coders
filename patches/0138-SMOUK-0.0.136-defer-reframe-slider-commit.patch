diff --git a/src/tests/test_smouk_reframe_slider.py b/src/tests/test_smouk_reframe_slider.py
new file mode 100644
index 000000000..964b133e3
--- /dev/null
+++ b/src/tests/test_smouk_reframe_slider.py
@@ -0,0 +1,116 @@
+"""Regression tests for safe interaction with the vertical framing slider."""
+
+from types import SimpleNamespace
+from unittest import TestCase
+from unittest.mock import Mock, patch
+
+from qt_api import QApplication, Qt, QtCore, QSlider
+from windows.verticalization import VerticalizationDockContent
+
+
+class _Timer:
+    def __init__(self):
+        self.active = False
+        self.starts = 0
+
+    def isActive(self):
+        return self.active
+
+    def start(self):
+        self.active = True
+        self.starts += 1
+
+
+class ReframeSliderTests(TestCase):
+    def make_dock_stub(self, dragging):
+        dock = SimpleNamespace(
+            _reframe_dragging=dragging,
+            _reframe_pending_value=None,
+            _reframe_commit_timer=_Timer(),
+            reframe_slider=SimpleNamespace(value=lambda: 425),
+            _sync_reframe_slider=Mock(),
+            _apply_reframe_slider_value=Mock(),
+            reframe_results=SimpleNamespace(setText=Mock()),
+        )
+        dock._schedule_reframe_commit = Mock(
+            side_effect=dock._reframe_commit_timer.start)
+        return dock
+
+    def test_drag_only_records_latest_value_until_release(self):
+        dock = self.make_dock_stub(dragging=True)
+
+        VerticalizationDockContent._on_reframe_changed(dock)
+
+        self.assertEqual(dock._reframe_pending_value, 425)
+        self.assertEqual(dock._reframe_commit_timer.starts, 0)
+        dock._apply_reframe_slider_value.assert_not_called()
+
+    def test_non_drag_value_change_is_queued_outside_slider_event(self):
+        dock = self.make_dock_stub(dragging=False)
+
+        VerticalizationDockContent._on_reframe_changed(dock)
+
+        self.assertEqual(dock._reframe_pending_value, 425)
+        dock._schedule_reframe_commit.assert_called_once_with()
+        dock._apply_reframe_slider_value.assert_not_called()
+
+    def test_release_schedules_single_deferred_commit(self):
+        dock = self.make_dock_stub(dragging=True)
+        dock._reframe_pending_value = 425
+
+        VerticalizationDockContent._on_reframe_release(dock)
+
+        self.assertFalse(dock._reframe_dragging)
+        dock._schedule_reframe_commit.assert_called_once_with()
+        self.assertEqual(dock._reframe_commit_timer.starts, 1)
+        dock._sync_reframe_slider.assert_not_called()
+
+    def test_commit_contains_python_errors_and_still_resynchronizes(self):
+        dock = self.make_dock_stub(dragging=False)
+        dock._reframe_pending_value = 425
+        dock._apply_reframe_slider_value.side_effect = ValueError("invalid clip")
+
+        with patch("windows.verticalization.log.exception") as log_exception:
+            VerticalizationDockContent._commit_reframe_slider_value(dock)
+
+        self.assertIsNone(dock._reframe_pending_value)
+        dock._apply_reframe_slider_value.assert_called_once_with(425)
+        dock._sync_reframe_slider.assert_called_once_with()
+        log_exception.assert_called_once()
+
+    def test_real_qt_slider_drag_commits_once_after_release(self):
+        app = QApplication.instance() or QApplication([])
+        slider = QSlider(Qt.Horizontal)
+        slider.setRange(-1000, 1000)
+        timer = QtCore.QTimer()
+        timer.setSingleShot(True)
+        timer.setInterval(0)
+        dock = self.make_dock_stub(dragging=False)
+        dock.reframe_slider = slider
+        dock._reframe_commit_timer = timer
+        dock._selected_clip = lambda: object()
+        dock._schedule_reframe_commit = lambda: \
+            VerticalizationDockContent._schedule_reframe_commit(dock)
+        timer.timeout.connect(
+            lambda: VerticalizationDockContent._commit_reframe_slider_value(dock))
+        slider.sliderPressed.connect(
+            lambda: VerticalizationDockContent._on_reframe_press(dock))
+        slider.valueChanged.connect(
+            lambda _value: VerticalizationDockContent._on_reframe_changed(dock))
+        slider.sliderReleased.connect(
+            lambda: VerticalizationDockContent._on_reframe_release(dock))
+
+        slider.sliderPressed.emit()
+        slider.setValue(475)
+        self.assertTrue(dock._reframe_dragging)
+        self.assertEqual(dock._reframe_pending_value, 475)
+        self.assertFalse(timer.isActive())
+        dock._apply_reframe_slider_value.assert_not_called()
+
+        slider.sliderReleased.emit()
+        app.processEvents()
+
+        dock._apply_reframe_slider_value.assert_called_once_with(475)
+        dock._sync_reframe_slider.assert_called_once_with()
+        self.assertIsNone(dock._reframe_pending_value)
+
