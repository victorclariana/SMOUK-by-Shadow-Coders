         self.sections["automatic_reframing"].add_widget(self.reframe_slider)
 
         self.chk_keyframes = QCheckBox(_("Keyframes"), self)
@@ -4446,14 +4447,22 @@ class VerticalizationDockContent(QWidget):
         self._sync_reframe_slider()
 
     def _on_reframe_press(self):
-        self._reframe_dragging = self._selected_clip() is not None
+        try:
+            self._reframe_dragging = self._selected_clip() is not None
+        except Exception:
+            self._reframe_dragging = False
+            log.exception("SMOUK reframe slider press failed")
 
     def _on_reframe_release(self):
-        if self._reframe_update_timer.isActive():
-            self._reframe_update_timer.stop()
-            self._apply_reframe_slider_value()
-        self._reframe_dragging = False
-        self._sync_reframe_slider()
+        try:
+            was_dragging = self._reframe_dragging
+            self._reframe_dragging = False
+            if was_dragging and self._reframe_pending_value is not None:
+                self._schedule_reframe_commit()
+            elif self._reframe_pending_value is None:
+                self._sync_reframe_slider()
+        except Exception:
+            log.exception("SMOUK reframe slider release failed")
 
     def _reframe_max_offset(self):
         return (1.0 - (self._output_ratio() / (16.0 / 9.0))) / 2.0
@@ -4540,14 +4549,40 @@ class VerticalizationDockContent(QWidget):
         return max(start_frame, int(round(float(end) * fps_value)))
 
     def _on_reframe_changed(self):
-        """Coalesce slider movement to at most one timeline update per 80 ms."""
-        if self._reframe_dragging:
-            if not self._reframe_update_timer.isActive():
-                self._reframe_update_timer.start()
-        else:
-            self._apply_reframe_slider_value()
+        """Defer model and preview mutations until Qt has finished the slider event."""
+        try:
+            self._reframe_pending_value = self.reframe_slider.value()
+            if not self._reframe_dragging:
+                self._schedule_reframe_commit()
+        except Exception:
+            log.exception("SMOUK reframe slider value-change handler failed")
+
+    def _schedule_reframe_commit(self):
+        if not self._reframe_commit_timer.isActive():
+            self._reframe_commit_timer.start()
+
+    def _commit_reframe_slider_value(self):
+        if self._reframe_dragging or self._reframe_pending_value is None:
+            return
+        slider_value = self._reframe_pending_value
+        self._reframe_pending_value = None
+        try:
+            self._apply_reframe_slider_value(slider_value)
+        except Exception as exc:
+            # An exception escaping a Python slot connected to Qt's mouse/slider
+            # event path terminates this PyQt build inside Qt5Core. Keep it
+            # contained here and persist its traceback for diagnosis.
+            log.exception("SMOUK reframe slider commit failed")
+            try:
+                self.reframe_results.setText("Framing update failed: %s" % exc)
+            except Exception:
+                log.exception("SMOUK could not display the reframe error")
+        try:
+            self._sync_reframe_slider()
+        except Exception:
+            log.exception("SMOUK reframe slider resynchronization failed")
 
-    def _apply_reframe_slider_value(self):
+    def _apply_reframe_slider_value(self, slider_value):
         """Store a fixed reframe, or a keyframe at the current playhead position."""
         window = get_app().window
         clip = self._selected_clip()
@@ -4556,13 +4591,17 @@ class VerticalizationDockContent(QWidget):
 
         # Keep the selected output crop entirely inside a 16:9 source frame.
         value = self._clamp_reframe_value(
-            (self.reframe_slider.value() / 1000.0) * self._reframe_max_offset())
+            (slider_value / 1000.0) * self._reframe_max_offset())
         fps = get_app().project.get("fps")
         fps_value = float(fps["num"]) / float(fps["den"])
         frame = self._clip_frame(clip, window)
+        log.info("SMOUK reframe commit start: clip=%s slider=%s keyframes=%s",
+                 clip.id, slider_value, self.chk_keyframes.isChecked())
 
         if self.chk_keyframes.isChecked():
             window.videoPreview.updateClipProperty(clip.id, frame, "location_x", value)
+            log.info("SMOUK reframe commit finished: clip=%s frame=%s",
+                     clip.id, frame)
             return
 
         start_frame = max(1, int(round(float(clip.data.get("start", 0.0)) * fps_value)) + 1)
@@ -4575,6 +4614,8 @@ class VerticalizationDockContent(QWidget):
         }
         clip.save()
         window.refreshFrameSignal.emit()
+        log.info("SMOUK reframe commit finished: clip=%s",
+                 clip.id)
 
     def _on_export_vertical(self):
         """Open Export with an explicit SMOUK crop-render configuration."""
