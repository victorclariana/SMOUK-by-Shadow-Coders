From 308422cb175b305bac0bc5fa1e7f063891de551d Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Fri, 25 Sep 2026 16:56:21 +0200
Subject: [PATCH] SMOUK 0.0.121 prevent overlapping subtitle cues

---
 src/windows/main_window.py     | 2 +-
 src/windows/verticalization.py | 7 ++++++-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 65e79c1d1..cc03c96d4 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.119"
+SMOUK_VERSION = "0.0.121"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index bd8667568..522cbea72 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -2315,7 +2315,7 @@ class VerticalizationDockContent(QWidget):
 
     @staticmethod
     def _split_review_text(text, count, original_lengths=None):
-        max_chars = 52
+        max_chars = 40
         words = str(text or "").split()
         if count <= 1:
             return [" ".join(words)]
@@ -2384,6 +2384,11 @@ class VerticalizationDockContent(QWidget):
                 item["start"] = previous["start"]
                 item["text"] = "\n".join(cls._subtitle_lines(
                     previous["text"].replace("\n", " ") + " " + text))
+            if redistributed and item["start"] < redistributed[-1]["end"]:
+                previous = redistributed.pop()
+                item["start"] = previous["start"]
+                item["text"] = "\n".join(cls._subtitle_lines(
+                    previous["text"].replace("\n", " ") + " " + text))
             if item["text"]:
                 redistributed.append(item)
         return redistributed
-- 
2.55.0.windows.3

