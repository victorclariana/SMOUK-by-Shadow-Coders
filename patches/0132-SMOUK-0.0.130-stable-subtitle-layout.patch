@@ -0,0 +1,175 @@
+"""Pure, testable planning of timed, two-line SMOUK subtitle screens.
+
+All text is planned before any Timeline clip is changed. Pixel measurement is
+supplied by the caller so this module has no Qt or OpenShot dependency.
+"""
+
+from difflib import SequenceMatcher
+import re
+
+
+_WEAK_ENDINGS = {"a", "amb", "de", "del", "dels", "el", "els", "i",
+                 "la", "les", "per", "pel", "pels"}
+_SENTENCE_END = (".", "?", "!", "…")
+
+
+def _normal(word):
+    return re.sub(r"[^\w]", "", str(word), flags=re.UNICODE).casefold()
+
+
+def align_corrected_words(raw_words, corrected_text):
+    """Attach monotonic original speech times to manually corrected words."""
+    corrected = str(corrected_text or "").split()
+    original = [word for word in raw_words if str(word.get("word", "")).strip()]
+    if not corrected or not original:
+        raise ValueError("La revisión o los tiempos de palabras están vacíos.")
+    result = [None] * len(corrected)
+    matcher = SequenceMatcher(None, [_normal(w["word"]) for w in original],
+                              [_normal(w) for w in corrected], autojunk=False)
+    for operation, a, b, c, d in matcher.get_opcodes():
+        if operation == "equal":
+            for offset in range(d - c):
+                source = original[a + offset]
+                result[c + offset] = {"word": corrected[c + offset],
+                                      "start": float(source["start"]),
+                                      "end": float(source["end"])}
+        elif c < d:
+            before = float(original[a - 1]["end"]) if a else float(original[0]["start"])
+            after = (float(original[b]["start"]) if b < len(original)
+                     else float(original[-1]["end"]))
+            if a < b:
+                before = float(original[a]["start"])
+                after = float(original[b - 1]["end"])
+            after = max(before, after)
+            for index in range(c, d):
+                start = before + (after - before) * (index - c) / (d - c)
+                end = before + (after - before) * (index - c + 1) / (d - c)
+                result[index] = {"word": corrected[index], "start": start, "end": end}
+    # SequenceMatcher can match repeated words across a correction. Clamp
+    # their times without changing order or ever placing text after its speech.
+    for index in range(1, len(result)):
+        result[index]["start"] = max(result[index - 1]["start"], result[index]["start"])
+        result[index]["end"] = max(result[index]["start"], result[index]["end"])
+    return result
+
+
+def wrap_words(words, measure, safe_width):
+    """Find one or two lines that fit exactly at the configured font size."""
+    if not words:
+        return None
+    text = " ".join(words)
+    if measure(text) <= safe_width:
+        return [text]
+    candidates = []
+    for cut in range(1, len(words)):
+        left, right = " ".join(words[:cut]), " ".join(words[cut:])
+        left_width, right_width = measure(left), measure(right)
+        if max(left_width, right_width) > safe_width:
+            continue
+        weak = words[cut - 1].rstrip(".,!?…;:").casefold() in _WEAK_ENDINGS
+        candidates.append((abs(left_width - right_width) + (safe_width if weak else 0),
+                           [left, right]))
+    return min(candidates, default=(None, None))[1]
+
+
+def plan_cues(timed_words, measure, safe_width, *, min_duration=1.0,
+              max_duration=5.5, hold_gap=1.5, tail_end=None):
+    """Partition all words into nonoverlapping, readable screens.
+
+    Every screen starts no later than its first spoken word. A screen may use
+    the following pause for reading time, but cannot cover the next screen.
+    If no legal partition exists, fail without silently discarding any text.
+    """
+    words = [dict(item) for item in timed_words if str(item.get("word", "")).strip()]
+    if not words:
+        return []
+    if any(float(item["end"]) < float(item["start"]) for item in words):
+        raise ValueError("La transcripción contiene tiempos de palabra invertidos.")
+    count = len(words)
+    best = [None] * (count + 1)
+    best[count] = (0.0, [])
+    for start in range(count - 1, -1, -1):
+        tokens = []
+        for stop in range(start + 1, count + 1):
+            if (stop > start + 1 and
+                    float(words[stop - 1]["start"]) - float(words[stop - 2]["end"]) >= 0.8):
+                break
+            tokens.append(str(words[stop - 1]["word"]).strip())
+            rows = wrap_words(tokens, measure, safe_width)
+            if rows is None:
+                break
+            if best[stop] is None:
+                continue
+            if len(tokens) == 1 and count > 1:
+                continue
+            speech_start = float(words[start]["start"])
+            spoken_end = float(words[stop - 1]["end"])
+            next_start = float(words[stop]["start"]) if stop < count else None
+            if next_start is not None:
+                end = min(next_start, spoken_end + hold_gap)
+            elif tail_end is not None:
+                end = min(float(tail_end), spoken_end + hold_gap)
+            else:
+                end = spoken_end
+            duration = end - speech_start
+            if duration <= 0 or duration > max_duration:
+                continue
+            if duration < min_duration and count > 1:
+                continue
+            # A final word with a period belongs to its preceding sentence.
+            if (start > 0 and tokens[0].endswith(_SENTENCE_END)
+                    and not str(words[start - 1]["word"]).endswith(_SENTENCE_END)):
+                continue
+            chars_per_second = len(" ".join(tokens)) / max(duration, 0.1)
+            weak_end = tokens[-1].rstrip(".,!?…;:").casefold() in _WEAK_ENDINGS
+            punctuation = tokens[-1].endswith(_SENTENCE_END)
+            score = (1.0 + 0.3 * abs(duration - 2.7)
+                     + max(0.0, chars_per_second - 18.0) * 0.25
+                     + (1.5 if weak_end else 0.0)
+                     - (0.5 if punctuation else 0.0))
+            candidate = (score + best[stop][0],
+                         [{"start": speech_start, "end": end,
+                           "text": " ".join(tokens), "lines": rows}] + best[stop][1])
+            if best[start] is None or candidate[0] < best[start][0]:
+                best[start] = candidate
+    if best[0] is None:
+        raise ValueError("No hay una distribución de dos líneas legible con la fuente, "
+                         "el tamaño y los tiempos de voz actuales.")
+    cues = best[0][1]
+    for index, cue in enumerate(cues):
+        if index and cue["start"] < cues[index - 1]["end"] - 1e-6:
+            raise ValueError("La distribución de subtítulos se solapa en el timeline.")
+        if any(measure(row) > safe_width for row in cue["lines"]):
+            raise ValueError("Un subtítulo excede los límites de la guía 9:16.")
+    if " ".join(cue["text"] for cue in cues) != " ".join(w["word"] for w in words):
+        raise ValueError("Se han perdido palabras al distribuir los subtítulos.")
+    return cues
+
+
+def visible_audio_ranges(clips):
+    """Choose one audible source per timeline interval, preferring top layers."""
+    prepared = []
+    for clip in clips:
+        if clip.get("has_audio") is False or clip.get("enabled") is False:
+            continue
+        start = float(clip["position"])
+        end = start + float(clip["source_end"]) - float(clip["source_start"])
+        if end > start:
+            prepared.append((start, end, clip))
+    boundaries = sorted({edge for start, end, _clip in prepared for edge in (start, end)})
+    ranges = []
+    for start, end in zip(boundaries, boundaries[1:]):
+        active = [clip for left, right, clip in prepared
+                  if left < end - 1e-6 and right > start + 1e-6]
+        if not active:
+            continue
+        winner = max(active, key=lambda item: (int(item["layer"]), str(item["id"])))
+        if ranges and ranges[-1]["id"] == winner["id"] and abs(ranges[-1]["timeline_end"] - start) < 1e-6:
+            ranges[-1]["timeline_end"] = end
+            ranges[-1]["source_end"] = float(winner["source_start"]) + end - float(winner["position"])
+        else:
+            ranges.append({"id": winner["id"], "path": winner["path"],
+                           "timeline_position": start, "timeline_end": end,
+                           "source_start": float(winner["source_start"]) + start - float(winner["position"]),
+                           "source_end": float(winner["source_start"]) + end - float(winner["position"])})
+    return ranges
