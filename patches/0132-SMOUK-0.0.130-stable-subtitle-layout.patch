@@ -0,0 +1,69 @@
+"""Subtitle planning regressions: full text, timing, width and source overlap."""
+
+import unittest
+
+from classes.smouk_subtitle_layout import (
+    align_corrected_words, plan_cues, visible_audio_ranges,
+)
+
+
+class SubtitleLayoutTests(unittest.TestCase):
+    def test_overlapping_sources_create_one_audible_interval_at_a_time(self):
+        clips = [
+            {"id": "lower", "path": "original.mp4", "position": 0.0,
+             "source_start": 152.84, "source_end": 166.44, "layer": 1000000},
+            {"id": "upper", "path": "edited.mp4", "position": 0.0,
+             "source_start": 43.36, "source_end": 54.0, "layer": 4000000},
+        ]
+        ranges = visible_audio_ranges(clips)
+        self.assertEqual([item["id"] for item in ranges], ["upper", "lower"])
+        self.assertAlmostEqual(ranges[0]["timeline_end"], 10.64)
+        self.assertAlmostEqual(ranges[1]["timeline_position"], 10.64)
+        self.assertAlmostEqual(ranges[1]["source_start"], 163.48)
+
+    def test_corrections_preserve_words_and_time_while_font_width_changes(self):
+        original = [
+            {"word": word, "start": index * 0.45, "end": index * 0.45 + 0.4}
+            for index, word in enumerate(
+                "Aquest centre de dades funciona a ple rendiment. "
+                "El govern aposta per Catalunya.".split())
+        ]
+        corrected = "Aquest centre de dades funciona a ple rendiment. " \
+                    "El Govern aposta per Catalunya."
+        timed = align_corrected_words(original, corrected)
+        self.assertEqual([item["word"] for item in timed], corrected.split())
+        for character_width in (12.0, 20.0):
+            measure = lambda text: len(text) * character_width
+            cues = plan_cues(timed, measure, 320.0)
+            self.assertEqual(" ".join(cue["text"] for cue in cues), corrected)
+            self.assertTrue(all(1 <= len(cue["lines"]) <= 2 for cue in cues))
+            self.assertTrue(all(len(cue["text"].split()) > 1 for cue in cues))
+            self.assertTrue(all(measure(line) <= 320 for cue in cues
+                                for line in cue["lines"]))
+            self.assertTrue(all(left["end"] <= right["start"]
+                                for left, right in zip(cues, cues[1:])))
+            self.assertTrue(all(cue["start"] <= timed[corrected.split().index(
+                cue["text"].split()[0])]["start"] for cue in cues))
+
+    def test_impossible_width_fails_instead_of_dropping_words(self):
+        words = [{"word": "Mediterrània.", "start": 0.0, "end": 1.0}]
+        with self.assertRaises(ValueError):
+            plan_cues(words, lambda text: len(text) * 30.0, 100.0)
+
+    def test_pause_can_extend_previous_screen_without_delaying_next(self):
+        words = [
+            {"word": "Bon", "start": 0.0, "end": 0.5},
+            {"word": "dia.", "start": 0.5, "end": 0.9},
+            {"word": "Ara", "start": 2.2, "end": 2.7},
+            {"word": "seguim.", "start": 2.7, "end": 3.2},
+        ]
+        cues = plan_cues(words, lambda text: len(text) * 10.0, 110.0,
+                         tail_end=3.5)
+        self.assertEqual([cue["text"] for cue in cues], ["Bon dia.", "Ara seguim."])
+        self.assertAlmostEqual(cues[0]["end"], 2.2)
+        self.assertAlmostEqual(cues[1]["start"], 2.2)
+        self.assertAlmostEqual(cues[-1]["end"], 3.5)
+
+
+if __name__ == "__main__":
+    unittest.main()
