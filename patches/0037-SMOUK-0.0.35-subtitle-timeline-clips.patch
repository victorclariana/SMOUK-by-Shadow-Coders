+    def _clear_generated_subtitles(self):
+        """Replace prior SMOUK subtitle clips and remove legacy caption effects."""
+        for clip in Clip.filter():
+            if clip.data.get("smouk_subtitle_clip"):
+                clip.delete()
+                continue
+            effects = clip.data.get("effects", [])
+            retained = [effect for effect in effects
+                        if not isinstance(effect, dict) or
+                        not effect.get("smouk_transcription")]
+            if len(retained) != len(effects):
+                clip.data["effects"] = retained
+                clip.save()
+        for file_obj in File.filter():
+            if file_obj.data.get("smouk_subtitle_asset"):
+                file_obj.delete()
+
+    @staticmethod
+    def _ensure_subtitle_track():
+        for track in Track.filter():
+            if track.data.get("smouk_subtitle_track"):
+                return int(track.data.get("number", 0))
+        layers = get_app().project.get("layers") or []
+        top = max([int(layer.get("number", 0)) for layer in layers] or [0])
+        number = top + 1000000
+        track = Track()
+        track.data = {
+            "number": number, "y": 0, "label": "SMOUK Subtitles",
+            "lock": False, "smouk_subtitle_track": True,
+        }
+        track.save()
+        return number
+
+    def _subtitle_svg(self, text, width, height):
+        """Create one transparent, full-frame title for an editable timeline clip."""
+        ratio = max(0.01, min(16.0 / 9.0, self._output_ratio()))
+        guide_fraction = ratio / (16.0 / 9.0)
+        guide_width = min(float(width), float(height) * ratio)
+        lines = [line.strip() for line in str(text).splitlines() if line.strip()][:2]
+        if not lines:
+            return ""
+        font_size = min(104.0 * guide_fraction,
+                        guide_width / max(max(len(line) for line in lines) * 0.65, 1.0))
+        line_height = font_size * 1.15
+        center_y = float(height) * 0.82
+        first_y = center_y - (len(lines) - 1) * line_height / 2.0
+        tspans = []
+        for index, line in enumerate(lines):
+            y = first_y + index * line_height
+            tspans.append('<text x="{:.2f}" y="{:.2f}" text-anchor="middle" '
+                          'font-family="Arial Black, Arial, sans-serif" font-size="{:.2f}" '
+                          'font-weight="900" fill="#ffffff" stroke="#000000" '
+                          'stroke-width="1.2" stroke-linejoin="round" paint-order="stroke">{}</text>'.format(
+                              float(width) / 2.0, y, font_size, html.escape(line)))
+        return ('<svg xmlns="http://www.w3.org/2000/svg" width="{}" height="{}" '
+                'viewBox="0 0 {} {}">{}</svg>').format(
+                    int(width), int(height), int(width), int(height), "".join(tspans))
+
+    @staticmethod
+    def _subtitle_clip_segments(video_clip, cue):
+        """Map a source-time cue onto the visible portion of one timeline clip."""
+        clip_start = float(video_clip.data.get("start", 0.0))
+        clip_end = float(video_clip.data.get("end", clip_start))
+        source_start = max(clip_start, float(cue.get("start", 0.0)))
+        source_end = min(clip_end, float(cue.get("end", 0.0)))
+        if source_end <= source_start:
+            return None
+        return {
+            "position": float(video_clip.data.get("position", 0.0)) + source_start - clip_start,
+            "start": 0.0,
+            "end": source_end - source_start,
+            "duration": source_end - source_start,
+        }
+
+    def _create_subtitle_timeline_clip(self, svg_path, asset_data, layer, position,
+                                       start, end, title, subtitle_text):
+        file_obj = File()
+        file_obj.data = dict(asset_data)
+        file_obj.data["smouk_subtitle_asset"] = True
+        file_obj.data["name"] = title
+        file_obj.save()
+
+        source_path = file_obj.absolute_path()
+        reader_clip = openshot.Clip(source_path)
+        clip_data = json.loads(reader_clip.Json(), strict=False)
+        clip_data.update({
+            "position": float(position), "start": float(start), "end": float(end),
+            "layer": int(layer), "file_id": file_obj.id, "title": title,
+            "reader": file_obj.data, "smouk_subtitle_clip": True,
+            "smouk_subtitle_text": subtitle_text,
+        })
+        clip_record = Clip()
+        clip_record.data = clip_data
+        clip_record.save()
+        return clip_record.id
+
