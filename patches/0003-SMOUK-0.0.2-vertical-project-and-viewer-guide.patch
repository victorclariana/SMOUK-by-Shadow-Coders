             fps_float = float(fps["num"]) / float(fps["den"])
@@ -3053,6 +3124,10 @@ class VideoWidget(QWidget, updates.UpdateInterface):
         self.regionTopLeftHandle = None
         self.regionBottomRightHandle = None
         self.curr_frame_size = None # Frame size
