-    def _auto_reframe_clip(self, clip, cv2):
-        """Track the largest detected face and return sparse clip keyframes."""
+    @staticmethod
+    def _mediapipe_subject_center(frame, face_detector, pose_detector, cv2):
+        """Return MediaPipe's best subject centre, normalized to the frame width.
+
+        YuNet remains the primary detector.  This second layer is deliberately a
+        fallback: it keeps a presenter framed when the face is small, turned
+        away, or briefly hidden, using face landmarks first and shoulder/nose
+        pose landmarks second.
+        """
+        if face_detector is None and pose_detector is None:
+            return None
+        rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+        try:
+            if face_detector is not None:
+                faces = face_detector.process(rgb_frame)
+                detections = getattr(faces, "detections", None) or []
+                if detections:
+                    detection = max(
+                        detections,
+                        key=lambda item: float(item.location_data.relative_bounding_box.width) *
+                        float(item.location_data.relative_bounding_box.height))
+                    box = detection.location_data.relative_bounding_box
+                    return max(0.0, min(1.0, float(box.xmin) + float(box.width) / 2.0))
+
+            if pose_detector is not None:
+                pose = pose_detector.process(rgb_frame)
+                landmarks = getattr(getattr(pose, "pose_landmarks", None), "landmark", None)
+                if landmarks:
+                    # Shoulder midpoint follows a person more reliably than a
+                    # single nose landmark when a face is partly occluded.
+                    shoulders = [landmarks[index] for index in (11, 12)
+                                 if getattr(landmarks[index], "visibility", 0.0) >= 0.45]
+                    subject = (sum(point.x for point in shoulders) / len(shoulders)
+                               if shoulders else landmarks[0].x)
+                    return max(0.0, min(1.0, float(subject)))
+        except Exception as ex:
+            # MediaPipe is a secondary aid; a bad model frame must never abort
+            # a successful YuNet/CSRT run.
+            log.debug("SMOUK MediaPipe fallback skipped a frame: %s", ex)
+        return None
+
+    @staticmethod
+    def _create_mediapipe_detectors(mediapipe):
+        """Create legacy MediaPipe face and pose detectors when available."""
+        if mediapipe is None or not hasattr(mediapipe, "solutions"):
+            return None, None
+        try:
+            solutions = mediapipe.solutions
+            return (
+                solutions.face_detection.FaceDetection(
+                    model_selection=1, min_detection_confidence=0.55),
+                solutions.pose.Pose(
+                    static_image_mode=False,
+                    model_complexity=1,
+                    enable_segmentation=False,
+                    min_detection_confidence=0.55,
+                    min_tracking_confidence=0.55),
+            )
+        except Exception as ex:
+            log.warning("SMOUK MediaPipe fallback is unavailable: %s", ex)
+            return None, None
+
+    def _auto_reframe_clip(self, clip, cv2, mediapipe=None):
+        """Track the largest face, with MediaPipe face/pose as a fallback."""
         path = str(clip.data.get("reader", {}).get("path", ""))
         capture = cv2.VideoCapture(path)
         if not capture.isOpened():
@@ -225,6 +287,7 @@ class VerticalizationDockContent(QWidget):
 
             detector = cv2.FaceDetectorYN_create(self._yunet_model_path(), "", (width, height),
                                                   0.78, 0.3, 5000)
+            mp_face, mp_pose = self._create_mediapipe_detectors(mediapipe)
             start = float(clip.data.get("start", 0.0))
             end = float(clip.data.get("end") or (start + float(clip.data.get("duration", 0.0))))
             if end <= start:
@@ -263,8 +326,14 @@ class VerticalizationDockContent(QWidget):
                     if tracked:
                         box = tracked_box
 
+                face_center = None
                 if box is not None:
                     face_center = (box[0] + (box[2] / 2.0)) / width
