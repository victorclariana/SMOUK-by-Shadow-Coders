@@ -2110,6 +2110,27 @@ class ClipPainter(BasePainter):
 
         includes_end = (full_rect.right() - segment_rect.right()) <= 0.5
 
+        # SMOUK marks clips whose horizontal framing was generated by automatic
+        # face/pose analysis.  The actual editable motion remains in the native
+        # location_x keyframes; this small badge makes those shots easy to find.
+        data = clip.data if isinstance(getattr(clip, "data", None), dict) else {}
+        ui_data = data.get("ui") if isinstance(data.get("ui"), dict) else {}
+        if includes_start and ui_data.get("smouk_auto_reframed") and segment_rect.width() >= 20.0:
+            badge = QRectF(segment_rect.left() + 4.0, segment_rect.bottom() - 17.0, 22.0, 13.0)
+            painter.save()
+            painter.setRenderHint(QPainter.Antialiasing, True)
+            painter.setPen(QPen(QColor(15, 37, 55, 230), 1.0))
+            painter.setBrush(QColor(34, 169, 225, 235))
+            painter.drawRoundedRect(badge, 3.0, 3.0)
+            badge_font = QFont(painter.font())
+            badge_font.setBold(True)
+            if badge_font.pointSizeF() > 0:
+                badge_font.setPointSizeF(max(6.0, badge_font.pointSizeF() * 0.72))
+            painter.setFont(badge_font)
+            painter.setPen(QColor(255, 255, 255))
+            painter.drawText(badge, Qt.AlignCenter, "AI")
+            painter.restore()
+
         border_pen = pen if isinstance(pen, QPen) else (self.sel_pen if selected else self.clip_pen)
         self._stroke_visible_border(
             painter,
