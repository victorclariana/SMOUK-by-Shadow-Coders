+"""Regression tests for persistent dock trackpad diagnostics."""
+
+import os
+from unittest import TestCase
+from unittest.mock import patch
+
+from qt_api import QApplication, Qt, QtCore, QtGui, QWidget, QVBoxLayout, QLabel
+from windows.verticalization import (
+    _TracingVerticalizationScrollArea,
+    _VerticalizationScrollTrace,
+)
+
+
+class VerticalizationScrollTraceTests(TestCase):
+    def test_wheel_event_records_deltas_and_scrollbar_transition(self):
+        app = QApplication.instance() or QApplication([])
+        workspace_root = os.path.abspath(os.path.join(
+            os.path.dirname(__file__), "..", "..", ".."))
+        trace_path = os.path.join(workspace_root, ".smouk-scroll-trace-test.log")
+        area = _TracingVerticalizationScrollArea()
+        content = QWidget()
+        layout = QVBoxLayout(content)
+        for index in range(40):
+            layout.addWidget(QLabel("Dock row %s" % index))
+        area.setWidget(content)
+        area.resize(320, 200)
+        try:
+            with patch("windows.verticalization._SMOUK_SCROLL_TRACE_PATH", trace_path), \
+                    patch("windows.verticalization.info.USER_PATH", workspace_root), \
+                    patch("windows.verticalization._install_smouk_qt_scroll_message_handler"):
+                trace = _VerticalizationScrollTrace(area, area)
+                area._smouk_scroll_trace = trace
+                area.show()
+                app.processEvents()
+
+                event = QtGui.QWheelEvent(
+                    QtCore.QPointF(20, 20), QtCore.QPointF(20, 20),
+                    QtCore.QPoint(0, -60), QtCore.QPoint(0, -120),
+                    Qt.NoButton, Qt.NoModifier, Qt.ScrollUpdate, False)
+                QApplication.sendEvent(area.viewport(), event)
+                app.processEvents()
+                area.close()
+
+                with open(trace_path, encoding="utf-8") as trace_file:
+                    output = trace_file.read()
+        finally:
+            if os.path.exists(trace_path):
+                os.remove(trace_path)
+
+        self.assertIn("WHEEL-EVENT", output)
+        self.assertIn("pixel=0,-60", output)
+        self.assertIn("angle=0,-120", output)
+        self.assertIn("WHEEL-HANDLER-BEGIN", output)
+        self.assertIn("WHEEL-HANDLER-END", output)
+        self.assertIn("SCROLLBAR-VALUE", output)
