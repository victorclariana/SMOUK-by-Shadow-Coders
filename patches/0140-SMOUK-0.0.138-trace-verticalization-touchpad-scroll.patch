 VERTICAL_SUBTITLE_CENTER = .685
 VERTICAL_CAPTION_TOP = .44
 VERTICAL_CAPTION_BOTTOM = .43
+
+# Qt's wheel-scroll path has failed fast inside QAbstractSlider on some
+# Windows/MSYS2 Qt builds. Keep a low-level trace outside the rotating app log
+# so the final Wheel event and any Qt fatal message survive the crash.
+_SMOUK_SCROLL_TRACE_PATH = os.path.join(
+    info.USER_PATH, "smouk_verticalization_scroll.log")
+_SMOUK_SCROLL_TRACE_LOCK = threading.RLock()
+_SMOUK_SCROLL_TRACE_PREVIOUS_QT_HANDLER = None
+_SMOUK_SCROLL_TRACE_QT_HANDLER_INSTALLED = False
+
+
+def _write_verticalization_scroll_trace(stage, details=""):
+    """Append one flushed diagnostic line; never let tracing break the UI."""
+    try:
+        stamp = time.strftime("%Y-%m-%d %H:%M:%S")
+        line = "%s.%03d pid=%s thread=%s %s %s\n" % (
+            stamp, int((time.time() % 1) * 1000), os.getpid(),
+            threading.get_ident(), stage, str(details).replace("\n", " "))
+        with _SMOUK_SCROLL_TRACE_LOCK:
+            os.makedirs(info.USER_PATH, exist_ok=True)
+            with open(_SMOUK_SCROLL_TRACE_PATH, "a", encoding="utf-8") as trace:
+                trace.write(line)
+                trace.flush()
+    except Exception:
+        # This trace is diagnostic only and must not interfere with Qt events.
+        pass
+
+
+def _smouk_qt_scroll_message_handler(message_type, context, message):
+    """Persist Qt warnings/fatal text before Qt's fail-fast terminates Python."""
+    try:
+        kind = int(message_type)
+    except Exception:
+        kind = -1
+    # Qt 5: warning=1, critical=2, fatal=3. Ignore routine debug/info traffic.
+    if kind in (1, 2, 3):
+        try:
+            source = "%s:%s %s" % (
+                getattr(context, "file", "") or "",
+                getattr(context, "line", "") or "",
+                getattr(context, "function", "") or "")
+        except Exception:
+            source = ""
+        _write_verticalization_scroll_trace(
+            "QT-MESSAGE type=%s source=%s" % (message_type, source), message)
+    previous = _SMOUK_SCROLL_TRACE_PREVIOUS_QT_HANDLER
+    if previous:
+        try:
+            previous(message_type, context, message)
+        except Exception:
+            pass
+
+
+def _install_smouk_qt_scroll_message_handler():
+    """Install one process-wide Qt message tap, retaining the prior handler."""
+    global _SMOUK_SCROLL_TRACE_PREVIOUS_QT_HANDLER
+    global _SMOUK_SCROLL_TRACE_QT_HANDLER_INSTALLED
+    if _SMOUK_SCROLL_TRACE_QT_HANDLER_INSTALLED:
+        return
+    try:
+        _SMOUK_SCROLL_TRACE_PREVIOUS_QT_HANDLER = QtCore.qInstallMessageHandler(
+            _smouk_qt_scroll_message_handler)
+        _SMOUK_SCROLL_TRACE_QT_HANDLER_INSTALLED = True
+        _write_verticalization_scroll_trace("QT-HANDLER-INSTALLED")
+    except Exception:
+        log.exception("Could not install SMOUK Qt scroll diagnostics")
+
+
+class _VerticalizationScrollTrace(QtCore.QObject):
+    """Trace touchpad wheel events and native scroll-bar transitions."""
+
+    def __init__(self, owner, scroll_area):
+        super().__init__(owner)
+        self.owner = owner
+        self.scroll_area = scroll_area
+        self.scroll_bar = scroll_area.verticalScrollBar()
+        self._targets = [scroll_area, scroll_area.viewport(), self.scroll_bar]
+        for target in self._targets:
+            target.installEventFilter(self)
+        self.scroll_bar.valueChanged.connect(self._on_scroll_value_changed)
+        self.scroll_bar.rangeChanged.connect(self._on_scroll_range_changed)
+        _install_smouk_qt_scroll_message_handler()
+        _write_verticalization_scroll_trace(
+            "DOCK-TRACE-START",
+            "area=%s viewport=%s scrollbar=%s value=%s range=%s..%s" % (
+                hex(id(scroll_area)), hex(id(scroll_area.viewport())),
+                hex(id(self.scroll_bar)), self.scroll_bar.value(),
+                self.scroll_bar.minimum(), self.scroll_bar.maximum()))
+
+    @staticmethod
+    def _object_name(obj):
+        try:
+            return "%s:%s" % (obj.metaObject().className(), obj.objectName())
+        except Exception:
+            return type(obj).__name__
+
+    def _scroll_state(self):
+        try:
+            return "value=%s range=%s..%s page=%s" % (
+                self.scroll_bar.value(), self.scroll_bar.minimum(),
+                self.scroll_bar.maximum(), self.scroll_bar.pageStep())
+        except Exception as exc:
+            return "scroll-state-error=%s" % exc
+
+    def _on_scroll_value_changed(self, value):
+        _write_verticalization_scroll_trace(
+            "SCROLLBAR-VALUE", "value=%s %s" % (value, self._scroll_state()))
+
+    def _on_scroll_range_changed(self, minimum, maximum):
+        _write_verticalization_scroll_trace(
+            "SCROLLBAR-RANGE", "range=%s..%s %s" % (
+                minimum, maximum, self._scroll_state()))
+
+    def eventFilter(self, watched, event):
+        try:
+            event_type = event.type()
+            wheel_type = getattr(QtCore.QEvent, "Wheel", None)
+            native_gesture_type = getattr(QtCore.QEvent, "NativeGesture", None)
+            if event_type == wheel_type or (
+                    native_gesture_type is not None and event_type == native_gesture_type):
+                details = ["target=%s" % self._object_name(watched), self._scroll_state()]
+                if hasattr(event, "pixelDelta"):
+                    pixel = event.pixelDelta()
+                    angle = event.angleDelta()
+                    details.append("pixel=%s,%s" % (pixel.x(), pixel.y()))
+                    details.append("angle=%s,%s" % (angle.x(), angle.y()))
+                    if hasattr(event, "phase"):
+                        details.append("phase=%s" % event.phase())
+                    if hasattr(event, "inverted"):
+                        details.append("inverted=%s" % event.inverted())
+                    if hasattr(event, "source"):
+                        details.append("source=%s" % event.source())
+                elif hasattr(event, "gestureType"):
+                    details.append("gesture=%s" % event.gestureType())
+                    details.append("value=%s" % getattr(event, "value", lambda: "")())
+                _write_verticalization_scroll_trace(
+                    "WHEEL-EVENT type=%s" % event_type, " ".join(details))
+        except Exception:
+            log.exception("SMOUK scroll event trace failed")
+        return False
+
+    def wheel_finished(self, event, stage):
+        """Record the native QScrollArea handler boundary and result."""
+        try:
+            delta = event.pixelDelta() if hasattr(event, "pixelDelta") else None
+            angle = event.angleDelta() if hasattr(event, "angleDelta") else None
+            detail = "pixel=%s angle=%s accepted=%s %s" % (
+                (delta.x(), delta.y()) if delta else None,
+                (angle.x(), angle.y()) if angle else None,
+                event.isAccepted(), self._scroll_state())
+        except Exception as exc:
+            detail = "state-error=%s" % exc
+        _write_verticalization_scroll_trace(stage, detail)
+
+
+class _TracingVerticalizationScrollArea(QScrollArea):
+    """Preserve before/after evidence around Qt's native wheel handler."""
+
+    def __init__(self, parent=None):
+        super().__init__(parent)
+        self._smouk_scroll_trace = None
+
+    def wheelEvent(self, event):
+        trace = self._smouk_scroll_trace
+        if trace:
+            trace.wheel_finished(event, "WHEEL-HANDLER-BEGIN")
+        try:
+            return super().wheelEvent(event)
+        finally:
+            if trace:
+                trace.wheel_finished(event, "WHEEL-HANDLER-END")
 # A recognition score describes text quality.  It must survive duration
 # refinement unchanged so a visually well-bounded but unreadable banner never
 # becomes an apparently reliable chyron.
