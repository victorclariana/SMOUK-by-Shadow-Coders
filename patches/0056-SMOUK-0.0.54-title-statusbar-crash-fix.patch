From 6bd9a9d352e158aca606053cbf81214d0da4194a Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Fri, 18 Sep 2026 04:27:25 +0200
Subject: [PATCH] SMOUK 0.0.54 fix OCR title pipeline responsiveness

---
 src/classes/smouk_titles.py    |  31 ++-
 src/resources/eng.traineddata  | Bin 0 -> 4113088 bytes
 src/windows/main_window.py     |   8 +-
 src/windows/verticalization.py | 451 +++++++++++++++++++++------------
 4 files changed, 317 insertions(+), 173 deletions(-)
 create mode 100644 src/resources/eng.traineddata

diff --git a/src/classes/smouk_titles.py b/src/classes/smouk_titles.py
index 04b10aa02..03ab9c409 100644
--- a/src/classes/smouk_titles.py
+++ b/src/classes/smouk_titles.py
@@ -11,6 +11,7 @@ import re
 import shutil
 import subprocess
 import sys
+import uuid
 
 
 TIMECODE_RE = re.compile(r"^(?P<h>\d{1,2}):(?P<m>[0-5]\d):(?P<s>[0-5]\d)(?::(?P<f>\d{1,2}))?$")
@@ -84,12 +85,16 @@ def available_ocr_language():
                  if language in available), None)
 
 
-def ocr_image(image, psm=6):
+def ocr_image(image, psm=6, language=None):
     """OCR one cropped BGR image and return text, or a useful unavailable reason."""
-    language = available_ocr_language()
+    language = language or available_ocr_language()
     executable = _tesseract_path()
     if not executable:
         return {"text": "", "reason": "tesseract_not_found"}
+    bundled = os.path.normpath(os.path.join(os.path.dirname(__file__), "..", "resources"))
+    if language and not (language in {"cat", "spa", "eng"} and
+                         os.path.isfile(os.path.join(bundled, language + ".traineddata"))):
+        language = None
     if not language:
         return {"text": "", "reason": "ocr_language_not_installed"}
     try:
@@ -103,17 +108,17 @@ def ocr_image(image, psm=6):
         temporary_root = os.path.normpath(os.path.join(
             os.path.dirname(__file__), "..", "resources", "smouk-ocr-tmp"))
         os.makedirs(temporary_root, exist_ok=True)
-        image_path = os.path.join(temporary_root, "ocr-%d.png" % os.getpid())
+        image_path = os.path.join(temporary_root, "ocr-%s.png" % uuid.uuid4().hex)
         try:
             if not cv2.imwrite(image_path, gray):
                 return {"text": "", "reason": "ocr_image_write_failed"}
-            bundled = os.path.normpath(os.path.join(os.path.dirname(__file__), "..", "resources"))
             environment = os.environ.copy()
             if os.path.isfile(os.path.join(bundled, language + ".traineddata")):
                 environment["TESSDATA_PREFIX"] = bundled
             completed = subprocess.run(
                 [executable, image_path, "stdout", "--psm", str(int(psm)), "-l", language],
-                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
+                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+                encoding="utf-8", errors="replace",
                 timeout=45, check=False, env=environment)
         finally:
             try:
@@ -121,7 +126,7 @@ def ocr_image(image, psm=6):
             except OSError:
                 pass
         return {"text": completed.stdout.strip(), "language": language,
-                "reason": "" if completed.returncode == 0 else "tesseract_failed"}
+                "reason": "" if completed.returncode == 0 else "tesseract_failed: " + completed.stderr.strip()[-500:]}
     except Exception as exc:
         return {"text": "", "reason": str(exc)}
 
@@ -285,6 +290,8 @@ def _clock_probe(path, reference, fps=25, max_seconds=180, progress_callback=Non
         first_candidate = None
         candidate_samples = 0
         persistence = 0
+        persistence_frame = None
+        persistence_frames = []
         try:
             while samples < requested_samples:
                 raw_frame = process.stdout.read(frame_size)
@@ -296,6 +303,10 @@ def _clock_probe(path, reference, fps=25, max_seconds=180, progress_callback=Non
                 accepted_frame = score >= 0.78 and template_score >= 0.75
                 if accepted_frame:
                     candidate_samples += 1
+                    if persistence == 0:
+                        persistence_frame = frame.copy()
+                        persistence_frames = []
+                    persistence_frames.append(frame.copy())
                     persistence += 1
                     if persistence >= 3 and first_candidate is None:
                         first_candidate = {
@@ -304,10 +315,18 @@ def _clock_probe(path, reference, fps=25, max_seconds=180, progress_callback=Non
                             "orange_ratio": features["orange_ratio"],
                             "frame": (samples - 2) * int(fps),
                             "seconds": float(samples - 2),
+                            # Keep the exact decoded sample. Seeking a second
+                            # time into long-GOP broadcast MP4 can land on a
+                            # neighbouring keyframe, which would make OCR read
+                            # a different picture than the detector accepted.
+                            "clock_frame": persistence_frame,
+                            "clock_frames": persistence_frames[:],
                             "persistence_frames": persistence,
                         }
                 else:
                     persistence = 0
+                    persistence_frame = None
+                    persistence_frames = []
                 samples += 1
                 if progress_callback:
                     progress_callback(samples, requested_samples)
