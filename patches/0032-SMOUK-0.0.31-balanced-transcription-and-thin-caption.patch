diff --git a/src/tests/test_smouk_transcription.py b/src/tests/test_smouk_transcription.py
index 81311bc16..b65f2c850 100644
--- a/src/tests/test_smouk_transcription.py
+++ b/src/tests/test_smouk_transcription.py
@@ -2,7 +2,10 @@
 
 import importlib.util
 import os
+import sys
+import types
 import unittest
+from unittest import mock
 
 
 ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(__file__))))
@@ -13,6 +16,37 @@ SPEC.loader.exec_module(worker)
 
 
 class SmoukTranscriptionTests(unittest.TestCase):
+    def test_balanced_accuracy_profile_uses_three_hypotheses(self):
+        self.assertEqual(worker.DEFAULT_BEAM_SIZE, 3)
+
+    def test_worker_passes_accuracy_and_vad_settings(self):
+        calls = {}
+
+        class FakeModel:
+            def __init__(self, *args, **kwargs):
+                calls["model"] = kwargs
+
+            def transcribe(self, *args, **kwargs):
+                calls["transcribe"] = kwargs
+                return iter(()), types.SimpleNamespace(duration=1.0)
+
+        argv = [
+            "smouk_transcribe.py", "--input", "audio.wav",
+            "--output", "captions.json", "--model-dir", "models",
+        ]
+        fake_module = types.SimpleNamespace(WhisperModel=FakeModel)
+        with mock.patch.dict(sys.modules, {"faster_whisper": fake_module}), \
+                mock.patch.object(sys, "argv", argv), \
+                mock.patch("builtins.open", mock.mock_open()), \
+                mock.patch.object(os, "makedirs"):
+            worker.main()
+
+        self.assertEqual(calls["transcribe"]["beam_size"], 3)
+        self.assertTrue(calls["transcribe"]["condition_on_previous_text"])
+        self.assertEqual(calls["transcribe"]["vad_parameters"], {
+            "threshold": 0.35, "speech_pad_ms": 500,
+        })
+
     def test_cpu_threads_leave_capacity_for_the_interface(self):
         self.assertEqual(worker.recommended_cpu_threads(2), 2)
         self.assertEqual(worker.recommended_cpu_threads(8), 6)
