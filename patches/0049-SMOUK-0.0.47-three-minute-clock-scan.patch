 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index e6be27dcb..aa87a828c 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -377,6 +377,19 @@ class VerticalizationDockContent(QWidget):
             "Folder accepted.\nCorte: %s – %s\nClean Feed: %s\nPrograma: %s") % (
                 tc.get("clip_in"), tc.get("clip_out"),
                 os.path.basename(files["clean"]), os.path.basename(files["program"]))
+        clock_probes = result.get("clock_probes") or {}
+        clock_lines = []
+        for key, title in (("clean", "Clean Feed"), ("program", "Programa")):
+            probe = clock_probes.get(key) or {}
+            if probe.get("candidate"):
+                clock_lines.append(
+                    "%s: reloj candidato en %0.0f s (%s muestras)" % (
+                        title, float(probe.get("seconds", 0.0)), probe.get("samples", 0)))
+            else:
+                clock_lines.append(
+                    "%s: sin reloj en los primeros 3 min (%s muestras)" % (
+                        title, probe.get("samples", 0)))
+        summary += "\n" + "\n".join(clock_lines)
         if warnings:
             summary += "\n" + _("Avisos: ") + "; ".join(warnings)
         self.title_folder_results.setText(summary)
