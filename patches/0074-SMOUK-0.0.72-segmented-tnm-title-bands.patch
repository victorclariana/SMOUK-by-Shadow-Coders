         return TextRecognition(model_name="latin_PP-OCRv5_mobile_rec", device="cpu", cpu_threads=2)
 
 
+def _recognize(model, image):
+    """Return the one-line PP-OCRv5 reading for one prepared image."""
+    with contextlib.redirect_stdout(sys.stderr):
+        result = list(model.predict(image, batch_size=1))[0]
+    values = result.json.get("res", {})
+    return str(values.get("rec_text", "")).strip(), float(values.get("rec_score", 0.0) or 0.0)
+
+
+def _recognize_headline_words(model, image):
+    """Read TNM's high-contrast headline words separately, then join them.
+
+    The recognizer is line-oriented. A TNM sumary or story headline can span
+    most of a 16:9 frame, so a single pass loses the extreme words despite
+    their large, stable glyphs. Its fixed dark/orange band lets us safely
+    isolate bright word components without inspecting the programme picture.
+    """
+    import cv2
+    import numpy
+
+    # A full orange story bar can coexist with a grey pretitle above it. Keep
+    # only the orange band before finding words, otherwise their two lines are
+    # incorrectly combined into one recognizer input.
+    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
+    orange = cv2.inRange(hsv, (2, 115, 115), (28, 255, 255))
+    row_coverage = numpy.count_nonzero(orange, axis=1) / max(1, orange.shape[1])
+    orange_rows = numpy.where(row_coverage >= .40)[0]
+    if len(orange_rows):
+        runs, start, previous = [], int(orange_rows[0]), int(orange_rows[0])
+        for row in orange_rows[1:]:
+            row = int(row)
+            if row > previous + 1:
+                runs.append((start, previous))
+                start = row
+            previous = row
+        runs.append((start, previous))
+        start, end = max(runs, key=lambda run: run[1] - run[0])
+        if end - start + 1 >= max(10, int(image.shape[0] * .18)):
+            image = image[start:end + 1, :]
+
+    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
+    _unused, mask = cv2.threshold(gray, 180, 255, cv2.THRESH_BINARY)
+    # The pretitle is appreciably smaller than a headline, so scale the word
+    # gap with the crop height instead of merging e.g. "DE SEGURETAT".
+    word_gap = max(3, int(image.shape[0] * .12))
+    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE,
+                            numpy.ones((3, word_gap), numpy.uint8))
+    count, _labels, stats, _centres = cv2.connectedComponentsWithStats(mask)
+    minimum_height = max(12, int(image.shape[0] * .20))
+    words = []
+    for x, y, width, height, area in stats[1:count]:
+        if area < 80 or width < 10 or height < minimum_height:
+            continue
+        # The permanent TN bug is outside every editorial title. Its white
+        # glyph is a false one-letter component at the far-right edge.
+        if x >= image.shape[1] * .93:
+            continue
+        padding = 4
+        word = image[max(0, y - padding):min(image.shape[0], y + height + padding),
+                     max(0, x - padding):min(image.shape[1], x + width + padding)]
+        text, confidence = _recognize(model, word)
+        if text and confidence >= .70:
+            words.append((int(x), text, confidence))
+    if len(words) >= 2:
+        words.sort(key=lambda item: item[0])
+        return " ".join(item[1] for item in words), min(item[2] for item in words)
+    return _recognize(model, image)
+
+
 def main():
