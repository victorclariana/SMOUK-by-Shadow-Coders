round(QColor("#fff59d")) -            selection.format = fmt -            selections.append(selection) +            # Highlight only inserted/replaced characters in the corrected +            # pane, like a marker, so an unchanged part of a sentence remains +            # visually distinguishable from ParlaBE's edit. +            marker = QTextCharFormat() +            marker.setBackground(QColor("#fff59d")) +            for tag, old_start, old_end, new_start, new_end in SequenceMatcher( +                    None, original, corrected, autojunk=False).get_opcodes(): +                if tag == "equal" or new_start == new_end: +                    continue +                selection = QTextEdit.ExtraSelection() +                selection.cursor = QTextCursor(block) +                selection.cursor.setPosition(block.position() + new_start) +                selection.cursor.setPosition(block.position() + new_end, +                                             QTextCursor.KeepAnchor) +                selection.format = marker +                selections.append(selection)          self.corrected_edit.setExtraSelections(selections)        def _accept_review(self): @@ -484,6 +495,10 @@ class VerticalizationDockContent(QWidget):          self.transcription_results.setObjectName("verticalizationTranscriptionResults")          self.transcription_results.setWordWrap(True)          self.sections["subtitles"].add_widget(self.transcription_results) +        self.transcription_phase = QLabel(_("Process idle."), self) +        self.transcription_phase.setObjectName("verticalizationTranscriptionPhase") +        self.transcription_phase.setWordWrap(True) +        self.sections["subtitles"].add_widget(self.transcription_phase)            self._transcription_process = None          self._transcription_stage = None @@ -500,6 +515,7 @@ class VerticalizationDockContent(QWidget):          self._transcription_review_sentences = []          self._transcription_review_dialog = None          self._transcription_completion_pending = False +        self._transcription_phase_update_pending = False          # Keep worker stdout off Qt's QProcess readyRead path.  On the          # packaged MSYS2 Qt build, bursts of progress signals can trigger a          # native Qt fail-fast while the local transcription worker is running. @@ -2093,6 +2109,7 @@ class VerticalizationDockContent(QWidget):          self.transcription_progress.setRange(0, 0)          self.transcription_progress.setVisible(True)          self.btn_transcribe.setEnabled(False) +        self._set_transcription_phase(_("Preparing the Timeline audio…"))            if not os.path.isfile(paths["python"]) or not glob.glob(paths["bsc_model_glob"]):              answer = QMessageBox.question( @@ -2205,10 +2222,9 @@ class VerticalizationDockContent(QWidget):          output = os.path.join(paths["outputs"], digest + ".json")          self._current_transcription_output = output          self.transcription_progress.setRange(0, 0) -        self.transcription_results.setText( -            _("Transcribing source %s of %s in Catalan…") % -            (self._transcription_completed_sources + 1, -             self._transcription_completed_sources + len(self._transcription_sources))) +        self._set_transcription_phase( +            _("Transcribing Timeline audio in Catalan (source %s)…") % +            (self._transcription_completed_sources + 1), force=True)          arguments = [              paths["worker"], "--input", source_path, "--output", output,              "--model-dir", paths["models"], @@ -2258,6 +2274,21 @@ class VerticalizationDockContent(QWidget):          log.info("SMOUK ParlaBE setup step=child-command-ready")          log.info("SMOUK transcription boundary: starting ParlaBE child program=%s", correction_python)          self._start_transcription_process(correction_python, arguments, "correct") +        self._set_transcription_phase(_("Sending the transcription to ParlaBE…"), force=True) + +    def _set_transcription_phase(self, text, force=False): +        """Publish coarse workflow state without touching Qt during inference.""" +        value = str(text or "").strip() +        if not value: +            return +        if self._transcription_stage == "transcribe" and not force: +            # BSC's native inference must remain completely free of widget +            # mutations. The phase was already set before the worker started. +            self._transcription_last_status = value +            log.info("SMOUK phase: %s", value) +            return +        self.transcription_phase.setText(value) +        log.info("SMOUK phase: %s", value)        def _schedule_transcription_review(self, outputs, reason):          """Open review only after the worker/timer callback has returned.""" @@ -2295,11 +2326,13 @@ class VerticalizationDockContent(QWidget):          dialog.finished.connect(self._release_transcription_review_dialog)          log.info("SMOUK transcription boundary: opening non-blocking review dialog; sentences=%s",                   len(sentences)) +        self._set_transcription_phase(_("Review window open: check the highlighted changes."))          dialog.open()        def _accept_transcription_review(self):          """Apply editor changes only after the dialog has emitted Accepted."""          log.info("SMOUK transcription boundary: review accepted; scheduling Timeline placement") +        self._set_transcription_phase(_("Placing checked subtitles on the Timeline…"))          QtCore.QTimer.singleShot(0, self._commit_transcription_review)        def _commit_transcription_review(self): @@ -2354,7 +2387,9 @@ class VerticalizationDockContent(QWidget):                  if piece:                      updates.setdefault((result_index, index), []).append(piece)          for (result_index, cue_index), pieces in updates.items(): -            self._transcription_outputs[result_index]["cues"][cue_index]["text"] = " ".join(pieces) +            merged = " ".join(pieces) +            self._transcription_outputs[result_index]["cues"][cue_index]["text"] = "\n".join( +                self._subtitle_lines(merged))          for result in self._transcription_outputs:              result["reviewed_with_parlabe"] = True   @@ -2390,6 +2425,8 @@ class VerticalizationDockContent(QWidget):              # and publish the final state when the process finishes.              self._transcription_last_status = str(event.get("text", ""))              log.info("SMOUK worker status: %s", self._transcription_last_status) +            if self._transcription_stage == "correct": +                self._set_transcription_phase(self._transcription_last_status, force=True)          elif event_name == "partial":              text = str(event.get("text", "")).strip()              if text: @@ -2583,14 +2620,15 @@ class VerticalizationDockContent(QWidget):          ratio = max(0.01, min(16.0 / 9.0, self._output_ratio()))          guide_fraction = ratio / (16.0 / 9.0)          guide_width = min(float(width), float(height) * ratio) -        lines = [line.strip() for line in str(text).splitlines() if line.strip()][:2] +        clean_text = " ".join(str(text).replace("\n", " ").split()) +        lines = self._subtitle_lines(clean_text)[:2]          if not lines:              return ""          # The reference broadcast band uses a large, heavy face in the lower          # middle of the 9:16 guide.  Keep the text inside the guide width while          # allowing the two-line treatment to remain clearly readable. -        font_size = min(128.0 * guide_fraction, -                        guide_width / max(max(len(line) for line in lines) * 0.60, 1.0)) +        font_size = 128.0 * guide_fraction +        text_width = guide_width * (1.0 - 2.0 * VERTICAL_TITLE_SAFE_MARGIN)          line_height = font_size * 1.15          center_y = float(height) * VERTICAL_SUBTITLE_CENTER          first_y = center_y - (len(lines) - 1) * line_height / 2.0 @@ -2600,11 +2638,41 @@ class VerticalizationDockContent(QWidget):              tspans.append('<text x="{:.2f}" y="{:.2f}" text-anchor="middle" '                            'font-family="Arial Black, Arial, sans-serif" font-size="{:.2f}" '                            'font-weight="900" fill="#ffffff" stroke="#000000" ' -                          'stroke-width="2.9" stroke-linejoin="round" paint-order="stroke">{}</text>'.format( -                              float(width) / 2.0, y, font_size, html.escape(line))) +                          'stroke-width="2.9" stroke-linejoin="round" paint-order="stroke" ' +                          'textLength="{:.2f}" lengthAdjust="spacingAndGlyphs">{}</text>'.format( +                              float(width) / 2.0, y, font_size, text_width, +                              html.escape(line)))          return ('<svg xmlns="http://www.w3.org/2000/svg" width="{}" height="{}" '                  'viewBox="0 0 {} {}">{}</svg>').format( -                    int(width), int(height), int(width), int(height), "".join(tspans)) +                int(width), int(height), int(width), int(height), "".join(tspans)) + +    @staticmethod +    def _subtitle_lines(text, width=26): +        """Match the BSC subtitle wrapping after ParlaBE edits.""" +        clean = " ".join(str(text or "").split()) +        if not clean: +            return [] +        if len(clean) <= width: +            return [clean] +        words = clean.split() +        candidates = [] +        weak_endings = {"a", "amb", "d'", "de", "del", "dels", "el", "els", +                        "i", "la", "les", "per", "pel", "pels"} +        for index in range(1, len(words)): +            left = " ".join(words[:index]) +            right = " ".join(words[index:]) +            if len(left) > width or len(right) > width: +                continue +            penalty = 20 if words[index - 1].lower() in weak_endings else 0 +            candidates.append((abs(len(left) - len(right)) + penalty, left, right)) +        if candidates: +            _score, left, right = min(candidates) +            return [left, right] +        # A corrected sentence can be longer than the original cue. Keep the +        # broadcast two-row contract by balancing at a word boundary even +        # when one row must be compressed horizontally by the SVG. +        middle = max(1, min(len(words) - 1, len(words) // 2)) +        return [" ".join(words[:middle]), " ".join(words[middle:])]        @staticmethod      def _subtitle_clip_segments(video_clip, cue): --  2.55.0.windows.3 