+                clip.delete()
+
+    def _add_clean_feed_clip(self, path, source_start, source_end, hourly_start):
+        """Place the requested CLEAN interval on Track 2 as an ordinary editable clip."""
+        window = get_app().window
+        layer = 2000000
+        file_obj = File.get(path=path)
+        if not file_obj:
+            data, _duration = inspect_media(path)
+            data["media_type"] = get_media_type(data)
+            file_obj = File()
+            file_obj.data = data
+            file_obj.save()
+        clip_data = window.timeline.addClip(file_obj.id, QtCore.QPoint(0, 0), layer,
+                                            ignore_refresh=True, call_manual_move=False)
+        if not clip_data:
+            raise RuntimeError("OpenShot could not add CLEAN.MP4 to Track 2")
+        clip = Clip.get(id=clip_data.get("id"))
+        duration = max(0.04, float(source_end) - float(source_start))
+        clip.data.update({
+            "position": 0.0, "start": float(source_start), "end": float(source_end),
+            "duration": duration, "layer": layer, "file_id": file_obj.id,
+            "reader": file_obj.data, "title": "CLEAN - %s to %s" % (
+                format_timecode(hourly_start + int(source_start * 25)),
+                format_timecode(hourly_start + int(source_end * 25))),
+            "smouk_clean_feed_clip": True,
+            "smouk_source_timecode_start": format_timecode(hourly_start + int(source_start * 25)),
+            "smouk_source_timecode_end": format_timecode(hourly_start + int(source_end * 25)),
+        })
+        clip.save()
+        return clip
