diff --git a/src/classes/smouk_titles.py b/src/classes/smouk_titles.py
index 782c9f895..04b10aa02 100644
--- a/src/classes/smouk_titles.py
+++ b/src/classes/smouk_titles.py
@@ -14,6 +14,7 @@ import sys
 
 
 TIMECODE_RE = re.compile(r"^(?P<h>\d{1,2}):(?P<m>[0-5]\d):(?P<s>[0-5]\d)(?::(?P<f>\d{1,2}))?$")
+CLOCK_OCR_RE = re.compile(r"(?<!\d)([0-2]?\d)\s*[.:]\s*([0-5]\d)\s*[.:]\s*([0-5]\d)(?!\d)")
 
 
 def parse_timecode(value, fps=25):
@@ -30,6 +31,101 @@ def parse_timecode(value, fps=25):
     return ((parts["h"] * 60 + parts["m"]) * 60 + parts["s"]) * int(fps) + frames
 
 
+def format_timecode(frame, fps=25):
+    """Format a non-negative frame offset as broadcast timecode."""
+    frame = max(0, int(round(frame)))
+    fps = int(fps)
+    seconds, frames = divmod(frame, fps)
+    hours, seconds = divmod(seconds, 3600)
+    minutes, seconds = divmod(seconds, 60)
+    return "%02d:%02d:%02d:%02d" % (hours, minutes, seconds, frames)
+
+
+def parse_clock_ocr(text, fps=25):
+    """Extract a ``HH.MM.SS`` broadcast clock reading from OCR text."""
+    cleaned = str(text or "").replace("O", "0").replace("o", "0")
+    match = CLOCK_OCR_RE.search(cleaned)
+    if not match:
+        return None
+    hour, minute, second = (int(value) for value in match.groups())
+    if hour > 23:
+        return None
+    return parse_timecode("%02d:%02d:%02d:00" % (hour, minute, second), fps)
+
+
+def _tesseract_path():
+    """Locate Tesseract without assuming it is on PATH on Windows."""
+    candidates = [
+        shutil.which("tesseract"), shutil.which("tesseract.exe"),
+        os.path.join(os.path.dirname(sys.executable), "tesseract.exe"),
+        r"C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
+        r"C:\\msys64\\mingw64\\bin\\tesseract.exe",
+    ]
+    return next((path for path in candidates if path and os.path.isfile(path)), None)
+
+
+def available_ocr_language():
+    """Return the best installed language for broadcast clocks and Catalan text."""
+    executable = _tesseract_path()
+    if not executable:
+        return None
+    try:
+        listing = subprocess.run([executable, "--list-langs"], stdout=subprocess.PIPE,
+                                 stderr=subprocess.DEVNULL, text=True, timeout=15,
+                                 check=False).stdout.splitlines()
+    except Exception:
+        return None
+    available = {item.strip() for item in listing[1:] if item.strip()}
+    bundled = os.path.normpath(os.path.join(os.path.dirname(__file__), "..", "resources"))
+    for language in ("cat", "spa", "eng"):
+        if os.path.isfile(os.path.join(bundled, language + ".traineddata")):
+            available.add(language)
+    return next((language for language in ("cat", "spa", "eng")
+                 if language in available), None)
+
+
+def ocr_image(image, psm=6):
+    """OCR one cropped BGR image and return text, or a useful unavailable reason."""
+    language = available_ocr_language()
+    executable = _tesseract_path()
+    if not executable:
+        return {"text": "", "reason": "tesseract_not_found"}
+    if not language:
+        return {"text": "", "reason": "ocr_language_not_installed"}
+    try:
+        import cv2
+        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
+        gray = cv2.resize(gray, None, fx=2.5, fy=2.5, interpolation=cv2.INTER_CUBIC)
+        gray = cv2.normalize(gray, None, 0, 255, cv2.NORM_MINMAX)
+        # The bundled Windows Python can inherit a protected TEMP directory
+        # from the broadcast environment. Keep transient OCR files beside the
+        # writable SMOUK resources instead.
+        temporary_root = os.path.normpath(os.path.join(
+            os.path.dirname(__file__), "..", "resources", "smouk-ocr-tmp"))
+        os.makedirs(temporary_root, exist_ok=True)
+        image_path = os.path.join(temporary_root, "ocr-%d.png" % os.getpid())
+        try:
+            if not cv2.imwrite(image_path, gray):
+                return {"text": "", "reason": "ocr_image_write_failed"}
+            bundled = os.path.normpath(os.path.join(os.path.dirname(__file__), "..", "resources"))
+            environment = os.environ.copy()
+            if os.path.isfile(os.path.join(bundled, language + ".traineddata")):
+                environment["TESSDATA_PREFIX"] = bundled
+            completed = subprocess.run(
+                [executable, image_path, "stdout", "--psm", str(int(psm)), "-l", language],
+                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
+                timeout=45, check=False, env=environment)
+        finally:
+            try:
+                os.remove(image_path)
+            except OSError:
+                pass
+        return {"text": completed.stdout.strip(), "language": language,
+                "reason": "" if completed.returncode == 0 else "tesseract_failed"}
+    except Exception as exc:
+        return {"text": "", "reason": str(exc)}
+
+
 def _find_clip(data):
     clean = data.get("cleanFeed") or {}
     clips = clean.get("clips") or []
