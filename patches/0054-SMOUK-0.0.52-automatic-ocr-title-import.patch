+    def _title_progress(self, text, value=None, maximum=None):
+        """Report long title work in both the dock and the application status bar."""
+        if maximum is not None:
+            self.title_clock_progress.setRange(0, max(1, int(maximum)))
+        if value is not None:
+            self.title_clock_progress.setValue(int(value))
+        self.title_clock_status.setText(text)
+        window = get_app().window
+        if getattr(window, "statusBar", None):
+            window.statusBar().showMessage(text)
+        get_app().processEvents()
+
+    def _title_frame_at(self, path, second, width=960, height=540):
+        """Decode one broadcast frame through FFmpeg, avoiding OpenCV seeking."""
+        try:
+            import numpy
+            ffmpeg = self._ffmpeg_path()
+            command = [ffmpeg, "-v", "error", "-ss", "%.3f" % max(0.0, second),
+                       "-i", path, "-frames:v", "1", "-vf",
+                       "scale=%d:%d:flags=bilinear" % (width, height), "-an",
+                       "-f", "rawvideo", "-pix_fmt", "bgr24", "pipe:1"]
+            completed = subprocess.run(command, stdout=subprocess.PIPE,
+                                       stderr=subprocess.DEVNULL, timeout=90, check=False)
+            expected = width * height * 3
+            if completed.returncode or len(completed.stdout) < expected:
+                return None
+            return numpy.frombuffer(completed.stdout[:expected], dtype=numpy.uint8).reshape(
+                (height, width, 3)).copy()
+        except Exception:
+            log.exception("Could not decode title-analysis frame")
+            return None
+
+    def _ocr_clock_at(self, path, probe):
+        frame = self._title_frame_at(path, float(probe.get("seconds", 0.0)))
+        if frame is None:
+            return {"frames": None, "reason": "clock_frame_unavailable"}
+        # The clock occupies the upper visual band; excluding weather and
+        # decorative lower graphics gives Tesseract the large HH.MM.SS digits.
+        height = frame.shape[0]
+        result = ocr_image(frame[int(height * .08):int(height * .72), :], psm=7)
+        if parse_clock_ocr(result.get("text"), fps=25) is None:
+            result = ocr_image(frame, psm=6)
+        frames = parse_clock_ocr(result.get("text"), fps=25)
+        result["frames"] = frames
+        return result
+
+    @staticmethod
+    def _ensure_chyron_track():
+        for track in Track.filter():
+            if track.data.get("smouk_chyron_track"):
+                return int(track.data.get("number", 0))
+        layers = get_app().project.get("layers") or []
+        number = max([int(layer.get("number", 0)) for layer in layers] or [0]) + 1000000
+        track = Track()
+        track.data = {"number": number, "y": 0, "label": "CHYRONS", "lock": False,
+                      "smouk_chyron_track": True}
+        track.save()
+        return number
+
+    @staticmethod
+    def _clear_generated_title_import():
