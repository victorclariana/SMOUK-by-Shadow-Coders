+    def _title_svg(self, text, template, width, height):
+        """Build an editable transparent SVG for a detected broadcast chyron."""
+        top = template == "location"
+        y = height * (0.16 if top else 0.84)
+        x = width * (0.16 if top else 0.50)
+        anchor = "start" if top else "middle"
+        font_size = 45 if top else 56
+        lines = [html.escape(line.strip()) for line in str(text).splitlines() if line.strip()][:2]
+        rendered = "".join('<text x="%.1f" y="%.1f" text-anchor="%s" font-family="Arial, sans-serif" font-size="%d" font-weight="bold" fill="white" stroke="black" stroke-width="1.5" paint-order="stroke">%s</text>' % (x, y + index * font_size * 1.12, anchor, font_size, line) for index, line in enumerate(lines))
+        return '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">%s</svg>' % (width, height, width, height, rendered)
