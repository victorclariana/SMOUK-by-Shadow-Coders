From 77acddd8eaa6c99bda60434d4f1ea9e442c3346a Mon Sep 17 00:00:00 2001
From: Shadow Coders <shadowcoders@users.noreply.github.com>
Date: Mon, 21 Sep 2026 15:33:46 +0200
Subject: [PATCH] SMOUK 0.0.77 fix source progress heartbeat

---
 src/windows/main_window.py     |  2 +-
 src/windows/verticalization.py | 18 +++++++++++++++---
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/windows/main_window.py b/src/windows/main_window.py
index 1ad04788a..64f8e4916 100644
--- a/src/windows/main_window.py
+++ b/src/windows/main_window.py
@@ -102,7 +102,7 @@ from windows.views.tutorial import TutorialManager
 
 # SMOUK application version. Increment this patch number for every SMOUK UI
 # or workflow change released from this codebase.
-SMOUK_VERSION = "0.0.76"
+SMOUK_VERSION = "0.0.77"
 SMOUK_COMPACT_TIMELINE_LAYOUT_VERSION = "smouk-compact-timeline-v2"
 SMOUK_NEW_PROJECT_MARKER = os.path.join(info.USER_PATH, "smouk-new-project.marker")
 
diff --git a/src/windows/verticalization.py b/src/windows/verticalization.py
index ec8fdda98..1546803c3 100644
--- a/src/windows/verticalization.py
+++ b/src/windows/verticalization.py
@@ -562,6 +562,13 @@ class VerticalizationDockContent(QWidget):
         self._source_busy = False
         self._title_trace = []
         self._source_trace = []
+        # Source Video and Titles deliberately share the worker bookkeeping,
+        # but not their progress state.  Initialise both clocks before either
+        # action can start its worker timer.
+        self._source_stage_text = ""
+        self._source_stage_started = time.monotonic()
+        self._title_stage_text = ""
+        self._title_stage_started = time.monotonic()
         self._title_busy = False
         self._title_workers = []
         self._title_heartbeat = QtCore.QTimer(self)
@@ -688,11 +695,16 @@ class VerticalizationDockContent(QWidget):
 
     @title_pipeline_guard
     def _on_title_heartbeat(self):
-        elapsed = int(time.monotonic() - self._title_stage_started)
         if getattr(self, "_source_busy", False):
-            self.source_clock_status.setText("%s (%s s)" % (self._source_stage_text, elapsed))
+            elapsed = int(time.monotonic() - getattr(
+                self, "_source_stage_started", time.monotonic()))
+            self.source_clock_status.setText("%s (%s s)" % (
+                getattr(self, "_source_stage_text", ""), elapsed))
         else:
-            self.title_clock_status.setText("%s (%s s)" % (self._title_stage_text, elapsed))
+            elapsed = int(time.monotonic() - getattr(
+                self, "_title_stage_started", time.monotonic()))
+            self.title_clock_status.setText("%s (%s s)" % (
+                getattr(self, "_title_stage_text", ""), elapsed))
 
     @title_pipeline_guard
     def _on_title_worker_stage(self, message, value=None, maximum=None):
-- 
2.55.0.windows.3

